# / AArch64 Xiaomi Pad 5
# Maintainer: Kumar-Jy
# Kernel 6.16.0-6 = rodriguezst recipe + deferred wakeup fix (0050 safe).
# SMB5 backport (0014b, 0051-0057) replaces the LN8000 charger with the
# PM8150B qcom_smbx charger block so USB-A and USB-C charging works.
# 6.16.0-4 carried 0050 (Twinborn dsi_mgr_bridge_enable wakeup backport) that
# deadlocked switch-root; 6.16.0-6 re-adds the wakeup timing fix but defers
# the blocking notifier to a workqueue so it cannot hold the commit locks.
# 0014b pins qcom_fg registration against CI GCC link-time pruning.
# 0051: add qcom_smbx SMB5 charger driver. 0052/0053: pm8150b SMB5 node,
# switch nabu to it, drop LN8000. 0054: enable the build. 0055: integrate
# USB-PD via the type-c port. 0056: clear USBIN suspend for any attached
# source. 0057: advertise only a 5V/3A sink PDO (SMB5 charges only from 5V).

pkgbase=linux-nabu
pkgver=6.16.0
_kernelname=${pkgbase#linux}
_desc="AArch64 Xiaomi Pad 5"
_srcname="linux-${pkgver/%.0/}"
_dtbfile='qcom/sm8150-xiaomi-nabu.dtb'
pkgrel=6
arch=('aarch64')
