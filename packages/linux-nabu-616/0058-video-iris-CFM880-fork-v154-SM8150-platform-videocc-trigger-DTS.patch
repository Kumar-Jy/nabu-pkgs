+	dev_info(core->dev, "booting Iris firmware CPU\n");
 	ret = iris_vpu_boot_firmware(core);
 	if (ret)
 		goto error_unload_fw;
 
+	dev_info(core->dev, "initializing HFI core\n");
 	ret = iris_hfi_core_init(core);
 	if (ret)
 		goto error_unload_fw;
