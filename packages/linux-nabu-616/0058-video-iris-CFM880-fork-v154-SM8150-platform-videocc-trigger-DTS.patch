+		ret = llcc_slice_activate(core->llcc_slices[i]);
+		if (ret) {
+			dev_err(core->dev,
+				"Iris1 LLCC: failed to activate VIDSC%u: %d\n",
+				i, ret);
+			goto error_deactivate;
+		}
+	}
+	core->llcc_active = true;
+
+	/*
