+	spin_lock_init(&surface_fence->lock);
+	surface_fence->token = cmd->token;
+	dma_fence_init(&surface_fence->base, &iris_surface_fence_ops,
+		       &surface_fence->lock, inst->surface_fence_context,
+		       ++inst->surface_fence_seqno);
