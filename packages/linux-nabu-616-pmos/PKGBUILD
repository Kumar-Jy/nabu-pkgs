# Maintainer: Kumar-Jy
# Kernel built from the postmarketOS sm8150 fork at v6.16.0-sm8150:
#   https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux
#   @ 6810a5d63527fb4e1cd65e33b30de3f7eb78e123
# with the CFM880 nabu source overlays applied verbatim:
#   nabu-camera        @ c0e4fdb82809fd31357ed1f32604b81238591971 (rear OV13B10 +
#     front OV8856 + CN3927 AF, camss/cci)
#   nabu-iris          @ ed09ef4dff8e6a41e98feb81b2efee1d1f66f214 (Iris1/Venus decode)
#   nabu-accelerometer @ 25bc5c3050e2f50827b31ff724aad5fb79004786 (LSM6DSO SLPI/SSC,
#     FastRPC/PDR patch, rebased for the 6.16 tree in this package)
# Boot DTB is the derived sm8150-xiaomi-nabu-iris-camera-accelerometer-slpi-boot-only.dtb
# (base nabu + iris + camera + SLPI), built via Kbuild's explicit per-dtb target.
# Matching CFM880 production: SLPI accelerometer is the default boot target and
# iris/venus decode is enabled by default (firmware venus.mbn, slpi_nb.mbn is
# provided by linux-firmware-xiaomi-nabu).
# Charging is native in the 6.16 sm8150 tree: qcom_smbx SMB5 charger driver,
# pm8150b_charger DT node, and nabu wiring are all upstream, so no backport
# patch is needed (unlike the 6.14 package). Charger/battery config is left at
# the pmOS defaults (CONFIG_CHARGER_LN8000=m, CONFIG_CHARGER_QCOM_SMB2=y).
#
# IMPORTANT (build 34046578440 fix): the 6.16 sm8150 fork refactored the camss
# driver (MIPI_CSI2_DT_* renames, camss_buf_done/camss_reg_update/
# camss_find_sensor_pad, new camss-csid-680/780 + camss-vfe-680/780 files), so
# the CFM880 nabu-camera camss files (6.14-era, DATA_TYPE_* names) no longer
# compile against it. Since sm8150 camss support only exists in the 6.14-era
# tree, we vendor the complete working 6.14+CFM880 camss directory (with the
# 6.14 Makefile that builds just those objects) instead. The other CFM880
# camera overlay pieces (ov13b10/ov8856/cn3927, CCI, DTS, bindings) still
# apply normally.

pkgbase=linux-nabu
pkgver=6.16.0
pkgrel=2
arch=('aarch64')
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux"
license=('GPL2')
makedepends=('bc' 'git' 'kmod' 'inetutils' 'dtc' 'python3' 'libelf' 'xmlto' 'docbook-xsl')
options=('!strip')
_srcname=linux-6810a5d63527fb4e1cd65e33b30de3f7eb78e123
_dtbfile='qcom/sm8150-xiaomi-nabu-iris-camera-accelerometer-slpi-boot-only.dtb'
_camera=nabu-camera-c0e4fdb82809fd31357ed1f32604b81238591971
_iris=nabu-iris-ed09ef4dff8e6a41e98feb81b2efee1d1f66f214
_accel=nabu-accelerometer-25bc5c3050e2f50827b31ff724aad5fb79004786
_camss=camss-614-vendor

source=(
  "https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux/-/archive/6810a5d63527fb4e1cd65e33b30de3f7eb78e123/${_srcname}.tar.gz"
  "https://github.com/CFM880/nabu-camera/archive/c0e4fdb82809fd31357ed1f32604b81238591971.tar.gz"
  "https://github.com/CFM880/nabu-iris/archive/ed09ef4dff8e6a41e98feb81b2efee1d1f66f214.tar.gz"
  "https://github.com/CFM880/nabu-accelerometer/archive/25bc5c3050e2f50827b31ff724aad5fb79004786.tar.gz"
  "0001-NABU-remove-reset-and-change-freq-table-hz-of-ufs_mem_hc.patch"
  "0001-NABU-sm8150-slpi-fastrpc-pdr-616.patch"
  "0002-NABU-venus-core-hwmode-dev.patch"
  "camss-614-vendor.tar.gz"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "${srcdir}/${_srcname}"

  echo "-${pkgrel}" > localversion.10-pkgrel
  echo "${pkgbase#linux}" > localversion.20-pkgname

  echo "Applying CFM880 nabu-camera source overlay..."
  cp -R "${srcdir}/${_camera}/kernel-overlay/." ./
  echo "Applying CFM880 nabu-iris source overlay..."
  cp -R "${srcdir}/${_iris}/kernel-overlay/." ./
  echo "Applying CFM880 nabu-accelerometer overlay..."
  cp -R "${srcdir}/${_accel}/kernel-overlay/." ./
  echo "Applying CFM880 nabu-accelerometer FastRPC/PDR patch (rebased for 6.16)..."
  patch -p1 < "${srcdir}/0001-NABU-sm8150-slpi-fastrpc-pdr-616.patch"
  echo "Applying UFS controller reset and freq-table fix..."
  patch -p1 < "${srcdir}/0001-NABU-remove-reset-and-change-freq-table-hz-of-ufs_mem_hc.patch"
  echo "Adding 6.16 hwmode_dev member to the iris venus core.h overlay..."
  patch -p1 < "${srcdir}/0002-NABU-venus-core-hwmode-dev.patch"

  # Vendored 6.14+CFM880 camss driver: the 6.16 sm8150 fork refactored camss
  # (MIPI_CSI2_DT_* renames + new csid-680/780 and vfe-680/780 files), so the
  # CFM880 6.14-era camss overlay no longer compiles. The working sm8150 camss
  # support only exists in the 6.14-era tree, so replace the whole driver with
  # the exact 6.14+CFM880 working set (incl. the 6.14 Makefile and headers).
  echo "Vendoring 6.14+CFM880 camss driver directory..."
  rm -rf drivers/media/platform/qcom/camss
  cp -R "${srcdir}/${_camss}" drivers/media/platform/qcom/camss

  make ARCH=arm64 defconfig
  cat arch/arm64/configs/sm8150.config >> .config
  cat "${srcdir}/${_camera}/config/nabu-camera.config" >> .config
  cat "${srcdir}/${_iris}/config/nabu-iris.config" >> .config
  echo 'CONFIG_QCOM_PD_MAPPER=m' >> .config
  make ARCH=arm64 olddefconfig

  # LZ4 crypto modules required by mkinitcpio's 'systemd' hook
  echo 'CONFIG_CRYPTO_LZ4=m' >> .config
  echo 'CONFIG_CRYPTO_LZ4HC=m' >> .config
  make ARCH=arm64 olddefconfig
}

build() {
  cd "${srcdir}/${_srcname}"

  make ARCH=arm64 prepare
  make -s ARCH=arm64 kernelrelease > version

  unset LDFLAGS
  make ${MAKEFLAGS} ARCH=arm64 Image Image.gz modules
  # Build all declared board DTBs plus the derived iris+camera+SLPI DTB.
  make ${MAKEFLAGS} ARCH=arm64 DTC_FLAGS="-@" dtbs
  make ARCH=arm64 qcom/sm8150-xiaomi-nabu-iris-camera-accelerometer-slpi-boot-only.dtb
}

_package_common() {
  echo "Installing boot image and dtbs..."
  install -Dm644 arch/arm64/boot/Image "${pkgdir}/boot/vmlinux-${kernver}"
  install -Dm644 arch/arm64/boot/Image.gz "${pkgdir}/boot/vmlinuz-${kernver}"
  install -Dm644 arch/arm64/boot/dts/${_dtbfile} "${pkgdir}/boot/dtb-${kernver}"
  # stable symlinks so the mkinitcpio preset never goes stale on kernel updates
  ln -s "vmlinuz-${kernver}" "${pkgdir}/boot/vmlinuz-linux-nabu"
  ln -s "vmlinux-${kernver}" "${pkgdir}/boot/vmlinux-linux-nabu"
  ln -s "dtb-${kernver}" "${pkgdir}/boot/dtb-linux-nabu"

  echo "Installing modules..."
  make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/doesntexist modules_install

  rm "$pkgdir/usr/lib/modules/$kernver/build"

  # iris (video decode) is enabled by default: load qcom_iris at boot and keep
  # the firmware autoload path (allow_fw_boot) plus the cacheable MMAP buffers
  # (cached_capture) required for software-visible decode (Chrome/VA-API).
  # venus.mbn and slpi_nb.mbn firmware are provided by linux-firmware-xiaomi-nabu.
  install -Dm644 /dev/stdin "${pkgdir}/etc/modprobe.d/99-iris-vaapi.conf" << EOF
options qcom_iris allow_fw_boot=1 cached_capture=1
EOF
}

_package() {
  pkgdesc="The Linux Kernel and modules for the Xiaomi Pad 5 (nabu) - pmOS 6.16.0-sm8150 baseline + CFM880 iris/camera/SLPI accelerometer"
  depends=('coreutils' 'linux-firmware' 'kmod' 'mkinitcpio>=0.7' 'ukify')
  optdepends=('wireless-regdb: to set the correct wireless channels of your country'
              'linux-firmware-xiaomi-nabu: camera/iris/SLPI firmware (venus.mbn, slpi_nb.mbn) - not in standard repos')
  optdepends=('wireless-regdb: to set the correct wireless channels of your country')
  provides=("linux=${pkgver}")
  conflicts=('linux')
  install="linux-nabu.install"

  cd "${srcdir}/${_srcname}"
  local kernver="$(<version)"

  _package_common

  # mkinitcpio preset so the UKI is rebuilt automatically on install/upgrade,
  # even when pacman is used directly (non-atomic installs).
  install -Dm644 /dev/stdin "${pkgdir}/etc/mkinitcpio.d/linux-nabu.preset" << PRESET
# mkinitcpio preset file for the 'linux-nabu' package
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux-nabu"
PRESETS=('default')
default_uki="/boot/efi/EFI/arch/arch-linux-nabu.efi"
default_cmdline="/etc/cmdline.d/root.conf"
PRESET
}

_package-headers() {
  pkgdesc="Header files and scripts for building modules for the pmOS 6.16 linux-nabu kernel"
  provides=("linux-headers=${pkgver}")
  conflicts=('linux-headers')

  cd "${srcdir}/${_srcname}"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile
  cp -t "$builddir" -a scripts

  mkdir -p "$builddir"/{fs/xfs,mm}

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/arm64" -a arch/arm64/include
  install -Dt "$builddir/arch/arm64/kernel" -m644 arch/arm64/kernel/asm-offsets.s
  mkdir -p "$builddir/arch/arm"
  cp -t "$builddir/arch/arm" -a arch/arm/include

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */arm64/ || $arch == */arm/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -r "$builddir/Documentation"

  echo "Removing broken symlinks..."
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete

  echo "Removing loose objects..."
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -bi "$file")" in
      application/x-sharedlib\;*)      # Libraries (.so)
        strip -v $STRIP_SHARED "$file" ;;
      application/x-archive\;*)        # Libraries (.a)
        strip -v $STRIP_STATIC "$file" ;;
      application/x-executable\;*)     # Binaries
        strip -v $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) # Relocatable binaries
        strip -v $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

pkgname=("${pkgbase}" "${pkgbase}-headers")
for _p in ${pkgname[@]}; do
  eval "package_${_p}() {
    _package${_p#${pkgbase}}
  }"
done