# Maintainer: Kumar-Jy
# Expose Nabu as a tablet to GNOME/Plasma and handle sensor sleep/resume

pkgname=nabu-tablet-mode
pkgver=1.0.0
pkgrel=11
pkgdesc="Tablet mode switch helper and sensor resume hook for GNOME/Plasma on Xiaomi Pad 5 (nabu)"
arch=('aarch64')
url="https://github.com/Kumar-Jy/nabu-pkgs"
license=('GPL2')
changelog=ChangeLog
install=nabu-tablet-mode.install
depends=('glibc' 'iio-sensor-proxy' 'hexagonrpcd' 'psmisc')
makedepends=('gcc')
backup=('etc/nabu-tablet-mode.conf')
source=('nabu-tablet-mode.c'
        'nabu-tablet-mode.service'
        'nabu-sensors-resume.sh'
        'nabu-sensors-recover'
        '90-nabu-ssc-accelerometer.rules'
        'nabu-ssc.conf'
        'nabu-tablet-mode.conf'
        'nabu-tablet-toggle'
        'nabu-tablet-toggle.desktop'
        'ChangeLog'
        'nabu-tablet-mode.install')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
  cd "$srcdir"
  gcc -O2 -Wall -Wextra nabu-tablet-mode.c -o nabu-tablet-mode
}

package() {
  install -Dm755 "$srcdir/nabu-tablet-mode" "$pkgdir/usr/local/libexec/nabu-tablet-mode"
  install -Dm755 "$srcdir/nabu-tablet-toggle" "$pkgdir/usr/bin/nabu-tablet-toggle"
  install -Dm644 "$srcdir/nabu-tablet-mode.conf" "$pkgdir/etc/nabu-tablet-mode.conf"
  install -Dm644 "$srcdir/nabu-tablet-toggle.desktop" "$pkgdir/usr/share/applications/nabu-tablet-toggle.desktop"
  install -Dm644 "$srcdir/nabu-tablet-mode.service" "$pkgdir/usr/lib/systemd/system/nabu-tablet-mode.service"
  install -Dm755 "$srcdir/nabu-sensors-resume.sh" "$pkgdir/usr/lib/systemd/system-sleep/nabu-sensors-resume.sh"
  install -Dm755 "$srcdir/nabu-sensors-recover" "$pkgdir/usr/libexec/nabu-sensors-recover"
  install -Dm644 "$srcdir/90-nabu-ssc-accelerometer.rules" "$pkgdir/usr/lib/udev/rules.d/90-nabu-ssc-accelerometer.rules"
  install -Dm644 "$srcdir/nabu-ssc.conf" "$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/nabu-ssc.conf"
  install -Dm644 "$srcdir/ChangeLog" "$pkgdir/usr/share/doc/nabu-tablet-mode/ChangeLog"
}
