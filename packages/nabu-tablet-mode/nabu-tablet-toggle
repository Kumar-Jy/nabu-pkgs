#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# nabu-tablet-toggle - Control tablet mode on Xiaomi Pad 5 (nabu)
#
# Usage:
#   nabu-tablet-toggle         # Toggle between auto and force-tablet
#   nabu-tablet-toggle auto    # Automatic keyboard-based detection
#   nabu-tablet-toggle tablet  # Force tablet mode (auto-rotation always active)
#   nabu-tablet-toggle laptop  # Force laptop mode (locked to landscape)
#   nabu-tablet-toggle status  # Print current mode

STATE_DIR="/run/nabu-tablet-mode"
STATE_FILE="$STATE_DIR/mode"
CONF_FILE="/etc/nabu-tablet-mode.conf"

mkdir -p "$STATE_DIR" 2>/dev/null || true
chmod 777 "$STATE_DIR" 2>/dev/null || true

get_current_mode() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE" | tr -d ' \t\r\n'
    elif [ -f "$CONF_FILE" ]; then
        grep -E '^[ \t]*mode[ \t]*=' "$CONF_FILE" | cut -d= -f2 | tr -d ' \t\r\n"'''
    else
        echo "auto"
    fi
}

notify_user() {
    local msg="$1"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Tablet Mode" -i "preferences-desktop-display" "Nabu Tablet Mode" "$msg" 2>/dev/null || true
    fi
}

set_mode() {
    local target="$1"
    case "$target" in
        auto|tablet|laptop)
            echo "$target" > "$STATE_FILE"
            chmod 666 "$STATE_FILE" 2>/dev/null || true
            pkill -USR2 -f /usr/local/libexec/nabu-tablet-mode 2>/dev/null || true
            echo "Nabu Tablet Mode set to: $target"
            notify_user "Mode set to: $target"
            ;;
        status)
            echo "Current Mode: $(get_current_mode)"
            ;;
        *)
            echo "Usage: $0 [auto|tablet|laptop|status]"
            exit 1
            ;;
    esac
}

if [ $# -eq 0 ]; then
    current=$(get_current_mode)
    if [ "$current" = "tablet" ]; then
        set_mode "auto"
    else
        set_mode "tablet"
    fi
else
    set_mode "$1"
fi
