[Desktop Entry]
Name=System Monitor
GenericName=Hardware & System Monitor
Comment=Universal Hardware and System Monitor for Linux - GPU, CPU, RAM, Battery/Charging & Sensors
Exec=system-monitor
Icon=system-monitor
Terminal=false
Type=Application
