def get_desktop_environment():
    """Dynamically detects the running desktop environment across all distributions."""
    de = os.environ.get('XDG_CURRENT_DESKTOP') or os.environ.get('DESKTOP_SESSION') or ''
    session_type = os.environ.get('XDG_SESSION_TYPE', 'unknown')

    de_clean = de.strip()
    if not de_clean:
        return f"Linux Desktop ({session_type})"

    de_lower = de_clean.lower()
    if 'kde' in de_lower or 'plasma' in de_lower:
        ver = os.environ.get('KDE_SESSION_VERSION', '')
        prefix = f"KDE Plasma {ver}".strip()
        return f"{prefix} ({session_type})"
    elif 'gnome' in de_lower:
        return f"GNOME ({session_type})"
    elif 'xfce' in de_lower:
        return f"XFCE ({session_type})"
    elif 'cinnamon' in de_lower:
        return f"Cinnamon ({session_type})"
    elif 'mate' in de_lower:
        return f"MATE ({session_type})"
    elif 'lxqt' in de_lower:
        return f"LXQt ({session_type})"
    elif 'hyprland' in de_lower:
        return f"Hyprland ({session_type})"
    elif 'sway' in de_lower:
        return f"Sway ({session_type})"
    return f"{de_clean} ({session_type})"


def detect_system_hardware():
    """Dynamically probes hardware across different SoC and PC architectures."""
    hw = {
        'model': 'Generic Linux Device',
        'is_nabu': False,
        'battery_path': None,
        'gpu_devfreq': None,
        'gpu_model': 'DRM Graphics Accelerator',
        'gpu_temp_zone': None,
        'cpu_count': max(os.cpu_count() or 1, 1),
        'net_iface': 'wlan0',
    }

    # 1. Device Tree / DMI Model
    if os.path.exists('/sys/firmware/devicetree/base/model'):
        try:
            with open('/sys/firmware/devicetree/base/model') as f:
                hw['model'] = f.read().strip('\x00\n ')
        except Exception:
            pass
    elif os.path.exists('/sys/class/dmi/id/product_name'):
        try:
            with open('/sys/class/dmi/id/product_name') as f:
                hw['model'] = f.read().strip()
        except Exception:
            pass

    if 'nabu' in hw['model'].lower() or 'sm8150' in hw['model'].lower():
        hw['is_nabu'] = True

    # 2. Battery detection (qcom-battery, BAT0, BAT1, etc.)
    bats = glob.glob('/sys/class/power_supply/*battery*') + glob.glob('/sys/class/power_supply/BAT*')
    if bats:
        hw['battery_path'] = bats[0]

    # 3. GPU Devfreq detection
    gpu_dfs = glob.glob('/sys/class/devfreq/*gpu*') + glob.glob('/sys/class/devfreq/*3d*')
    if gpu_dfs:
        hw['gpu_devfreq'] = gpu_dfs[0]

    # 4. GPU Model detection from DRM / SoC
    if hw['is_nabu']:
        hw['gpu_model'] = 'Qualcomm Adreno 640 • Driver: msm (DRM)'
    else:
        # Check DRM devices
        drm_drivers = set()
        for p in glob.glob('/sys/class/drm/card[0-9]/device/driver'):
            try:
                drm_drivers.add(os.path.basename(os.readlink(p)))
            except Exception:
                pass
        if drm_drivers:
            hw['gpu_model'] = f"DRM GPU ({', '.join(sorted(drm_drivers))})"

    # 5. Network interface detection
    ifaces = []
    if os.path.exists('/proc/net/dev'):
        try:
            with open('/proc/net/dev') as f:
                for line in f:
                    if ':' in line:
                        name = line.split(':')[0].strip()
                        if name != 'lo':
                            ifaces.append(name)
        except Exception:
            pass
    if ifaces:
        hw['net_iface'] = ifaces[0]

    return hw


def build_diagnostic_report(category="all"):
    """Compiles a detailed diagnostic text report for the requested subsystem."""
    hw = detect_system_hardware()
    lines = []
    lines.append("=" * 72)
    lines.append("           SYSTEM & HARDWARE MONITOR - DIAGNOSTIC REPORT")
    lines.append(f"  Generated:  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    lines.append(f"  Device:     {hw['model']}")
    lines.append(f"  Kernel:     {os.uname().release} ({os.uname().machine})")
    lines.append(f"  Desktop:    {get_desktop_environment()}")
    lines.append(f"  Category:   {category.upper()}")
    lines.append("=" * 72)
    lines.append("")

    # --- GPU SECTION ---
    if category in ("gpu", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"1. GPU STATUS & ENGINE METRICS ({hw['gpu_model']})")
        lines.append("────────────────────────────────────────────────────────────────────────")
        if hw['gpu_devfreq'] and os.path.exists(f"{hw['gpu_devfreq']}/cur_freq"):
            try:
                freq_hz = int(open(f"{hw['gpu_devfreq']}/cur_freq").read().strip())
                lines.append(f"  Clock Frequency:      {freq_hz / 1e6:.1f} MHz")
                gov = open(f"{hw['gpu_devfreq']}/governor").read().strip()
                lines.append(f"  Frequency Governor:   {gov}")
            except Exception:
                pass
        else:
            lines.append("  Clock Frequency:      Hardware Scaling Dynamic")

        # GPU Temp
        for tz in glob.glob('/sys/class/thermal/thermal_zone*'):
            try:
                t = open(f"{tz}/type").read().strip().lower()
                if 'gpu' in t:
                    temp_c = int(open(f"{tz}/temp").read().strip()) / 1000.0
                    lines.append(f"  GPU Core Temp:        {temp_c:.1f} °C ({t})")
                    break
            except Exception:
                pass

        lines.append("")
        lines.append("  [Active DRM GPU Clients (from /proc/<pid>/fdinfo)]")
        clients_found = False
        seen_pids = set()
        for path in glob.glob('/proc/[0-9]*/fdinfo/*'):
            try:
                with open(path) as f:
                    content = f.read()
                if 'drm-driver:' in content:
                    pid = int(path.split('/')[2])
                    if pid in seen_pids:
                        continue
                    seen_pids.add(pid)
                    comm = open(f'/proc/{pid}/comm').read().strip()
                    lines.append(f"    • PID {pid:<7} ({comm})")
                    for cl in content.splitlines():
                        if cl.startswith(('drm-driver:', 'drm-engine-', 'drm-resident-', 'drm-total-')):
                            lines.append(f"        {cl}")
                    clients_found = True
            except Exception:
                continue
        if not clients_found:
            lines.append("    No active DRM GPU client processes detected.")
        lines.append("")

    # --- CPU SECTION ---
    if category in ("cpu", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"2. CPU TOPOLOGY & PER-CORE METRICS ({hw['cpu_count']} Logical Cores)")
        lines.append("────────────────────────────────────────────────────────────────────────")
        try:
            l1, l5, l15 = os.getloadavg()
            lines.append(f"  System Load Avg:      {l1:.2f} (1 min), {l5:.2f} (5 min), {l15:.2f} (15 min)")
        except Exception:
            pass

        for i in range(hw['cpu_count']):
            freq = "N/A"
            gov = "N/A"
            try:
                freq = f"{int(open(f'/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq').read().strip()) / 1000:.0f} MHz"
                gov = open(f'/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_governor').read().strip()
            except Exception:
                pass
            lines.append(f"  Core {i:<2}:  Freq: {freq:<9} Gov: {gov:<10}")
        lines.append("")

    # --- MEMORY SECTION ---
    if category in ("memory", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("3. MEMORY & SWAP SUBSYSTEM")
        lines.append("────────────────────────────────────────────────────────────────────────")
        try:
            with open('/proc/meminfo') as f:
                for l in f:
                    if l.startswith(('MemTotal:', 'MemFree:', 'MemAvailable:', 'Buffers:', 'Cached:', 'SwapTotal:', 'SwapFree:', 'SwapCached:')):
                        lines.append(f"  {l.strip()}")
        except Exception:
            pass
        lines.append("")

    # --- DEVICE SECTION ---
    if category in ("device", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("4. POWER, STORAGE & NETWORK TELEMETRY")
        lines.append("────────────────────────────────────────────────────────────────────────")
        if hw['battery_path'] and os.path.exists(hw['battery_path']):
            try:
                cap = open(f"{hw['battery_path']}/capacity").read().strip()
                stat = open(f"{hw['battery_path']}/status").read().strip()
                lines.append(f"  Battery Level:        {cap}% ({stat})")
            except Exception:
                pass
        else:
            lines.append("  Battery Level:        AC Mains Powered (No battery detected)")

        try:
            st = os.statvfs('/')
            tot_gb = (st.f_blocks * st.f_frsize) / (1024**3)
            free_gb = (st.f_bavail * st.f_frsize) / (1024**3)
            used_gb = tot_gb - free_gb
            lines.append(f"  Root Storage (/):     {used_gb:.1f} GB used / {tot_gb:.1f} GB total ({free_gb:.1f} GB free)")
        except Exception:
            pass
        lines.append("")

    # --- SYSTEM INFO SECTION ---
    if category in ("sysinfo", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("5. FIRMWARE, OS & KERNEL INFORMATION")
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"  Hardware Model:       {hw['model']}")
        try:
            with open('/etc/os-release') as f:
                for l in f:
                    if l.startswith('PRETTY_NAME='):
                        lines.append(f"  Distribution:         {l.split('=', 1)[1].strip().strip('\"')}")
        except Exception:
            pass
        lines.append(f"  Desktop Environment:  {get_desktop_environment()}")
        lines.append(f"  Linux Kernel:         {os.uname().release}")
        lines.append(f"  Architecture:         {os.uname().machine}")
        try:
            with open('/proc/uptime') as f:
                up_sec = float(f.read().split()[0])
            d = int(up_sec // 86400)
            h = int((up_sec % 86400) // 3600)
            m = int((up_sec % 3600) // 60)
            lines.append(f"  System Uptime:        {d}d {h}h {m}m")
        except Exception:
            pass
        lines.append("")

    lines.append("=" * 72)
    lines.append("                         END OF REPORT")
    lines.append("=" * 72)
    return "\n".join(lines)


class NabuSystemMonitorWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="System Monitor")
        self.set_default_size(620, 860)

        # Detect hardware dynamically
        self.hw = detect_system_hardware()

        # Universal theming: Automatically respect FreeDesktop Portal / KDE Plasma / GNOME dark or light theme
        style_manager = Adw.StyleManager.get_default()
        style_manager.set_color_scheme(Adw.ColorScheme.DEFAULT)

        # Ensure icon is loaded across GNOME, KDE, XFCE, and custom WMs
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        theme.add_search_path('/home/user/.local/share/icons/hicolor')
        theme.add_search_path('/home/user/.local/share/pixmaps')
        theme.add_search_path('/usr/share/pixmaps')
        self.set_icon_name("system-monitor")

        self.last_cpu_stats = {}
        self.last_engine = {}
        self.last_net_bytes = (0, 0)
        self.last_time = time.time()
        self.thermal_zones = self.detect_thermal_zones()

        # Layout: ToastOverlay wrapping ToolbarView
        self.toast_overlay = Adw.ToastOverlay()
        toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(toolbar_view)

        # HeaderBar with ViewSwitcher and Export Log Button
        header_bar = Adw.HeaderBar()
        header_bar.set_show_title(True)
        header_bar.set_show_start_title_buttons(True)
        header_bar.set_show_end_title_buttons(True)

        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher(stack=self.stack)
        switcher.set_policy(Adw.ViewSwitcherPolicy.WIDE)
        header_bar.set_title_widget(switcher)

        # Export Log Button
        self.btn_export = Gtk.Button(icon_name="document-save-symbolic")
        self.btn_export.set_tooltip_text("Generate Diagnostic Log")
        self.btn_export.connect("clicked", self.on_export_log_clicked)
        header_bar.pack_end(self.btn_export)

        toolbar_view.add_top_bar(header_bar)

        # Build 5 View Pages
        self.build_gpu_page()
        self.build_cpu_page()
        self.build_memory_page()
        self.build_device_page()
        self.build_sysinfo_page()

        toolbar_view.set_content(self.stack)
        self.set_content(self.toast_overlay)

        # Refresh loop (1 second)
        GLib.timeout_add(1000, self.refresh_all_stats)
        self.refresh_all_stats()

    def detect_thermal_zones(self):
        zones = {}
        for path in glob.glob('/sys/class/thermal/thermal_zone*'):
            try:
                with open(os.path.join(path, 'type')) as f:
                    t = f.read().strip()
                zones[t] = os.path.join(path, 'temp')
            except Exception:
                pass
        return zones

    # ==========================================
    # EXPORT LOGGING SYSTEM
    # ==========================================
    def on_export_log_clicked(self, button):
        current_tab = self.stack.get_visible_child_name() or "gpu"
        dlg = Adw.AlertDialog(
            heading="Generate Diagnostic Log",
            body="Choose the diagnostic information to export into a report:"
        )
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("all", "All Sections (Full Diagnostic)")
        dlg.add_response("current", f"Current Tab ({current_tab.upper()})")
        dlg.add_response("gpu", "GPU Only")
        dlg.add_response("cpu", "CPU Only")
        dlg.add_response("memory", "Memory & Swap Only")
        dlg.add_response("device", "Device & Battery Only")
        dlg.add_response("sysinfo", "System Info Only")

        dlg.set_default_response("all")
        dlg.set_close_response("cancel")

        dlg.connect("response", self.on_dialog_response, current_tab)
        dlg.present(self)

    def on_dialog_response(self, dialog, response, current_tab):
        if response == "cancel":
            return
        cat = current_tab if response == "current" else response
        self.export_log(cat)

    def export_log(self, category):
        try:
            report_text = build_diagnostic_report(category)
            out_dir = os.path.expanduser("~/Documents")
            if not os.path.exists(out_dir):
                os.makedirs(out_dir, exist_ok=True)

            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            filename = f"sysmon-{category}-log-{ts}.txt"
            filepath = os.path.join(out_dir, filename)

            with open(filepath, "w") as f:
                f.write(report_text)

            toast = Adw.Toast(title=f"Saved report to ~/Documents/{filename}")
            self.toast_overlay.add_toast(toast)
        except Exception as e:
            toast = Adw.Toast(title=f"Error saving log: {e}")
            self.toast_overlay.add_toast(toast)

