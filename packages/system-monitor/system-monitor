    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_space:
            self.toggle_pause()
            return True
        elif keyval in (Gdk.KEY_q, Gdk.KEY_Escape) and (state & Gdk.ModifierType.CONTROL_MASK):
            self.close()
            return True
        return False

    def toggle_pause(self, button=None):
        self.paused = not self.paused
        if self.paused:
            self.btn_pause.set_icon_name("media-playback-start-symbolic")
            self.btn_pause.set_tooltip_text("Resume Live Telemetry (Space)")
            set_badge_text_and_class(self.live_badge, "❚❚ PAUSED", "pill-warning")
            self.toast_overlay.add_toast(Adw.Toast(title="Live telemetry paused"))
        else:
            self.btn_pause.set_icon_name("media-playback-pause-symbolic")
            self.btn_pause.set_tooltip_text("Pause Live Telemetry (Space)")
            set_badge_text_and_class(self.live_badge, "● LIVE", "pill-success")
            self.toast_overlay.add_toast(Adw.Toast(title="Live telemetry resumed"))
            self.refresh_all_stats()

    def detect_thermal_zones(self):
        zones = {}
        for path in glob.glob('/sys/class/thermal/thermal_zone*'):
            try:
                with open(os.path.join(path, 'type')) as f:
                    t = f.read().strip()
                zones[t] = os.path.join(path, 'temp')
            except Exception:
                pass
        return zones

