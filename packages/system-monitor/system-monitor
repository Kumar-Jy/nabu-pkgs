def make_row(title, subtitle=None, icon_name=None):
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    if icon_name:
        img = Gtk.Image.new_from_icon_name(icon_name)
        img.add_css_class("dim-label")
        row.add_prefix(img)
    return row


def create_hero_card(icon_name, initial_val, initial_sub, initial_badge="", initial_badge_cls="pill-accent"):
    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    card.add_css_class("card")
    card.add_css_class("hero-card")
    card.set_margin_top(6)
    card.set_margin_bottom(12)
    card.set_margin_start(4)
    card.set_margin_end(4)

    top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    if icon_name:
        icon = Gtk.Image.new_from_icon_name(icon_name)
        icon.set_pixel_size(36)
        icon.add_css_class("accent")
        top_row.append(icon)

    val_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    lbl_val = Gtk.Label(label=initial_val)
    lbl_val.add_css_class("hero-val")
    lbl_val.set_halign(Gtk.Align.START)
    val_box.append(lbl_val)
    top_row.append(val_box)

    badge = Gtk.Label(label=initial_badge)
    badge.add_css_class("pill-badge")
    badge.add_css_class(initial_badge_cls)
    badge.set_halign(Gtk.Align.END)
    badge.set_valign(Gtk.Align.CENTER)
    badge.set_hexpand(True)
    top_row.append(badge)
    card.append(top_row)

    lbl_sub = Gtk.Label(label=initial_sub)
    lbl_sub.add_css_class("hero-sub")
    lbl_sub.add_css_class("dim-label")
    lbl_sub.set_halign(Gtk.Align.START)
    lbl_sub.set_wrap(True)
    card.append(lbl_sub)

    pbar = Gtk.ProgressBar()
    pbar.add_css_class("hero-bar")
    card.append(pbar)

    return card, lbl_val, badge, lbl_sub, pbar


def set_badge_text_and_class(badge, text, cls_name):
    badge.set_label(text)
    for c in ("pill-success", "pill-warning", "pill-error", "pill-accent", "pill-neutral"):
        badge.remove_css_class(c)
    badge.add_css_class(cls_name)


class NabuSystemMonitorWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="System Monitor")
        self.set_default_size(980, 720)

        # Detect hardware dynamically
        self.hw = detect_system_hardware()

        # Universal theming: Automatically respect FreeDesktop Portal / KDE Plasma / GNOME dark or light theme
        style_manager = Adw.StyleManager.get_default()
        style_manager.set_color_scheme(Adw.ColorScheme.DEFAULT)

        # Ensure icon is loaded across GNOME, KDE, XFCE, and custom WMs
        disp = self.get_display()
        theme = Gtk.IconTheme.get_for_display(disp)
        theme.add_search_path('/home/user/.local/share/icons/hicolor')
        theme.add_search_path('/home/user/.local/share/pixmaps')
        theme.add_search_path('/usr/share/pixmaps')
        self.set_icon_name("system-monitor")

        # Load custom CSS
        provider = Gtk.CssProvider()
        provider.load_from_data(SYSTEM_MONITOR_CSS.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_display(
            disp, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.last_cpu_stats = {}
        self.last_engine = {}
        self.last_net_bytes = (0, 0)
        self.last_time = time.time()
        self.paused = False
        self.thermal_zones = self.detect_thermal_zones()

        # Keyboard shortcuts (Space = Pause/Resume, Ctrl+Q = Quit)
        key_controller = Gtk.EventControllerKey()
