    def export_log(self, category="all"):
        """Generates a text report and saves it to ~/Documents/."""
        try:
            report_text = build_diagnostic_report(category)
            out_dir = os.path.expanduser("~/Documents")
            if not os.path.exists(out_dir):
                os.makedirs(out_dir, exist_ok=True)

            ts = datetime.now().strftime("%Y%m%d_%H%M%S")
            filename = f"sysmon-{category}-log-{ts}.txt"
            filepath = os.path.join(out_dir, filename)

            with open(filepath, "w") as f:
                f.write(report_text)

            toast = Adw.Toast(title=f"Saved report to ~/Documents/{filename}")
            self.toast_overlay.add_toast(toast)
        except Exception as e:
            toast = Adw.Toast(title=f"Error saving log: {e}")
            self.toast_overlay.add_toast(toast)

