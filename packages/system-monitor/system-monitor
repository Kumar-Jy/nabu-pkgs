    # DATA REFRESH LOGIC
    # ==========================================
    def refresh_all_stats(self):
        self.refresh_gpu_stats()
        self.refresh_cpu_stats()
        self.refresh_memory_stats()
        self.refresh_device_stats()
        self.refresh_sysinfo_stats()
        return True

    def refresh_gpu_stats(self):
        # 1. Devfreq / Frequency
        if self.hw['gpu_devfreq'] and os.path.exists(f"{self.hw['gpu_devfreq']}/cur_freq"):
            try:
                freq_hz = int(open(f"{self.hw['gpu_devfreq']}/cur_freq").read().strip())
                freq_mhz = freq_hz / 1_000_000
                min_mhz, max_mhz = "N/A", "N/A"
                if os.path.exists(f"{self.hw['gpu_devfreq']}/min_freq"):
                    min_mhz = f"{int(open(f'{self.hw['gpu_devfreq']}/min_freq').read().strip()) / 1e6:.1f}"
                if os.path.exists(f"{self.hw['gpu_devfreq']}/max_freq"):
                    max_mhz = f"{int(open(f'{self.hw['gpu_devfreq']}/max_freq').read().strip()) / 1e6:.1f}"
                self.row_gpu_freq.set_subtitle(f"{freq_mhz:.1f} MHz (Min: {min_mhz} MHz • Max: {max_mhz} MHz)")
                gov = open(f"{self.hw['gpu_devfreq']}/governor").read().strip()
                self.row_gpu_gov.set_subtitle(f"Governor: {gov}")
            except Exception:
                self.row_gpu_freq.set_subtitle("Dynamic Clocking")
        else:
            self.row_gpu_freq.set_subtitle("Dynamic GPU Frequency")
            self.row_gpu_gov.set_subtitle("DRM Engine Scheduling")

        # 2. GPU Temp (scan thermal zones for 'gpu')
        temp_found = False
        for name, path in self.thermal_zones.items():
            if 'gpu' in name.lower():
                try:
                    temp_c = int(open(path).read().strip()) / 1000.0
                    self.row_gpu_temp.set_subtitle(f"{temp_c:.1f} °C ({name})")
                    temp_found = True
                    break
                except Exception:
                    pass
        if not temp_found:
            self.row_gpu_temp.set_subtitle("Sensor not exposed")

        # 3. DRM Per-Process Engine & Memory
        now = time.time()
        dt = max(now - self.last_time, 0.001)
        self.last_time = now

        curr_engine = {}
        curr_mem = {}
        app_names = {}

        for path in glob.glob('/proc/[0-9]*/fdinfo/*'):
            try:
                with open(path, 'r') as f:
                    content = f.read()
                if 'drm-driver:' in content:
                    pid = int(path.split('/')[2])
                    for line in content.splitlines():
                        if line.startswith(('drm-engine-gpu:', 'drm-engine-render:', 'drm-engine-3d:')):
                            curr_engine[pid] = curr_engine.get(pid, 0) + int(line.split()[1])
                        elif line.startswith(('drm-resident-memory:', 'drm-total-memory:')):
                            curr_mem[pid] = curr_mem.get(pid, 0) + int(line.split()[1])
                    if pid not in app_names:
                        with open(f'/proc/{pid}/comm') as f:
                            app_names[pid] = f.read().strip()
            except Exception:
                continue

        total_resident_kib = sum(curr_mem.values())
        self.row_gpu_mem.set_subtitle(f"{total_resident_kib / 1024:.1f} MB in use across active clients")

        total_active_ns = 0
        proc_stats = []
        for pid, comm in app_names.items():
            prev_ns = self.last_engine.get(pid, 0)
            cur_ns = curr_engine.get(pid, 0)
            diff_ns = max(cur_ns - prev_ns, 0) if prev_ns > 0 else 0
            total_active_ns += diff_ns
            pct = (diff_ns / (dt * 1e9)) * 100.0
            mem_mb = curr_mem.get(pid, 0) / 1024.0
            proc_stats.append((pid, comm, pct, mem_mb))

        total_gpu_pct = min((total_active_ns / (dt * 1e9)) * 100.0, 100.0)
        self.row_gpu_util.set_subtitle(f"{total_gpu_pct:.1f}% Active Engine Utilization")
        self.progress_gpu.set_fraction(total_gpu_pct / 100.0)

        proc_stats.sort(key=lambda x: (x[2], x[3]), reverse=True)
        current_pids = set()
        for pid, comm, pct, mem_mb in proc_stats:
            if pct < 0.1 and mem_mb < 2.0:
                continue
            current_pids.add(pid)
            sub_text = f"GPU: {pct:4.1f}%  •  VRAM: {mem_mb:5.1f} MB  •  PID: {pid}"
            if pid not in self.proc_rows:
                row = Adw.ActionRow(title=comm, subtitle=sub_text)
                self.proc_group.add(row)
                self.proc_rows[pid] = row
            else:
                row = self.proc_rows[pid]
                row.set_title(comm)
                row.set_subtitle(sub_text)

        for pid in list(self.proc_rows.keys()):
            if pid not in current_pids:
                self.proc_group.remove(self.proc_rows[pid])
                del self.proc_rows[pid]

        self.last_engine = curr_engine

    def refresh_cpu_stats(self):
        curr_cpu = {}
        try:
            with open('/proc/stat') as f:
                for line in f:
                    parts = line.split()
                    if parts[0].startswith('cpu'):
                        name = parts[0]
                        values = [int(x) for x in parts[1:]]
                        idle = values[3] + values[4]
                        total = sum(values)
                        curr_cpu[name] = (total, idle)
        except Exception:
            return

        if not self.last_cpu_stats:
            self.last_cpu_stats = curr_cpu
            return

        if 'cpu' in curr_cpu and 'cpu' in self.last_cpu_stats:
            t_diff = curr_cpu['cpu'][0] - self.last_cpu_stats['cpu'][0]
            i_diff = curr_cpu['cpu'][1] - self.last_cpu_stats['cpu'][1]
            tot_pct = ((t_diff - i_diff) / t_diff) * 100.0 if t_diff > 0 else 0.0
            self.row_cpu_util.set_subtitle(f"{tot_pct:.1f}% Active Overall Load")
            self.progress_cpu.set_fraction(min(tot_pct / 100.0, 1.0))

        temp_keys = [
            'cpu0-thermal', 'cpu1-thermal', 'cpu2-thermal', 'cpu3-thermal',
            'cpu4-top-thermal', 'cpu5-top-thermal', 'cpu6-top-thermal', 'cpu7-top-thermal'
        ]

        for i in range(self.hw['cpu_count']):
            core_name = f"cpu{i}"
            pct = 0.0
            if core_name in curr_cpu and core_name in self.last_cpu_stats:
                dt = curr_cpu[core_name][0] - self.last_cpu_stats[core_name][0]
                di = curr_cpu[core_name][1] - self.last_cpu_stats[core_name][1]
                pct = ((dt - di) / dt) * 100.0 if dt > 0 else 0.0

            freq_str = "N/A"
            freq_path = f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq"
            if os.path.exists(freq_path):
                try:
                    with open(freq_path) as f:
                        freq_khz = int(f.read().strip())
                    freq_str = f"{freq_khz / 1000:.0f} MHz"
                except Exception:
                    pass

            temp_str = "N/A"
            if i < len(temp_keys):
                t_zone = self.thermal_zones.get(temp_keys[i])
                if t_zone and os.path.exists(t_zone):
                    try:
                        with open(t_zone) as f:
                            temp_str = f"{int(f.read().strip()) / 1000.0:.1f} °C"
                    except Exception:
                        pass

            if self.hw['is_nabu']:
                tier = "Silver (Little)" if i < 4 else ("Gold (Big)" if i < 7 else "Gold Prime (Super)")
                sub = f"{tier}  •  Freq: {freq_str}  •  Temp: {temp_str}"
            else:
                sub = f"Freq: {freq_str}" + (f"  •  Temp: {temp_str}" if temp_str != "N/A" else "")

            if i < len(self.core_rows):
                self.core_rows[i].set_title(f"Core {i}  [{pct:4.1f}%]")
                self.core_rows[i].set_subtitle(sub)
                self.core_bars[i].set_fraction(min(max(pct / 100.0, 0.0), 1.0))

        self.last_cpu_stats = curr_cpu

    def refresh_memory_stats(self):
        mem = {}
        try:
            with open('/proc/meminfo') as f:
                for line in f:
                    p = line.split(':')
                    if len(p) == 2:
                        mem[p[0].strip()] = int(p[1].split()[0])
        except Exception:
            return

        total_kib = mem.get('MemTotal', 1)
        avail_kib = mem.get('MemAvailable', 0)
        used_kib = total_kib - avail_kib
        buffers_kib = mem.get('Buffers', 0)
        cached_kib = mem.get('Cached', 0)
        ram_pct = (used_kib / total_kib) * 100.0

        self.row_ram_usage.set_subtitle(f"{used_kib/1024/1024:.2f} GiB used of {total_kib/1024/1024:.2f} GiB ({ram_pct:.1f}%)")
        self.progress_ram.set_fraction(min(ram_pct / 100.0, 1.0))
        self.row_ram_breakdown.set_subtitle(f"Available: {avail_kib/1024:.0f} MB • Buffers/Cache: {(buffers_kib+cached_kib)/1024:.0f} MB")

        swap_total = mem.get('SwapTotal', 0)
        swap_free = mem.get('SwapFree', 0)
        swap_used = swap_total - swap_free
        swap_pct = (swap_used / swap_total * 100.0) if swap_total > 0 else 0.0

        self.row_swap_usage.set_subtitle(f"{swap_used/1024/1024:.2f} GiB used of {swap_total/1024/1024:.2f} GiB ({swap_pct:.1f}%)")
        self.progress_swap.set_fraction(min(swap_pct / 100.0, 1.0))
        self.row_swap_detail.set_subtitle(f"Free Swap: {swap_free/1024:.0f} MB")

        proc_mem = []
        for path in glob.glob('/proc/[0-9]*/status'):
            try:
                pid = int(path.split('/')[2])
                rss_kb = 0
                comm = ""
                with open(path) as f:
                    for l in f:
                        if l.startswith('Name:'):
                            comm = l.split()[1]
                        elif l.startswith('VmRSS:'):
                            rss_kb = int(l.split()[1])
                if rss_kb > 10240:
                    proc_mem.append((pid, comm, rss_kb))
            except Exception:
                continue

        proc_mem.sort(key=lambda x: x[2], reverse=True)
        for i, row in enumerate(self.mem_app_rows):
            if i < len(proc_mem):
                pid, comm, rss = proc_mem[i]
                row.set_title(comm)
                row.set_subtitle(f"Resident Memory: {rss/1024:.1f} MB  •  PID: {pid}")
                row.set_visible(True)
            else:
                row.set_visible(False)

    def refresh_device_stats(self):
        # 1. Battery (Universal)
        if self.hw['battery_path'] and os.path.exists(self.hw['battery_path']):
            try:
                bpath = self.hw['battery_path']
                cap = int(open(f"{bpath}/capacity").read().strip())
                status = open(f"{bpath}/status").read().strip()
                temp_c = 0.0
                if os.path.exists(f"{bpath}/temp"):
                    temp_c = int(open(f"{bpath}/temp").read().strip()) / 10.0
                power_w = 0.0
                if os.path.exists(f"{bpath}/voltage_now") and os.path.exists(f"{bpath}/current_now"):
                    v = int(open(f"{bpath}/voltage_now").read().strip())
                    c = abs(int(open(f"{bpath}/current_now").read().strip()))
                    power_w = (v / 1e6) * (c / 1e6)

                self.row_bat_cap.set_subtitle(f"{cap}%  ({status})")
                self.progress_bat.set_fraction(cap / 100.0)
                self.row_bat_power.set_subtitle(f"Power: {power_w:.2f} W  •  Status: {status}")
                self.row_bat_health.set_subtitle(f"Temperature: {temp_c:.1f} °C  •  Health: Good")
            except Exception:
                self.row_bat_cap.set_subtitle("Battery present")
        else:
            self.row_bat_cap.set_subtitle("AC Mains Connected (No battery detected)")
            self.progress_bat.set_fraction(1.0)
            self.row_bat_power.set_subtitle("Direct Wall Power")
            self.row_bat_health.set_subtitle("Desktop/Stationary System")

        # 2. Storage
        try:
            st = os.statvfs('/')
            total_gb = (st.f_blocks * st.f_frsize) / (1024**3)
            free_gb = (st.f_bavail * st.f_frsize) / (1024**3)
            used_gb = total_gb - free_gb
            pct = (used_gb / total_gb) * 100.0
            self.row_disk_usage.set_subtitle(f"{used_gb:.1f} GB used of {total_gb:.1f} GB ({pct:.1f}%) • Free: {free_gb:.1f} GB")
            self.progress_disk.set_fraction(pct / 100.0)
        except Exception:
            self.row_disk_usage.set_subtitle("Storage info unavailable")

        # 3. Network (Dynamic Interface)
        try:
            rx_bytes = 0
            tx_bytes = 0
            target_if = self.hw['net_iface']
            with open('/proc/net/dev') as f:
                for line in f:
                    if f"{target_if}:" in line:
                        parts = line.split(':')[1].split()
                        rx_bytes = int(parts[0])
                        tx_bytes = int(parts[8])
                        break
            prev_rx, prev_tx = self.last_net_bytes
            rx_speed_kb = (rx_bytes - prev_rx) / 1024.0 if prev_rx > 0 else 0.0
            tx_speed_kb = (tx_bytes - prev_tx) / 1024.0 if prev_tx > 0 else 0.0
            self.last_net_bytes = (rx_bytes, tx_bytes)

            self.row_net_status.set_subtitle(f"Interface: {target_if} (Active)")
            self.row_net_speed.set_subtitle(f"↓ {rx_speed_kb:.1f} KB/s  •  ↑ {tx_speed_kb:.1f} KB/s")
        except Exception:
            self.row_net_speed.set_subtitle("Network stats unavailable")

    def refresh_sysinfo_stats(self):
        try:
            with open('/proc/sys/kernel/hostname') as f:
                self.row_hostname.set_subtitle(f.read().strip())
        except Exception:
            pass

        try:
            with open('/proc/uptime') as f:
                up_sec = float(f.read().split()[0])
            d = int(up_sec // 86400)
            h = int((up_sec % 86400) // 3600)
            m = int((up_sec % 3600) // 60)
            s = int(up_sec % 60)
            up_str = f"{d}d {h}h {m}m {s}s" if d > 0 else f"{h}h {m}m {s}s"
            self.row_uptime_info.set_subtitle(up_str)
        except Exception:
            pass

        try:
            l1, l5, l15 = os.getloadavg()
            self.row_load_info.set_subtitle(f"{l1:.2f} (1 min)  •  {l5:.2f} (5 min)  •  {l15:.2f} (15 min)")
        except Exception:
            pass

        try:
            with open('/proc/loadavg') as f:
                parts = f.read().split()
                run_threads, tot_threads = parts[3].split('/')
                self.row_tasks_info.set_subtitle(f"{run_threads} running of {tot_threads} total threads")
        except Exception:
            pass


