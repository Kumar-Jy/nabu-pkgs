    def refresh_all_stats(self):
        if self.paused:
            return True
        self.refresh_gpu_stats()
        self.refresh_cpu_stats()
        self.refresh_memory_stats()
        self.refresh_power_stats()
        self.refresh_sensors_stats()
        self.refresh_device_stats()
        self.refresh_sysinfo_stats()
        return True

    def refresh_gpu_stats(self):
        # 1. Devfreq / Frequency
        freq_mhz = 0.0
        gov = "DRM Scheduling"
        if self.hw['gpu_devfreq'] and os.path.exists(f"{self.hw['gpu_devfreq']}/cur_freq"):
            try:
                freq_hz = int(open(f"{self.hw['gpu_devfreq']}/cur_freq").read().strip())
                freq_mhz = freq_hz / 1_000_000
                min_mhz, max_mhz = "N/A", "N/A"
                if os.path.exists(f"{self.hw['gpu_devfreq']}/min_freq"):
                    min_mhz = f"{int(open(f'{self.hw['gpu_devfreq']}/min_freq').read().strip()) / 1e6:.1f}"
                if os.path.exists(f"{self.hw['gpu_devfreq']}/max_freq"):
                    max_mhz = f"{int(open(f'{self.hw['gpu_devfreq']}/max_freq').read().strip()) / 1e6:.1f}"
                self.row_gpu_freq.set_subtitle(f"{freq_mhz:.1f} MHz (Min: {min_mhz} MHz • Max: {max_mhz} MHz)")
                gov = open(f"{self.hw['gpu_devfreq']}/governor").read().strip()
                self.row_gpu_gov.set_subtitle(f"Governor: {gov}")
            except Exception:
                self.row_gpu_freq.set_subtitle("Dynamic Clocking")
        else:
            self.row_gpu_freq.set_subtitle("Dynamic GPU Frequency")
            self.row_gpu_gov.set_subtitle("DRM Engine Scheduling")

        # 2. GPU Temp
        gpu_temp_c = None
        gpu_temp_str = "N/A"
        for name, path in self.thermal_zones.items():
            if 'gpu' in name.lower():
                try:
                    gpu_temp_c = int(open(path).read().strip()) / 1000.0
                    gpu_temp_str = f"{gpu_temp_c:.1f} °C"
                    self.row_gpu_temp.set_subtitle(format_temp(gpu_temp_c))
                    break
                except Exception:
                    pass
        if gpu_temp_c is None:
            self.row_gpu_temp.set_subtitle("Sensor not exposed")

        # 3. DRM Per-Process Engine & Memory
        now = time.time()
        dt = max(now - self.last_time, 0.001)
        self.last_time = now

        curr_engine = {}
        curr_mem = {}
        app_names = {}

        for path in glob.glob('/proc/[0-9]*/fdinfo/*'):
            try:
                with open(path, 'r') as f:
                    content = f.read()
                if 'drm-driver:' in content:
                    pid = int(path.split('/')[2])
                    for line in content.splitlines():
                        if line.startswith(('drm-engine-gpu:', 'drm-engine-render:', 'drm-engine-3d:')):
                            curr_engine[pid] = curr_engine.get(pid, 0) + int(line.split()[1])
                        elif line.startswith(('drm-resident-memory:', 'drm-total-memory:')):
                            curr_mem[pid] = curr_mem.get(pid, 0) + int(line.split()[1])
                    if pid not in app_names:
                        with open(f'/proc/{pid}/comm') as f:
                            app_names[pid] = f.read().strip()
            except Exception:
                continue

        total_resident_kib = sum(curr_mem.values())
        self.row_gpu_mem.set_subtitle(f"{total_resident_kib / 1024:.1f} MB in use across active clients")

        total_active_ns = 0
        proc_stats = []
        for pid, comm in app_names.items():
            prev_ns = self.last_engine.get(pid, 0)
            cur_ns = curr_engine.get(pid, 0)
            diff_ns = max(cur_ns - prev_ns, 0) if prev_ns > 0 else 0
            total_active_ns += diff_ns
            pct = (diff_ns / (dt * 1e9)) * 100.0
            mem_mb = curr_mem.get(pid, 0) / 1024.0
            proc_stats.append((pid, comm, pct, mem_mb))

        total_gpu_pct = min((total_active_ns / (dt * 1e9)) * 100.0, 100.0)

        # Update GPU Hero Card
        self.lbl_gpu_hero_val.set_label(f"{total_gpu_pct:.1f}%")
        self.progress_gpu_hero.set_fraction(total_gpu_pct / 100.0)
        set_badge_text_and_class(self.badge_gpu_hero, gov, "pill-accent" if total_gpu_pct < 60 else "pill-warning")
        freq_info = f"{freq_mhz:.0f} MHz" if freq_mhz > 0 else "Dynamic"
        self.lbl_gpu_hero_sub.set_label(f"{self.hw['gpu_model']} • {freq_info} • Temp: {gpu_temp_str} • VRAM: {total_resident_kib / 1024:.1f} MB")

        proc_stats.sort(key=lambda x: (x[2], x[3]), reverse=True)
        current_pids = set()
        for pid, comm, pct, mem_mb in proc_stats:
            if pct < 0.1 and mem_mb < 2.0:
                continue
            current_pids.add(pid)
            sub_text = f"GPU: {pct:4.1f}%  •  VRAM: {mem_mb:5.1f} MB  •  PID: {pid}"
            if pid not in self.proc_rows:
                row = make_row(comm, sub_text, "application-x-executable-symbolic")
                self.proc_group.add(row)
                self.proc_rows[pid] = row
            else:
                row = self.proc_rows[pid]
                row.set_title(comm)
                row.set_subtitle(sub_text)

        for pid in list(self.proc_rows.keys()):
            if pid not in current_pids:
                self.proc_group.remove(self.proc_rows[pid])
                del self.proc_rows[pid]

        self.last_engine = curr_engine

    def refresh_cpu_stats(self):
        curr_cpu = {}
        try:
            with open('/proc/stat') as f:
                for line in f:
                    parts = line.split()
                    if parts[0].startswith('cpu'):
                        name = parts[0]
                        values = [int(x) for x in parts[1:]]
                        idle = values[3] + values[4]
                        total = sum(values)
                        curr_cpu[name] = (total, idle)
        except Exception:
            return

        if not self.last_cpu_stats:
            self.last_cpu_stats = curr_cpu
            return

        tot_pct = 0.0
        if 'cpu' in curr_cpu and 'cpu' in self.last_cpu_stats:
            t_diff = curr_cpu['cpu'][0] - self.last_cpu_stats['cpu'][0]
            i_diff = curr_cpu['cpu'][1] - self.last_cpu_stats['cpu'][1]
            tot_pct = ((t_diff - i_diff) / t_diff) * 100.0 if t_diff > 0 else 0.0

        # Update CPU Hero Card
        self.lbl_cpu_hero_val.set_label(f"{tot_pct:.1f}%")
        self.progress_cpu_hero.set_fraction(min(tot_pct / 100.0, 1.0))
        badge_cls = "pill-accent" if tot_pct < 60.0 else ("pill-warning" if tot_pct < 85.0 else "pill-error")
        set_badge_text_and_class(self.badge_cpu_hero, f"{tot_pct:.1f}% Load", badge_cls)

        temp_keys = [
            'cpu0-thermal', 'cpu1-thermal', 'cpu2-thermal', 'cpu3-thermal',
            'cpu4-top-thermal', 'cpu5-top-thermal', 'cpu6-top-thermal', 'cpu7-top-thermal'
        ]

        freq_samples = []
        for i in range(self.hw['cpu_count']):
            core_name = f"cpu{i}"
            pct = 0.0
            if core_name in curr_cpu and core_name in self.last_cpu_stats:
                dt = curr_cpu[core_name][0] - self.last_cpu_stats[core_name][0]
                di = curr_cpu[core_name][1] - self.last_cpu_stats[core_name][1]
                pct = ((dt - di) / dt) * 100.0 if dt > 0 else 0.0

            freq_str = "N/A"
            freq_path = f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq"
            if os.path.exists(freq_path):
                try:
                    with open(freq_path) as f:
                        freq_khz = int(f.read().strip())
                    freq_mhz = freq_khz / 1000
                    freq_str = f"{freq_mhz:.0f} MHz"
                    freq_samples.append(freq_mhz)
                except Exception:
                    pass

            temp_str = "N/A"
            if i < len(temp_keys):
                t_zone = self.thermal_zones.get(temp_keys[i])
                if t_zone and os.path.exists(t_zone):
                    try:
                        with open(t_zone) as f:
                            temp_str = f"{int(f.read().strip()) / 1000.0:.1f} °C"
                    except Exception:
                        pass

            if self.hw['is_nabu']:
                tier = "Silver (Little)" if i < 4 else ("Gold (Big)" if i < 7 else "Gold Prime (Super)")
                sub = f"{tier}  •  Freq: {freq_str}  •  Temp: {temp_str}"
            else:
                sub = f"Freq: {freq_str}" + (f"  •  Temp: {temp_str}" if temp_str != "N/A" else "")

            if i < len(self.core_rows):
                self.core_rows[i].set_title(f"Core {i}  [{pct:4.1f}%]")
                self.core_rows[i].set_subtitle(sub)
                self.core_bars[i].set_fraction(min(max(pct / 100.0, 0.0), 1.0))

        avg_freq = sum(freq_samples) / len(freq_samples) if freq_samples else 0
        freq_summary = f" • Avg Freq: {avg_freq:.0f} MHz" if avg_freq > 0 else ""
        title_suffix = "Snapdragon 855/860 Kryo 485" if self.hw['is_nabu'] else f"{self.hw['cpu_count']}-Core"
        self.lbl_cpu_hero_sub.set_label(f"{title_suffix} • {self.hw['cpu_count']} Logical Cores Active{freq_summary}")

        self.last_cpu_stats = curr_cpu

    def refresh_memory_stats(self):
        mem = {}
        try:
            with open('/proc/meminfo') as f:
                for line in f:
                    p = line.split(':')
                    if len(p) == 2:
                        mem[p[0].strip()] = int(p[1].split()[0])
        except Exception:
            return

        total_kib = mem.get('MemTotal', 1)
        avail_kib = mem.get('MemAvailable', 0)
        used_kib = total_kib - avail_kib
        buffers_kib = mem.get('Buffers', 0)
        cached_kib = mem.get('Cached', 0)
        ram_pct = (used_kib / total_kib) * 100.0

        # Update RAM Hero Card
        self.lbl_ram_hero_val.set_label(f"{used_kib/1024/1024:.2f} GiB")
        self.progress_ram_hero.set_fraction(min(ram_pct / 100.0, 1.0))
        badge_cls = "pill-accent" if ram_pct < 75.0 else ("pill-warning" if ram_pct < 90.0 else "pill-error")
        set_badge_text_and_class(self.badge_ram_hero, f"{ram_pct:.1f}% Used", badge_cls)
        self.lbl_ram_hero_sub.set_label(
            f"{total_kib/1024/1024:.2f} GiB Total RAM • Free/Available: {avail_kib/1024/1024:.2f} GiB • Cache: {(buffers_kib+cached_kib)/1024:.0f} MB"
        )

        self.row_ram_usage.set_subtitle(f"{used_kib/1024/1024:.2f} GiB used of {total_kib/1024/1024:.2f} GiB ({ram_pct:.1f}%)")
        self.progress_ram.set_fraction(min(ram_pct / 100.0, 1.0))
        self.row_ram_breakdown.set_subtitle(f"Available: {avail_kib/1024:.0f} MB • Buffers/Cache: {(buffers_kib+cached_kib)/1024:.0f} MB")

        swap_total = mem.get('SwapTotal', 0)
        swap_free = mem.get('SwapFree', 0)
        swap_used = swap_total - swap_free
        swap_pct = (swap_used / swap_total * 100.0) if swap_total > 0 else 0.0

        self.row_swap_usage.set_subtitle(f"{swap_used/1024/1024:.2f} GiB used of {swap_total/1024/1024:.2f} GiB ({swap_pct:.1f}%)")
        self.progress_swap.set_fraction(min(swap_pct / 100.0, 1.0))
        self.row_swap_detail.set_subtitle(f"Free Swap: {swap_free/1024:.0f} MB • ZRAM Compressed")

        proc_mem = []
        for path in glob.glob('/proc/[0-9]*/status'):
            try:
                pid = int(path.split('/')[2])
                rss_kb = 0
                comm = ""
                with open(path) as f:
                    for l in f:
                        if l.startswith('Name:'):
                            comm = l.split()[1]
                        elif l.startswith('VmRSS:'):
                            rss_kb = int(l.split()[1])
                if rss_kb > 10240:
                    proc_mem.append((pid, comm, rss_kb))
            except Exception:
                continue

        proc_mem.sort(key=lambda x: x[2], reverse=True)
        for i, row in enumerate(self.mem_app_rows):
            if i < len(proc_mem):
                pid, comm, rss = proc_mem[i]
                row.set_title(comm)
                row.set_subtitle(f"Resident Memory: {rss/1024:.1f} MB  •  PID: {pid}")
                row.set_visible(True)
            else:
                row.set_visible(False)

    def refresh_power_stats(self):
        bpath = self.hw['battery_path']
        if bpath and os.path.exists(bpath):
            try:
                cap = int(open(f"{bpath}/capacity").read().strip())
                status = open(f"{bpath}/status").read().strip()
                tech = open(f"{bpath}/technology").read().strip() if os.path.exists(f"{bpath}/technology") else "Li-ion"
                
                v_u = int(open(f"{bpath}/voltage_now").read().strip()) if os.path.exists(f"{bpath}/voltage_now") else 0
                c_u = abs(int(open(f"{bpath}/current_now").read().strip())) if os.path.exists(f"{bpath}/current_now") else 0
                v_v = v_u / 1e6
                c_a = c_u / 1e6
                p_w = v_v * c_a

                # Hero Card Update
                self.lbl_bat_hero_val.set_label(f"{cap}%")
                self.progress_bat_hero.set_fraction(min(max(cap / 100.0, 0.0), 1.0))
                
                direction = "+" if status.lower() == "charging" else "-"
                if status.lower() == "charging":
                    badge_cls = "pill-success"
                    badge_str = f"⚡ Charging ({direction}{p_w:.1f}W)"
                else:
                    if cap <= 10:
                        badge_cls = "pill-error"
                    elif cap <= 20:
                        badge_cls = "pill-warning"
                    else:
                        badge_cls = "pill-accent"
                    badge_str = f"🔋 Discharging ({direction}{p_w:.1f}W)"
                set_badge_text_and_class(self.badge_bat_hero, badge_str, badge_cls)

                # Hero row & Progress
                status_icon = "⚡ Charging" if status.lower() == "charging" else ("🔋 Discharging" if status.lower() == "discharging" else f"🔌 {status}")
                self.row_bat_hero.set_title(f"Battery Level: {cap}%")
                self.row_bat_hero.set_subtitle(f"{status_icon} • State of Charge")
                self.progress_bat_main.set_fraction(min(max(cap / 100.0, 0.0), 1.0))

                # Flow rate
                self.row_bat_rate.set_subtitle(f"{direction}{p_w:.2f} Watts ({status})")

                # Voltage
                v_min = int(open(f"{bpath}/voltage_min_design").read().strip()) / 1e6 if os.path.exists(f"{bpath}/voltage_min_design") else 3.4
                v_max = int(open(f"{bpath}/voltage_max_design").read().strip()) / 1e6 if os.path.exists(f"{bpath}/voltage_max_design") else 4.48
                self.row_bat_volts.set_subtitle(f"{v_v:.3f} Volts (Operating Range: {v_min:.2f} V – {v_max:.2f} V)")

                # Current
                self.row_bat_current.set_subtitle(f"{c_a * 1000:.0f} mA  ({c_a:.3f} Amperes)")

                # Capacity & Energy
                full_mah = int(open(f"{bpath}/charge_full_design").read().strip()) / 1000.0 if os.path.exists(f"{bpath}/charge_full_design") else 8720
                energy_wh = int(open(f"{bpath}/energy_full_design").read().strip()) / 1e6 if os.path.exists(f"{bpath}/energy_full_design") else 33.6
                self.row_bat_cap.set_subtitle(f"{full_mah:,.0f} mAh Design Capacity • {energy_wh:.1f} Wh Energy")

                # Temp
                temp_str = "N/A"
                if os.path.exists(f"{bpath}/temp"):
                    temp_c = int(open(f"{bpath}/temp").read().strip()) / 10.0
                    temp_str = f"{temp_c:.1f} °C"
                    self.row_bat_temp.set_subtitle(format_temp(temp_c))
                else:
                    self.row_bat_temp.set_subtitle("Temperature sensor unexposed")

                # Health
                self.row_bat_health.set_subtitle(f"Health: Good  •  Chemistry: {tech}")

                # Runtime Estimate
                est_str = "Calculating..."
                if c_a > 0.05:
                    if status.lower() == "discharging":
                        rem_hours = (cap / 100.0) * (full_mah / (c_a * 1000.0))
                        rh = int(rem_hours)
                        rm = int((rem_hours - rh) * 60)
                        est_str = f"~{rh}h {rm:02d}m on battery"
                        self.row_bat_est.set_subtitle(f"Estimated {est_str} remaining")
                    elif status.lower() == "charging":
                        rem_hours = ((100 - cap) / 100.0) * (full_mah / (c_a * 1000.0))
                        rh = int(rem_hours)
                        rm = int((rem_hours - rh) * 60)
                        est_str = f"~{rh}h {rm:02d}m until full"
                        self.row_bat_est.set_subtitle(f"Estimated {est_str}")
                    else:
                        est_str = f"Fully Charged"
                        self.row_bat_est.set_subtitle(f"Fully Charged ({status})")
                else:
                    self.row_bat_est.set_subtitle("Calculating runtime estimate...")

                self.lbl_bat_hero_sub.set_label(f"{est_str} • Voltage: {v_v:.2f}V • Cell Temp: {temp_str} • Health: Good")

            except Exception as e:
                self.row_bat_hero.set_subtitle(f"Battery Telemetry Error: {e}")
        else:
            self.lbl_bat_hero_val.set_label("100%")
            self.progress_bat_hero.set_fraction(1.0)
            set_badge_text_and_class(self.badge_bat_hero, "🔌 AC Mains Power", "pill-success")
            self.lbl_bat_hero_sub.set_label("Stationary Wall Power • No Internal Battery Drain")

            self.row_bat_hero.set_title("AC Mains Connected")
            self.row_bat_hero.set_subtitle("Direct Wall Power (No Internal Battery Detected)")
            self.progress_bat_main.set_fraction(1.0)
            self.row_bat_rate.set_subtitle("Direct Stationary AC Power")
            self.row_bat_volts.set_subtitle("Mains Power Supply")
            self.row_bat_current.set_subtitle("N/A")
            self.row_bat_cap.set_subtitle("Desktop/Server Form Factor")
            self.row_bat_temp.set_subtitle("N/A")
            self.row_bat_health.set_subtitle("AC Mains")
            self.row_bat_est.set_subtitle("Continuous Wall Power")

        # Charger Hardware
        cpath = self.hw['charger_path']
        if cpath and os.path.exists(cpath):
            try:
                online = open(f"{cpath}/online").read().strip() == '1'
                c_stat = open(f"{cpath}/status").read().strip() if os.path.exists(f"{cpath}/status") else "Discharging"
                usb_type = open(f"{cpath}/usb_type").read().strip() if os.path.exists(f"{cpath}/usb_type") else "Unknown"

                if online:
                    self.row_chg_status.set_subtitle("🟢 Plugged In (Power Source Active)")
                    self.row_chg_proto.set_subtitle(f"Fast / Standard Protocol: {usb_type}")
                else:
                    self.row_chg_status.set_subtitle("⚪ Disconnected (Running on Battery)")
                    self.row_chg_proto.set_subtitle("Unplugged")

                self.row_chg_ctrl.set_subtitle(f"{os.path.basename(cpath)} (PM8150B Charger IC)")

                # Input Voltage/Current
                v_in = int(open(f"{cpath}/voltage_now").read().strip()) / 1e6 if os.path.exists(f"{cpath}/voltage_now") else 0.0
                c_in = int(open(f"{cpath}/current_now").read().strip()) / 1e6 if os.path.exists(f"{cpath}/current_now") else 0.0
                c_max = int(open(f"{cpath}/current_max").read().strip()) / 1e6 if os.path.exists(f"{cpath}/current_max") else 0.0
                if v_in > 0 or c_in > 0:
                    self.row_chg_input.set_subtitle(f"Input: {v_in:.2f} V • Current: {c_in*1000:.0f} mA (Limit: {c_max*1000:.0f} mA)")
                else:
                    self.row_chg_input.set_subtitle(f"Standby / Inactive (Online: {online})")
            except Exception:
                self.row_chg_status.set_subtitle("Charger status unavailable")
        else:
            self.row_chg_status.set_subtitle("Standard AC/DC Supply")
            self.row_chg_proto.set_subtitle("Direct Power")
            self.row_chg_ctrl.set_subtitle("AC Adapter")
            self.row_chg_input.set_subtitle("AC Line Voltage")

        # Charger Temp
        tz_chg = self.thermal_zones.get('pm8150b-thermal')
        if tz_chg and os.path.exists(tz_chg):
            try:
                tc = int(open(tz_chg).read().strip()) / 1000.0
                self.row_chg_temp.set_subtitle(format_temp(tc))
            except Exception:
                self.row_chg_temp.set_subtitle("Sensor unreadable")
        else:
            self.row_chg_temp.set_subtitle("Sensor not exposed")

        # Type-C / TCPM
        tpath = self.hw['typec_path']
        if tpath and os.path.exists(tpath):
            try:
                t_online = open(f"{tpath}/online").read().strip()
                t_usb_type = open(f"{tpath}/usb_type").read().strip() if os.path.exists(f"{tpath}/usb_type") else "N/A"
                self.row_chg_typec.set_subtitle(f"Port Online: {t_online} • Protocol: {t_usb_type}")
            except Exception:
                self.row_chg_typec.set_subtitle("TCPM port active")
        else:
            self.row_chg_typec.set_subtitle("Standard USB / Power Port")

    def refresh_sensors_stats(self):
        zones = {}
        for name, path in self.thermal_zones.items():
            try:
                if os.path.exists(path):
                    zones[name] = int(open(path).read().strip()) / 1000.0
            except Exception:
                pass

        # Update Sensor Hero Card
        if zones:
            max_zone_val = max(zones.values())
            self.lbl_sensor_hero_val.set_label(f"{max_zone_val:.1f} °C")
            self.progress_sensor_hero.set_fraction(min(max_zone_val / 100.0, 1.0))
            if max_zone_val < 50.0:
                set_badge_text_and_class(self.badge_sensor_hero, "Optimal Thermals", "pill-success")
            elif max_zone_val < 72.0:
                set_badge_text_and_class(self.badge_sensor_hero, "Normal Thermals", "pill-accent")
            elif max_zone_val < 85.0:
                set_badge_text_and_class(self.badge_sensor_hero, "Elevated Thermals", "pill-warning")
            else:
                set_badge_text_and_class(self.badge_sensor_hero, "Thermal Throttling", "pill-error")
        else:
            self.lbl_sensor_hero_val.set_label("N/A")
            set_badge_text_and_class(self.badge_sensor_hero, "Standard Sensors", "pill-accent")

        if self.hw['is_nabu']:
            # 1. CPU Silver Little Cores (0-3)
            s_temps = [zones.get(f"cpu{i}-thermal") for i in range(4) if f"cpu{i}-thermal" in zones]
            avg_s_str = "N/A"
            if s_temps:
                avg_s = sum(s_temps) / len(s_temps)
                avg_s_str = f"{avg_s:.0f}°C"
                s_details = "  •  ".join([f"C{i}: {t:.0f}°C" for i, t in enumerate(s_temps)])
                self.row_therm_silver.set_subtitle(f"{format_temp(avg_s)}  [{s_details}]")
            else:
                self.row_therm_silver.set_subtitle("Sensors unexposed")

            # 2. Gold Cluster (Cores 4-6 Big) Top & Bottom
            g_top = [zones.get(f"cpu{i}-top-thermal") for i in range(4, 7) if f"cpu{i}-top-thermal" in zones]
            g_bot = [zones.get(f"cpu{i}-bottom-thermal") for i in range(4, 7) if f"cpu{i}-bottom-thermal" in zones]
            avg_g_str = "N/A"
            if g_top:
                avg_top = sum(g_top) / len(g_top)
                avg_g_str = f"{avg_top:.0f}°C"
                t_str = "  •  ".join([f"C{i}: {t:.0f}°C" for i, t in zip(range(4, 7), g_top)])
                self.row_therm_gold_top.set_subtitle(f"{format_temp(avg_top)}  [{t_str}]")
            if g_bot:
                avg_bot = sum(g_bot) / len(g_bot)
                b_str = "  •  ".join([f"C{i}: {t:.0f}°C" for i, t in zip(range(4, 7), g_bot)])
                self.row_therm_gold_bot.set_subtitle(f"{format_temp(avg_bot)}  [{b_str}]")

            # 3. Gold Prime Core 7 (Super)
            p_top = zones.get("cpu7-top-thermal")
            p_bot = zones.get("cpu7-bottom-thermal")
            if p_top is not None and p_bot is not None:
                p_avg = (p_top + p_bot) / 2.0
                self.row_therm_prime.set_subtitle(f"{format_temp(p_avg)}  [Top: {p_top:.1f}°C  •  Bottom: {p_bot:.1f}°C]")
            elif p_top is not None:
                self.row_therm_prime.set_subtitle(format_temp(p_top))
            else:
                self.row_therm_prime.set_subtitle("Sensors unexposed")

            # 4. Silicon Clusters Average
            c0 = zones.get("cluster0-thermal")
            c1 = zones.get("cluster1-thermal")
            c0_str = f"{c0:.1f} °C" if c0 else "N/A"
            c1_str = f"{c1:.1f} °C" if c1 else "N/A"
            self.row_therm_clusters.set_subtitle(f"Cluster 0 (Little): {c0_str}  •  Cluster 1 (Big): {c1_str}")

            # 5. Compute DSP & Hexagon HVX
            d_comp = zones.get("compute-thermal")
            d_hvx = zones.get("q6-hvx-thermal")
            comp_str = f"{d_comp:.1f} °C" if d_comp else "N/A"
            hvx_str = f"{d_hvx:.1f} °C" if d_hvx else "N/A"
            self.row_therm_compute.set_subtitle(f"Compute DSP: {comp_str}  •  Hexagon HVX: {hvx_str}")

            # 6. Multimedia Thermals
            gpu_t = zones.get("gpu-top-thermal")
            vpu_t = zones.get("video-thermal")
            cam_t = zones.get("camera-thermal")
            gpu_str = f"{gpu_t:.0f}°C" if gpu_t else "N/A"
            self.row_therm_gpu.set_subtitle(format_temp(gpu_t))
            self.row_therm_vpu.set_subtitle(format_temp(vpu_t))
            self.row_therm_cam.set_subtitle(format_temp(cam_t))

            # 7. PMIC & Board Thermals
            pmic_t = zones.get("pm8150-thermal")
            pmic_str = f"{pmic_t:.0f}°C" if pmic_t else "N/A"
            self.row_therm_pmic_main.set_subtitle(format_temp(pmic_t))
            self.row_therm_pmic_chg.set_subtitle(format_temp(zones.get("pm8150b-thermal")))
            self.row_therm_pmic_sec.set_subtitle(format_temp(zones.get("pm8150l-thermal")))
            self.row_therm_mem.set_subtitle(format_temp(zones.get("mem-thermal")))
            self.row_therm_wlan.set_subtitle(format_temp(zones.get("wlan-thermal")))
            self.row_therm_modem.set_subtitle(format_temp(zones.get("modem-thermal")))
            a0 = zones.get("aoss0-thermal")
            a1 = zones.get("aoss1-thermal")
            a0_s = f"{a0:.1f}°C" if a0 else "N/A"
            a1_s = f"{a1:.1f}°C" if a1 else "N/A"
            self.row_therm_aoss.set_subtitle(f"Zone 0: {a0_s}  •  Zone 1: {a1_s}")

            # Subtitle summary on hero card
            self.lbl_sensor_hero_sub.set_label(f"CPU Silver: {avg_s_str} • Gold: {avg_g_str} • GPU: {gpu_str} • PMIC: {pmic_str}")

            # 8. Switch & Position Sensors
            tablet_found = False
            for p in glob.glob('/sys/class/input/input*/name'):
                try:
                    name = open(p).read().strip()
                    if 'tablet mode' in name.lower():
                        self.row_sensor_tablet.set_subtitle(f"Hardware Switch Active ({name})")
                        tablet_found = True
                    elif 'headset' in name.lower() or 'jack' in name.lower():
                        self.row_sensor_jack.set_subtitle(f"Jack Available ({name})")
                except Exception:
                    pass
            if not tablet_found:
                self.row_sensor_tablet.set_subtitle("Tablet Switch: Standard Mode")

            # PMIC ADC Telemetry
            adc_dev = "/sys/bus/iio/devices/iio:device1"
            if os.path.exists(adc_dev):
                try:
                    chg_t = int(open(f"{adc_dev}/in_temp_chg_temp_input").read().strip()) / 10000.0 if os.path.exists(f"{adc_dev}/in_temp_chg_temp_input") else 0.0
                    self.row_sensor_adc.set_subtitle(f"Charger Die Temp: {chg_t:.1f} °C  •  ADC Calibrated")
                except Exception:
                    self.row_sensor_adc.set_subtitle("ADC Channels Online")
            else:
                self.row_sensor_adc.set_subtitle("ADC Hardware Calibrated")

        else:
            # Generic Linux Refresh
            for name, row in getattr(self, 'gen_sensor_rows', {}).items():
                temp_c = zones.get(name)
                row.set_subtitle(format_temp(temp_c))
            self.lbl_sensor_hero_sub.set_label(f"{len(zones)} Thermal Zones Polled Dynamically")

    def refresh_device_stats(self):
        # 1. Root Storage
        try:
            st = os.statvfs('/')
            total_gb = (st.f_blocks * st.f_frsize) / (1024**3)
            free_gb = (st.f_bavail * st.f_frsize) / (1024**3)
            used_gb = total_gb - free_gb
            pct = (used_gb / total_gb) * 100.0
            self.row_disk_usage.set_subtitle(f"{used_gb:.1f} GB used of {total_gb:.1f} GB ({pct:.1f}%) • Free: {free_gb:.1f} GB")
            self.progress_disk.set_fraction(pct / 100.0)

            # Hero Card
            self.lbl_dev_hero_val.set_label(f"{used_gb:.1f} GB")
            self.progress_dev_hero.set_fraction(pct / 100.0)
            self.lbl_dev_hero_sub.set_label(f"Root Storage: {used_gb:.1f} / {total_gb:.1f} GB ({pct:.1f}%) • Free: {free_gb:.1f} GB")
        except Exception:
            self.row_disk_usage.set_subtitle("Storage info unavailable")

        # 2. EFI Partition
        if os.path.exists('/boot/efi'):
            try:
                st_boot = os.statvfs('/boot/efi')
                tot_mb = (st_boot.f_blocks * st_boot.f_frsize) / (1024**2)
                free_mb = (st_boot.f_bavail * st_boot.f_frsize) / (1024**2)
                used_mb = tot_mb - free_mb
                self.row_disk_boot.set_subtitle(f"{used_mb:.1f} MB used of {tot_mb:.1f} MB ({free_mb:.1f} MB free)")
            except Exception:
                self.row_disk_boot.set_subtitle("Active ESP Partition")
        else:
            self.row_disk_boot.set_subtitle("Standard Bootloader")

        # 3. Network
        try:
            rx_bytes = 0
            tx_bytes = 0
            target_if = self.hw['net_iface']
            with open('/proc/net/dev') as f:
                for line in f:
                    if f"{target_if}:" in line:
                        parts = line.split(':')[1].split()
                        rx_bytes = int(parts[0])
                        tx_bytes = int(parts[8])
                        break
            prev_rx, prev_tx = self.last_net_bytes
            rx_speed_kb = (rx_bytes - prev_rx) / 1024.0 if prev_rx > 0 else 0.0
            tx_speed_kb = (tx_bytes - prev_tx) / 1024.0 if prev_tx > 0 else 0.0
            self.last_net_bytes = (rx_bytes, tx_bytes)

            self.row_net_status.set_subtitle(f"Interface: {target_if} (Active Link)")
            self.row_net_speed.set_subtitle(f"↓ {rx_speed_kb:.1f} KB/s  •  ↑ {tx_speed_kb:.1f} KB/s")
            set_badge_text_and_class(self.badge_dev_hero, f"↓ {rx_speed_kb:.0f} KB/s • ↑ {tx_speed_kb:.0f} KB/s", "pill-accent")
        except Exception:
            self.row_net_speed.set_subtitle("Network stats unavailable")

        # 4. Input devices
        touch_devices = []
        kbd_devices = []
        for p in glob.glob('/sys/class/input/input*/name'):
            try:
                name = open(p).read().strip()
                n_low = name.lower()
                if 'touch' in n_low or 'pen' in n_low or 'stylus' in n_low:
                    touch_devices.append(name)
                elif 'keyboard' in n_low or 'mouse' in n_low:
                    kbd_devices.append(name)
            except Exception:
                pass
        
        if touch_devices:
            self.row_dev_touch.set_subtitle(" • ".join(touch_devices))
        else:
            self.row_dev_touch.set_subtitle("Standard HID Pointer")

        if kbd_devices:
            self.row_dev_kbd.set_subtitle(" • ".join(kbd_devices))
        else:
            self.row_dev_kbd.set_subtitle("Standard Keyboard / Dock")

    def refresh_sysinfo_stats(self):
        try:
            with open('/proc/sys/kernel/hostname') as f:
                self.row_hostname.set_subtitle(f.read().strip())
        except Exception:
            pass

        up_str = "0m"
        try:
            with open('/proc/uptime') as f:
                up_sec = float(f.read().split()[0])
            d = int(up_sec // 86400)
            h = int((up_sec % 86400) // 3600)
            m = int((up_sec % 3600) // 60)
            s = int(up_sec % 60)
            up_str = f"{d}d {h}h {m}m {s}s" if d > 0 else f"{h}h {m}m {s}s"
            self.row_uptime_info.set_subtitle(up_str)
        except Exception:
            pass

        l1, l5, l15 = "0.00", "0.00", "0.00"
        try:
            with open('/proc/loadavg') as f:
                l1, l5, l15 = f.read().split()[:3]
            self.row_load_info.set_subtitle(f"{l1} (1 min) • {l5} (5 min) • {l15} (15 min)")
        except Exception:
            pass

        tasks = 0
        try:
            tasks = len(glob.glob('/proc/[0-9]*'))
            self.row_tasks_info.set_subtitle(f"{tasks} active processes")
        except Exception:
            pass

        self.lbl_sys_hero_sub.set_label(f"Uptime: {up_str} • Load: {l1}, {l5}, {l15} • {tasks} Active Processes")


