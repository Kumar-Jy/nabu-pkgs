def get_desktop_environment():
    """Dynamically detects the running desktop environment across all distributions."""
    de = os.environ.get('XDG_CURRENT_DESKTOP') or os.environ.get('DESKTOP_SESSION') or ''
    session_type = os.environ.get('XDG_SESSION_TYPE', 'unknown')

    de_clean = de.strip()
    if not de_clean:
        return f"Linux Desktop ({session_type})"

    de_lower = de_clean.lower()
    if 'kde' in de_lower or 'plasma' in de_lower:
        ver = os.environ.get('KDE_SESSION_VERSION', '')
        prefix = f"KDE Plasma {ver}".strip()
        return f"{prefix} ({session_type})"
    elif 'gnome' in de_lower:
        return f"GNOME ({session_type})"
    elif 'xfce' in de_lower:
        return f"XFCE ({session_type})"
    elif 'cinnamon' in de_lower:
        return f"Cinnamon ({session_type})"
    elif 'mate' in de_lower:
        return f"MATE ({session_type})"
    elif 'lxqt' in de_lower:
        return f"LXQt ({session_type})"
    elif 'hyprland' in de_lower:
        return f"Hyprland ({session_type})"
    elif 'sway' in de_lower:
        return f"Sway ({session_type})"
    return f"{de_clean} ({session_type})"


def detect_system_hardware():
    """Dynamically probes hardware across different SoC and PC architectures."""
    hw = {
        'model': 'Generic Linux Device',
        'is_nabu': False,
        'battery_path': None,
        'charger_path': None,
        'typec_path': None,
        'gpu_devfreq': None,
        'gpu_model': 'DRM Graphics Accelerator',
        'gpu_temp_zone': None,
        'cpu_count': max(os.cpu_count() or 1, 1),
        'net_iface': 'wlan0',
    }

    # 1. Device Tree / DMI Model
    if os.path.exists('/sys/firmware/devicetree/base/model'):
        try:
            with open('/sys/firmware/devicetree/base/model') as f:
                hw['model'] = f.read().strip('\x00\n ')
        except Exception:
            pass
    elif os.path.exists('/sys/class/dmi/id/product_name'):
        try:
            with open('/sys/class/dmi/id/product_name') as f:
                hw['model'] = f.read().strip()
        except Exception:
            pass

    model_low = hw['model'].lower()
    if 'pad 5' in model_low or 'nabu' in model_low or 'sm8150' in model_low:
        hw['is_nabu'] = True
    elif os.path.exists('/sys/firmware/devicetree/base/compatible'):
        try:
            with open('/sys/firmware/devicetree/base/compatible') as f:
                comp = f.read().lower()
                if 'nabu' in comp or 'sm8150' in comp:
                    hw['is_nabu'] = True
        except Exception:
            pass

    # 2. Power Supply detection
    # Batteries
    bats = glob.glob('/sys/class/power_supply/*battery*') + glob.glob('/sys/class/power_supply/BAT*')
    if bats:
        hw['battery_path'] = bats[0]

    # Chargers
    chargers = glob.glob('/sys/class/power_supply/*charger*') + glob.glob('/sys/class/power_supply/AC*') + glob.glob('/sys/class/power_supply/Mains*')
    if chargers:
        hw['charger_path'] = chargers[0]

    # USB Type-C / TCPM
    typec = glob.glob('/sys/class/power_supply/*tcpm*') + glob.glob('/sys/class/power_supply/*typec*')
    if typec:
        hw['typec_path'] = typec[0]

    # 3. GPU Devfreq detection
    gpu_dfs = glob.glob('/sys/class/devfreq/*gpu*') + glob.glob('/sys/class/devfreq/*3d*')
    if gpu_dfs:
        hw['gpu_devfreq'] = gpu_dfs[0]

    # 4. GPU Model detection from DRM / SoC
    if hw['is_nabu']:
        hw['gpu_model'] = 'Qualcomm Adreno 640 • Driver: msm (DRM)'
    else:
        # Check DRM devices
        drm_drivers = set()
        for p in glob.glob('/sys/class/drm/card[0-9]/device/driver'):
            try:
                drm_drivers.add(os.path.basename(os.readlink(p)))
            except Exception:
                pass
        if drm_drivers:
            hw['gpu_model'] = f"DRM GPU ({', '.join(sorted(drm_drivers))})"

    # 5. Network interface detection
    ifaces = []
    if os.path.exists('/proc/net/dev'):
        try:
            with open('/proc/net/dev') as f:
                for line in f:
                    if ':' in line:
                        name = line.split(':')[0].strip()
                        if name != 'lo':
                            ifaces.append(name)
        except Exception:
            pass
    if ifaces:
        hw['net_iface'] = ifaces[0]

    return hw


def format_temp(temp_c):
    """Formats temperature with emoji and descriptive badge."""
    if temp_c is None:
        return "N/A"
    if temp_c < 55.0:
        badge = "🟢"
        desc = "Cool"
    elif temp_c < 70.0:
        badge = "🔵"
        desc = "Normal"
    elif temp_c < 82.0:
        badge = "🟡"
        desc = "Warm"
    else:
        badge = "🔴"
        desc = "Hot"
    return f"{badge} {temp_c:.1f} °C ({desc})"


def build_diagnostic_report(category="all"):
    """Compiles a detailed diagnostic text report for the requested subsystem."""
    hw = detect_system_hardware()
    lines = []
    lines.append("=" * 72)
    lines.append("           SYSTEM & HARDWARE MONITOR - DIAGNOSTIC REPORT")
    lines.append(f"  Generated:  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    lines.append(f"  Developer:  Kumar-Jy (https://github.com/Kumar-Jy)")
    lines.append(f"  Device:     {hw['model']}")
    lines.append(f"  Kernel:     {os.uname().release} ({os.uname().machine})")
    lines.append(f"  Desktop:    {get_desktop_environment()}")
    lines.append(f"  Category:   {category.upper()}")
    lines.append("=" * 72)
    lines.append("")

    # --- GPU SECTION ---
    if category in ("gpu", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"1. GPU STATUS & ENGINE METRICS ({hw['gpu_model']})")
        lines.append("────────────────────────────────────────────────────────────────────────")
        if hw['gpu_devfreq'] and os.path.exists(f"{hw['gpu_devfreq']}/cur_freq"):
            try:
                freq_hz = int(open(f"{hw['gpu_devfreq']}/cur_freq").read().strip())
                lines.append(f"  Clock Frequency:      {freq_hz / 1e6:.1f} MHz")
                gov = open(f"{hw['gpu_devfreq']}/governor").read().strip()
                lines.append(f"  Frequency Governor:   {gov}")
            except Exception:
                pass
        else:
            lines.append("  Clock Frequency:      Hardware Scaling Dynamic")

        # GPU Temp
        for tz in glob.glob('/sys/class/thermal/thermal_zone*'):
            try:
                t = open(f"{tz}/type").read().strip().lower()
                if 'gpu' in t:
                    temp_c = int(open(f"{tz}/temp").read().strip()) / 1000.0
                    lines.append(f"  GPU Core Temp:        {temp_c:.1f} °C ({t})")
                    break
            except Exception:
                pass

        lines.append("")
        lines.append("  [Active DRM GPU Clients (from /proc/<pid>/fdinfo)]")
        clients_found = False
        seen_pids = set()
        for path in glob.glob('/proc/[0-9]*/fdinfo/*'):
            try:
                with open(path) as f:
                    content = f.read()
                if 'drm-driver:' in content:
                    pid = int(path.split('/')[2])
                    if pid in seen_pids:
                        continue
                    seen_pids.add(pid)
                    comm = open(f'/proc/{pid}/comm').read().strip()
                    lines.append(f"    • PID {pid:<7} ({comm})")
                    for cl in content.splitlines():
                        if cl.startswith(('drm-driver:', 'drm-engine-', 'drm-resident-', 'drm-total-')):
                            lines.append(f"        {cl}")
                    clients_found = True
            except Exception:
                pass
        if not clients_found:
            lines.append("    No active DRM GPU processes found in fdinfo.")
        lines.append("")

    # --- CPU SECTION ---
    if category in ("cpu", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"2. CPU FREQUENCY & CORE STATUS ({hw['cpu_count']} Logical Cores)")
        lines.append("────────────────────────────────────────────────────────────────────────")
        for i in range(hw['cpu_count']):
            freq = "Offline"
            gov = "N/A"
            try:
                freq = f"{int(open(f'/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq').read().strip()) / 1000:.0f} MHz"
                gov = open(f'/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_governor').read().strip()
            except Exception:
                pass
            lines.append(f"  Core {i:<2}:  Freq: {freq:<9} Gov: {gov:<10}")
        lines.append("")

    # --- MEMORY SECTION ---
    if category in ("memory", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("3. MEMORY & SWAP SUBSYSTEM")
        lines.append("────────────────────────────────────────────────────────────────────────")
        try:
            with open('/proc/meminfo') as f:
                for l in f:
                    if l.startswith(('MemTotal:', 'MemFree:', 'MemAvailable:', 'Buffers:', 'Cached:', 'SwapTotal:', 'SwapFree:', 'SwapCached:')):
                        lines.append(f"  {l.strip()}")
        except Exception:
            pass
        lines.append("")

    # --- POWER & BATTERY SECTION ---
    if category in ("power", "battery", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("4. BATTERY & CHARGING TELEMETRY")
        lines.append("────────────────────────────────────────────────────────────────────────")
        if hw['battery_path'] and os.path.exists(hw['battery_path']):
            bpath = hw['battery_path']
            try:
                cap = open(f"{bpath}/capacity").read().strip()
                stat = open(f"{bpath}/status").read().strip()
                tech = open(f"{bpath}/technology").read().strip() if os.path.exists(f"{bpath}/technology") else "Li-ion"
                lines.append(f"  Battery Status:       {cap}% ({stat})")
                lines.append(f"  Battery Chemistry:    {tech}")
                
                if os.path.exists(f"{bpath}/voltage_now") and os.path.exists(f"{bpath}/current_now"):
                    v_u = int(open(f"{bpath}/voltage_now").read().strip())
                    c_u = abs(int(open(f"{bpath}/current_now").read().strip()))
                    v_v = v_u / 1e6
                    c_a = c_u / 1e6
                    p_w = v_v * c_a
                    lines.append(f"  Battery Voltage:      {v_v:.3f} V (Raw: {v_u} µV)")
                    lines.append(f"  Current Flow:         {c_a * 1000:.0f} mA ({c_a:.3f} A)")
                    flow_dir = "+" if stat.lower() == "charging" else "-"
                    lines.append(f"  Power Rate:           {flow_dir}{p_w:.2f} W")

                if os.path.exists(f"{bpath}/charge_full_design"):
                    chg_full = int(open(f"{bpath}/charge_full_design").read().strip()) / 1000.0
                    lines.append(f"  Design Capacity:      {chg_full:.0f} mAh")
                if os.path.exists(f"{bpath}/energy_full_design"):
                    energy_full = int(open(f"{bpath}/energy_full_design").read().strip()) / 1e6
                    lines.append(f"  Design Energy:        {energy_full:.2f} Wh")

                if os.path.exists(f"{bpath}/temp"):
                    temp_c = int(open(f"{bpath}/temp").read().strip()) / 10.0
                    lines.append(f"  Battery Cell Temp:    {temp_c:.1f} °C")
            except Exception as e:
                lines.append(f"  Battery Read Error:   {e}")
        else:
            lines.append("  Battery Level:        AC Mains Powered (No battery detected)")

        # Charger Hardware
        if hw['charger_path'] and os.path.exists(hw['charger_path']):
            cpath = hw['charger_path']
            try:
                c_online = open(f"{cpath}/online").read().strip()
                c_stat = open(f"{cpath}/status").read().strip() if os.path.exists(f"{cpath}/status") else "N/A"
                c_type = open(f"{cpath}/type").read().strip() if os.path.exists(f"{cpath}/type") else "N/A"
                usb_type = open(f"{cpath}/usb_type").read().strip() if os.path.exists(f"{cpath}/usb_type") else "Standard"
                lines.append("")
                lines.append("  [Charger Controller]")
                lines.append(f"    • Controller Device:  {os.path.basename(cpath)}")
                lines.append(f"    • Plugged In (Online):{'Yes' if c_online == '1' else 'No (Running on Battery)'}")
                lines.append(f"    • Charging Status:    {c_stat}")
                lines.append(f"    • Hardware Type:      {c_type}")
                lines.append(f"    • USB Protocol:       {usb_type}")
            except Exception as e:
                lines.append(f"    • Charger Error:      {e}")

        # Type-C / TCPM
        if hw['typec_path'] and os.path.exists(hw['typec_path']):
            tpath = hw['typec_path']
            try:
                t_online = open(f"{tpath}/online").read().strip()
                t_usb_type = open(f"{tpath}/usb_type").read().strip() if os.path.exists(f"{tpath}/usb_type") else "N/A"
                lines.append("")
                lines.append("  [USB Type-C / TCPM]")
                lines.append(f"    • Port Controller:    {os.path.basename(tpath)}")
                lines.append(f"    • Connection Online:  {t_online}")
                lines.append(f"    • Supported Modes:    {t_usb_type}")
            except Exception:
                pass
        lines.append("")

    # --- SENSORS & THERMALS SECTION ---
    if category in ("sensors", "thermals", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("5. HARDWARE SENSORS & THERMAL ZONES")
        lines.append("────────────────────────────────────────────────────────────────────────")
        zones = {}
        for tz in sorted(glob.glob('/sys/class/thermal/thermal_zone*'), key=lambda x: int(os.path.basename(x).replace('thermal_zone', '') or 0)):
            try:
                t = open(f"{tz}/type").read().strip()
                temp_c = int(open(f"{tz}/temp").read().strip()) / 1000.0
                zones[t] = temp_c
            except Exception:
                pass

        if hw['is_nabu']:
            # Grouped cleanly for Snapdragon 855/860
            groups = [
                ("CPU Cores & Clusters", [
                    'cpu0-thermal', 'cpu1-thermal', 'cpu2-thermal', 'cpu3-thermal',
                    'cpu4-top-thermal', 'cpu4-bottom-thermal', 'cpu5-top-thermal', 'cpu5-bottom-thermal',
                    'cpu6-top-thermal', 'cpu6-bottom-thermal', 'cpu7-top-thermal', 'cpu7-bottom-thermal',
                    'cluster0-thermal', 'cluster1-thermal', 'compute-thermal', 'q6-hvx-thermal'
                ]),
                ("Graphics & Multimedia", [
                    'gpu-top-thermal', 'video-thermal', 'camera-thermal'
                ]),
                ("PMIC Power & System Sensors", [
                    'pm8150-thermal', 'pm8150b-thermal', 'pm8150l-thermal', 'qcom-battery',
                    'mem-thermal', 'wlan-thermal', 'modem-thermal', 'aoss0-thermal', 'aoss1-thermal'
                ])
            ]
            for grp_title, keys in groups:
                lines.append(f"  [{grp_title}]")
                for k in keys:
                    if k in zones:
                        lines.append(f"    • {k:<24}: {zones[k]:.1f} °C")
                lines.append("")
        else:
            for name, temp_c in zones.items():
                lines.append(f"    • {name:<24}: {temp_c:.1f} °C")
            lines.append("")

        # Input & switch sensors
        lines.append("  [Hardware State Switches]")
        tablet_switch = False
        for p in glob.glob('/sys/class/input/input*/name'):
            try:
                name = open(p).read().strip()
                if 'tablet mode' in name.lower():
                    lines.append(f"    • Tablet Mode Switch:   Available ({name})")
                    tablet_switch = True
                elif 'headset' in name.lower() or 'jack' in name.lower():
                    lines.append(f"    • Audio Jack Sensor:    Available ({name})")
            except Exception:
                pass
        if not tablet_switch:
            lines.append("    • Hardware Switches:    Standard Chassis")
        lines.append("")

    # --- DEVICE & STORAGE SECTION ---
    if category in ("device", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("6. STORAGE & NETWORK TELEMETRY")
        lines.append("────────────────────────────────────────────────────────────────────────")
        try:
            st = os.statvfs('/')
            tot_gb = (st.f_blocks * st.f_frsize) / (1024**3)
            free_gb = (st.f_bavail * st.f_frsize) / (1024**3)
            used_gb = tot_gb - free_gb
            lines.append(f"  Root Storage (/):     {used_gb:.1f} GB used / {tot_gb:.1f} GB total ({free_gb:.1f} GB free)")
        except Exception:
            pass

        # Network interface
        try:
            target_if = hw['net_iface']
            lines.append(f"  Network Interface:    {target_if}")
        except Exception:
            pass
        lines.append("")

    # --- SYSTEM INFO SECTION ---
    if category in ("sysinfo", "all"):
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append("7. FIRMWARE, OS & KERNEL INFORMATION")
        lines.append("────────────────────────────────────────────────────────────────────────")
        lines.append(f"  Hardware Model:       {hw['model']}")
        try:
            with open('/etc/os-release') as f:
                for l in f:
                    if l.startswith('PRETTY_NAME='):
                        lines.append(f"  Distribution:         {l.split('=', 1)[1].strip().strip('\"')}")
        except Exception:
            pass
        lines.append(f"  Desktop Environment:  {get_desktop_environment()}")
        lines.append(f"  Linux Kernel:         {os.uname().release}")
        lines.append(f"  Architecture:         {os.uname().machine}")
        try:
            with open('/proc/uptime') as f:
                up_sec = float(f.read().split()[0])
            d = int(up_sec // 86400)
            h = int((up_sec % 86400) // 3600)
            m = int((up_sec % 3600) // 60)
            lines.append(f"  System Uptime:        {d}d {h}h {m}m")
        except Exception:
            pass
        lines.append("")

    lines.append("=" * 72)
    lines.append("                         END OF REPORT")
    lines.append("=" * 72)
    return "\n".join(lines)



