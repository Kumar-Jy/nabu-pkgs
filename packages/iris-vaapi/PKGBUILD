# Maintainer: Kumar-Jy
# VA-API driver for the Qualcomm SM8150 Iris1 decoder (Xiaomi Pad 5)

pkgname=iris-vaapi
pkgver=0.1.0
pkgrel=3
pkgdesc="VA-API driver for the Qualcomm SM8150 Iris1 decoder"
arch=('aarch64')
url="https://github.com/CFM880/iris-vaapi"
license=('GPL2')
depends=('libva' 'libdrm')
makedepends=('gcc' 'make' 'pkg-config' 'vulkan-headers' 'libva' 'libdrm')
source=("iris-vaapi-${pkgver}.tar.gz::https://github.com/CFM880/iris-vaapi/archive/refs/heads/main.tar.gz"
        '0001-iris-vaapi-autodetect-iris-decoder.patch'
        '99-iris-dmaheap.rules'
        '99-iris-vaapi.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "$srcdir/iris-vaapi-main"
  # The iris decoder does not always land on /dev/video0: qcom-camss VFE may
  # claim video0 first (as on nabu with cameras probed).  Auto-detect the
  # "Iris Decoder" node instead of hardcoding the old path.
  patch -p0 < "$srcdir/0001-iris-vaapi-autodetect-iris-decoder.patch"
}

build() {
  cd "$srcdir/iris-vaapi-main"
  make DRIVERDIR=/usr/lib/dri
}

package() {
  cd "$srcdir/iris-vaapi-main"
  make install DESTDIR="$pkgdir" DRIVERDIR=/usr/lib/dri

  # Chrome needs DMA-heap surfaces; default root-only breaks EGL import.
  install -Dm644 "$srcdir/99-iris-dmaheap.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-iris-dmaheap.rules"

  # Cacheable CAPTURE buffers keep 4K60 decode fast enough for Chrome.
  install -Dm644 "$srcdir/99-iris-vaapi.conf" \
    "$pkgdir/usr/lib/modprobe.d/99-iris-vaapi.conf"

  # libva locates the driver from the DRM device's driver name (msm_dpu lead),
  # so make the iris driver reachable WITHOUT LIBVA_DRIVER_NAME=iris.  Chrome's
  # zygote/sandbox env propagation is unreliable; auto-detection must work.
  ln -s /usr/lib/dri/iris_drv_video.so \
    "$pkgdir/usr/lib/dri/msm_drm_drv_video.so"
}