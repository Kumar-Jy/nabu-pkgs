+/* Resolve the stateful M2M iris decoder node.  When @dev is given it is
+ * used verbatim; otherwise /dev/video* is scanned for the node whose Card
+ * reports "Iris Decoder", so the driver never binds the camera (VFE) or the
+ * encoder node when termination order pushes iris off video0.  Returns a
+ * static buffer or falls back to the historical "/dev/video0". */
+static const char *v4l2_dec_resolve_dev(const char *dev)
+{
+	static char node[16];
+	struct v4l2_capability cap;
+	int i, fd;
+
+	if (dev)
+		return dev;
+
+	for (i = 0; i < 64; i++) {
+		snprintf(node, sizeof(node), "/dev/video%d", i);
+		fd = open(node, O_RDWR | O_NONBLOCK);
+		if (fd < 0)
+			continue;
+		if (xioctl(fd, VIDIOC_QUERYCAP, &cap) == 0 &&
+		    strstr((char *)cap.card, "Iris Decoder")) {
+			close(fd);
+			return node;
+		}
+		close(fd);
+	}
+
+	return "/dev/video0";
+}
