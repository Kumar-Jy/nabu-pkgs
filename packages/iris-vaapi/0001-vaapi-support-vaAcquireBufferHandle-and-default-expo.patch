+}
+
+static VAStatus
+vpu_vaAcquireBufferHandle(VADriverContextP ctx, VABufferID buf_id,
+			  VABufferInfo *buf_info)
+{
+	struct vpu_drv_data *dd = ctx->pDriverData;
+	int i;
+
+	if (!dd || !buf_info)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+
+	for (i = 0; i < dd->derived_n; i++) {
+		if (dd->derived_ids[i] == buf_id) {
+			VASurfaceID surf = dd->derived_surfs[i];
+			int fd = -1;
+			unsigned int pitch, size, w, h, fourcc;
+
+			if (vpu_surfaces_export(dd->surfs, surf, &fd, &pitch, &size,
+						&w, &h, &fourcc))
+				return VA_STATUS_ERROR_INVALID_SURFACE;
+
+			if (dd->derived_fds[i] >= 0)
+				close(dd->derived_fds[i]);
+			dd->derived_fds[i] = fd;
+
+			buf_info->handle = (uintptr_t)fd;
+			buf_info->type = VAImageBufferType;
+			buf_info->mem_type = VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME;
+			buf_info->mem_size = size;
+			return VA_STATUS_SUCCESS;
+		}
+	}
+	return VA_STATUS_ERROR_INVALID_BUFFER;
+}
+
+static VAStatus
+vpu_vaReleaseBufferHandle(VADriverContextP ctx, VABufferID buf_id)
+{
+	struct vpu_drv_data *dd = ctx->pDriverData;
+	int i;
+
+	if (!dd)
+		return VA_STATUS_ERROR_INVALID_PARAMETER;
+
+	for (i = 0; i < dd->derived_n; i++) {
+		if (dd->derived_ids[i] == buf_id) {
+			if (dd->derived_fds[i] >= 0) {
+				close(dd->derived_fds[i]);
+				dd->derived_fds[i] = -1;
+			}
+			return VA_STATUS_SUCCESS;
+		}
+	}
+	return VA_STATUS_SUCCESS;
 }
 
