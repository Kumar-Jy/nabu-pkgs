+			void *mem;
+			unsigned int pitch, bsize, w, h, fourcc;
+			if (vpu_surfaces_buffer(dd->surfs, surf, &mem, &pitch, &bsize, &w, &h, &fourcc))
+				return VA_STATUS_ERROR_INVALID_SURFACE;
+			if (type)
+				*type = VAImageBufferType;
+			if (size)
