#!/bin/sh
set -eu

# mpv launcher for the IRIS-patched FFmpeg tree installed by ffmpeg-iris.
# Mirrors packages/mpv-iris on the Arch branch, minus the upstream author's
# hard-coded $HOME fallback.

ffmpeg_lib_dir="/usr/lib/iris-ffmpeg/lib"

if [ ! -r "${ffmpeg_lib_dir}/libavcodec.so.62" ]; then
    echo "Missing patched FFmpeg libraries in ${ffmpeg_lib_dir} (install ffmpeg-iris)" >&2
    exit 1
fi

if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    export LD_LIBRARY_PATH="${ffmpeg_lib_dir}:${LD_LIBRARY_PATH}"
else
    export LD_LIBRARY_PATH="${ffmpeg_lib_dir}"
fi

exec /usr/bin/mpv \
    --hwdec=v4l2m2m \
    --no-config \
    --hwdec-codecs=h264,hevc,vp9 \
    --vo=dmabuf-wayland \
    "$@"
