# Maintainer: Kumar-Jy <https://github.com/Kumar-Jy>
# mpv companion launcher for IRIS-patched FFmpeg (P010 10-bit DRM-Prime decode).
# Uses the SAME LD_LIBRARY_PATH trick as the upstream iris mpv wrapper:
# libs from ffmpeg-iris's PRIVATE tree are NOT loaded by the locker/other apps;
# this launcher points ONLY this mpv invocation at them + forces the hwdec profile.

pkgname=mpv-iris
pkgver=8.0.1
pkgrel=1
pkgdesc="mpv launcher wired to the IRIS-patched FFmpeg P010 DRM-Prime hardware-decode path (nabu)"
arch=('aarch64')
url="https://github.com/PCM880/iris-ffmpeg"
license=('GPL-2.0-or-later')
depends=('ffmpeg-iris' 'mpv')
source=('mpv-iris')
sha256sums=('557787900e9c9387908e3dbcdfd11b14dc5e8b06202189aa6e31c98ee89ec409')

package() {
  install -Dm755 "$srcdir/mpv-iris" "$pkgdir/usr/bin/mpv-iris"
}
