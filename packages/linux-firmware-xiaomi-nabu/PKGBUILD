# Maintainer: Kumar-Jy
# Qualcomm/DSP firmware blobs for Xiaomi Pad 5 (nabu).
#
# The blobs are proprietary binaries extracted from the device and have no
# redistribution terms upstream. Source archive is hosted on the upstream
# release.

pkgname=linux-firmware-xiaomi-nabu
pkgver=25.04.26
pkgrel=3
pkgdesc="Qualcomm/DSP firmware for Xiaomi Pad 5 (nabu)"
arch=('any')
url="https://github.com/linux-msm/linux-firmware-msm"
license=('custom:proprietary')
changelog=ChangeLog
install=linux-firmware-xiaomi-nabu.install
depends=('linux-firmware-whence' 'linux-firmware-atheros')
source=("fw-src.pkg.tar.xz::https://github.com/rodriguezst/arch-repo/releases/download/aarch64/$pkgname-$pkgver-1-any.pkg.tar.xz"
        "ChangeLog"
        "$pkgname.install")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
  cp -a "$srcdir/usr" "$pkgdir/"
  install -Dm644 "$srcdir/ChangeLog" "$pkgdir/usr/share/doc/$pkgname/ChangeLog"
}
