def KEY(label, code, shift_label=None, force=False, span=4):
    return dict(
        t="char", label=label, code=code,
        shift_label=shift_label, force=force, span=span, repeat=True
    )


def SPECIAL(label, action, code=None, span=4, repeat=False, style_class="kmod"):
    return dict(
        t="special", label=label, action=action,
        code=code, span=span, repeat=repeat, style_class=style_class
    )


def COMBO(label, codes, span=4, style_class="kmod"):
    return dict(
        t="combo", label=label, codes=codes,
        action="combo", span=span, repeat=False, style_class=style_class
    )


def L(char):
    return KEY(char, getattr(E, "KEY_" + char), span=4)


