    # -- Layer Building -----------------------------------------------------

    def build_layer(self, name):
        self.layer = name
        if name == "main":
            self.rows = MAIN_ROWS
        elif name == "sym":
            self.rows = SYM_ROWS
        else:
            self.rows = FN_ROWS

        # Update bar tabs active state
        for tab, active in ((self.tab_abc, name == "main"),
                            (self.tab_123, name == "sym"),
                            (self.tab_fn, name == "fn")):
            sc = tab.get_style_context()
            if active:
                sc.add_class("active")
            else:
                sc.remove_class("active")

        # Clear existing grid
        for child in self.grid_box.get_children():
            self.grid_box.remove(child)

        self.buttons = []
        grid = Gtk.Grid()
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)
        col_spacing = 1 if getattr(self, "is_portrait", False) else 2
        row_spacing = 1 if getattr(self, "is_portrait", False) else 2
        grid.set_column_spacing(col_spacing)
        grid.set_row_spacing(row_spacing)

        for r_idx, r in enumerate(self.rows):
            col_pos = 0
            for k in r:
                span = k.get("span", 4)
                btn = self._make_button(k)
                grid.attach(btn, col_pos, r_idx, span, 1)
                col_pos += span

        self.grid_box.pack_start(grid, True, True, 0)
        self.grid_box.show_all()
        self.refresh_mods()
        self.layout_on_screen()

    def _make_button(self, k):
        b = Gtk.Button()
        b.set_can_focus(False)
        b.set_focus_on_click(False)
        sc = b.get_style_context()
        sc.add_class("kbtn")
        sc.add_class("okey")  # For backward-compatibility with existing styles & tests
        if k.get("t") == "char":
            sc.add_class("kchar")
        if "style_class" in k:
            sc.add_class(k["style_class"])

        b._okey = k
        b._pressed = False
        b._rep1 = None
        b._rep2 = None
        b.connect("button-press-event", self._press)
        b.connect("button-release-event", self._release)
        self.buttons.append(b)
        return b

    def _press(self, btn, _ev):
        btn._pressed = True
        self.activate(btn._okey)
        if btn._okey.get("repeat"):
            btn._rep1 = GLib.timeout_add(450, self._begin_repeat, btn)
        return False

    def _begin_repeat(self, btn):
        if btn._pressed:
            btn._rep2 = GLib.timeout_add(70, self._auto_repeat, btn)
        return False

    def _auto_repeat(self, btn):
        if not btn._pressed:
            return False
        self.activate(btn._okey, repeat=True)
        return True

    def _release(self, btn, _ev):
        btn._pressed = False
        for attr in ("_rep1", "_rep2"):
            tid = getattr(btn, attr)
            if tid:
                GLib.source_remove(tid)
                setattr(btn, attr, None)
        return False

    # -- Geometry & Positioning ---------------------------------------------

    def get_screen_geometry(self):
        display = Gdk.Display.get_default()
        if display:
            monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
            if monitor:
                try:
                    work = monitor.get_workarea()
                    if work.width > 0 and work.height > 0:
                        return work.x, work.y, work.width, work.height
                except Exception:
                    pass
                try:
                    geom = monitor.get_geometry()
                    if geom.width > 0 and geom.height > 0:
                        return geom.x, geom.y, geom.width, geom.height
                except Exception:
                    pass
        scr = Gdk.Screen.get_default()
        try:
            return 0, 0, scr.get_width(), scr.get_height()
        except Exception:
            return 0, 0, 1920, 1080

    def _setup_screen_listeners(self):
        scr = Gdk.Screen.get_default()
        scr.connect("size-changed", self._on_screen_changed)
        scr.connect("monitors-changed", self._on_screen_changed)

        display = scr.get_display()
        display.connect("monitor-added", self._on_screen_changed)
        display.connect("monitor-removed", self._on_screen_changed)

        self._bind_monitors()

    def _bind_monitors(self):
        display = Gdk.Display.get_default()
        if not display:
            return
        try:
            n = display.get_n_monitors()
            for i in range(n):
                mon = display.get_monitor(i)
                if mon and mon not in self._connected_monitors:
                    mon.connect("notify::geometry", self._on_screen_changed)
                    mon.connect("notify::workarea", self._on_screen_changed)
                    mon.connect("notify::scale-factor", self._on_screen_changed)
                    self._connected_monitors.add(mon)
        except Exception:
            pass

    def _on_screen_changed(self, *args):
        self._bind_monitors()
        GLib.idle_add(self.layout_on_screen)

    def _check_orientation_tick(self):
        _x, _y, sw, sh = self.get_screen_geometry()
        if (sw, sh) != self._current_screen_dims and sw > 0 and sh > 0:
            self.layout_on_screen()
        return True

    def _update_bar_for_orientation(self, is_portrait):
        # Keep S, M, L, A-, A+ buttons always visible in both portrait and landscape
        for btn in (getattr(self, "btn_s", None),
                    getattr(self, "btn_m", None),
                    getattr(self, "btn_l", None),
                    getattr(self, "btn_zoom_out", None),
                    getattr(self, "btn_zoom_in", None)):
            if btn:
                btn.set_no_show_all(False)
                btn.show()

        if is_portrait:
            if hasattr(self, "bar_title"):
                self.bar_title.set_text("\u2328")
                self.bar_title.set_tooltip_text("On-Screen Keyboard")
            if hasattr(self, "drag_label"):
                self.drag_label.set_text("\u283f\u283f Drag to Move \u283f\u283f")
            if hasattr(self, "btn_auto"):
                self.btn_auto.set_label("\u26a1")
                self.btn_auto.set_tooltip_text(
                    "Auto-Popup: ON (tap to toggle)" if self.auto_popup else "Auto-Popup: OFF (tap to toggle)"
                )
            if hasattr(self, "btn_theme"):
                self.btn_theme.set_label(f"\U0001f3a8 {self.theme.capitalize()}")
                self.btn_theme.set_tooltip_text(f"Theme: {self.theme.capitalize()} (tap to switch)")
        else:
            if hasattr(self, "bar_title"):
                self.bar_title.set_text("\u2328 Keyboard")
                self.bar_title.set_tooltip_text("")
            if hasattr(self, "drag_label"):
                self.drag_label.set_text("\u283f\u283f Drag to Move \u283f\u283f")
            if hasattr(self, "btn_auto"):
                self.btn_auto.set_label("\u26a1 Auto: ON" if self.auto_popup else "\u26a1 Auto: OFF")
                self.btn_auto.set_tooltip_text("Toggle Auto-Popup on text field focus")
            if hasattr(self, "btn_theme"):
                self.btn_theme.set_label(f"\U0001f3a8 {self.theme.capitalize()}")
                self.btn_theme.set_tooltip_text("Switch Theme (Click to cycle, right-click for menu)")

        self._update_dock_btn_label()
        self._update_width_preset_buttons()

    def layout_on_screen(self):
        base_x, base_y, screen_w, screen_h = self.get_screen_geometry()
        self._current_screen_dims = (screen_w, screen_h)
        is_portrait = screen_w < screen_h
        self.is_portrait = is_portrait
        rows = len(self.rows)

        # 1. Update Header Bar for Orientation
        self._update_bar_for_orientation(is_portrait)

        # 2. Key height and font size
        if is_portrait:
            target_h = int(screen_h * 0.28 * self.scale)
            topbar_h = 30
            key_h = max(36, min(58, int((target_h - topbar_h) / rows)))
            font_px = max(11, min(15, int(key_h * 0.26 * self.scale)))
            char_font_px = max(17, min(24, int(key_h * 0.40 * self.scale)))
            arrow_font = max(18, min(25, int(key_h * 0.42 * self.scale)))

            if self.width_preset == "full":
                target_w = screen_w
            elif self.width_preset == "compact":
                target_w = max(690, int(screen_w * 0.80))
            else:  # medium
                target_w = max(690, int(screen_w * 0.90))
        else:
            base_h = int(screen_h * 0.32)
            total_h = int(base_h * self.scale)
            topbar_h = 36
            key_h = max(38, int((total_h - topbar_h) / rows))
            font_px = max(13, min(17, int(key_h * 0.28 * self.scale)))
            char_font_px = max(18, min(26, int(key_h * 0.42 * self.scale)))
            arrow_font = max(20, min(28, int(key_h * 0.45 * self.scale)))

            if self.width_preset == "full":
                target_w = screen_w
            elif self.width_preset == "compact":
                target_w = min(screen_w, max(1100, int(screen_w * 0.65)))
            else:  # medium
                target_w = min(screen_w, max(1300, int(screen_w * 0.82)))

        total_h = topbar_h + rows * key_h + 14

        # 3. Apply key and bar styles
        self._apply_key_style(int(key_h * 0.90), font_px, char_font_px, arrow_font, is_portrait)
        self.refresh_mods()

        # Let GTK calculate preferred size with updated styles
        try:
            req_min, _ = self.win.get_preferred_size()
            if req_min.height > total_h:
                total_h = req_min.height
            if req_min.width > target_w:
                target_w = req_min.width
        except Exception:
            pass

        target_w = min(target_w, screen_w)

        if self.dock_mode == "dock":
            # In dock mode, dock cleanly to bottom
            x = base_x + int((screen_w - target_w) / 2)
            y = base_y + screen_h - total_h
        else:
            default_x = base_x + int((screen_w - target_w) / 2)
            default_y = max(base_y + 40, base_y + screen_h - total_h - 120)
            fx = self.config.get("float_x", -1)
            fy = self.config.get("float_y", -1)
            if fx < 0 or fy <= 0 or fy > screen_h - 60:
                x = default_x
                y = default_y
            else:
                x = fx
                y = fy
            target_w = min(screen_w, self.config.get("float_w", target_w))
            total_h = min(int(screen_h * 0.85), self.config.get("float_h", total_h))

        # Clamp strictly within visible bounds
        x = max(base_x, min(x, base_x + screen_w - target_w))
        y = max(base_y, min(y, base_y + screen_h - 60))

        self.win.resize(target_w, total_h)
        self.win.move(x, y)

        self.kb_left = x
        self.kb_top = y
        self.kb_width = target_w
        self.kb_height = total_h

    def _apply_key_style(self, min_h, font_px, char_font_px=None, arrow_font=None, is_portrait=False):
        if char_font_px is None:
            char_font_px = max(12, int(font_px * 1.3))
        if arrow_font is None:
            arrow_font = max(14, int(font_px * 1.4))
        if is_portrait:
            btn_padding = "0px 1px"
            btn_margin = "1px"
            min_w = "4px"
            bar_padding = "2px 3px"
            bar_btn_padding = "1px 4px"
            bar_btn_min_h = "22px"
            bar_btn_font = "11px"
        else:
            btn_padding = "0"
            btn_margin = "1px"
            min_w = "14px"
            bar_padding = "3px 6px"
            bar_btn_padding = "2px 9px"
            bar_btn_min_h = "26px"
            bar_btn_font = "12px"

        css_text = (
            f".oskb-bar {{ padding: {bar_padding}; }}\n"
            f".bar-btn, .bar-btn label {{ font-size: {bar_btn_font}; padding: {bar_btn_padding}; min-height: {bar_btn_min_h}; }}\n"
            f".drag-handle {{ font-size: {bar_btn_font}; padding: 1px 6px; }}\n"
            f"button.kbtn, button.kbtn label {{ min-height: {min_h}px; font-size: {font_px}px; min-width: {min_w}; padding: {btn_padding}; margin: {btn_margin}; font-weight: 700; }}\n"
            f"button.kchar, button.kchar label {{ font-size: {char_font_px}px; font-weight: 700; }}\n"
            f"button.karrow, button.karrow label {{ font-size: {arrow_font}px; font-weight: 900; }}\n"
        )
        self.key_style_provider.load_from_data(css_text.encode())

    def _on_configure(self, widget, event):
        if not getattr(self, "_resizing", False) and not getattr(self, "_dragging", False):
            if event.x > 0 or event.y > 0:
                self.kb_left = event.x
                self.kb_top = event.y
            self.kb_width = event.width
            self.kb_height = event.height
            if self.dock_mode == "float" and (event.x > 0 or event.y > 0):
                self.config["float_x"] = event.x
                self.config["float_y"] = event.y
                save_config(self.config)
        return False

    # -- Drag & Resize Handlers ---------------------------------------------

    def _on_drag_press(self, widget, event):
        btn = getattr(event, "button", 1)
        if btn == 1 or btn == 0:
            display = Gdk.Display.get_default()
            backend = display.get_name() if hasattr(display, "get_name") else ""
            if "wayland" in backend.lower() and hasattr(self.win, "begin_move_drag"):
                if self.dock_mode == "dock":
                    self.dock_mode = "float"
                    self.config["dock_mode"] = "float"
                    self._update_dock_btn_label()
                time = getattr(event, "time", 0)
                x_root = int(getattr(event, "x_root", 0))
                y_root = int(getattr(event, "y_root", 0))
                self.win.begin_move_drag(btn if btn != 0 else 1, x_root, y_root, time)
                return True

            self._dragging = True
            self._drag_start_x = getattr(event, "x_root", 0)
            self._drag_start_y = getattr(event, "y_root", 0)
            self._drag_start_win_x = self.kb_left
            self._drag_start_win_y = self.kb_top
        return True

    def _on_drag_motion(self, widget, event):
        if getattr(self, "_dragging", False):
            cur_x = getattr(event, "x_root", self._drag_start_x)
            cur_y = getattr(event, "y_root", self._drag_start_y)
            dx = int(cur_x - self._drag_start_x)
            dy = int(cur_y - self._drag_start_y)
            new_x = self._drag_start_win_x + dx
            new_y = self._drag_start_win_y + dy
            base_x, base_y, screen_w, screen_h = self.get_screen_geometry()
            new_x = max(base_x, min(new_x, base_x + screen_w - self.kb_width))
            new_y = max(base_y, min(new_y, base_y + screen_h - 60))
            self.win.move(new_x, new_y)
            self.kb_left = new_x
            self.kb_top = new_y
            if self.dock_mode == "dock" and (abs(dy) > 15 or abs(dx) > 15):
                self.dock_mode = "float"
                self.config["dock_mode"] = "float"
                self._update_dock_btn_label()
        return True

    def _on_drag_release(self, widget, event):
        btn = getattr(event, "button", 1)
        if (btn == 1 or btn == 0) and getattr(self, "_dragging", False):
            self._dragging = False
            if self.dock_mode == "float":
                self.config["float_x"] = self.kb_left
                self.config["float_y"] = self.kb_top
                save_config(self.config)
        return True

    def _make_corner_button(self, corner, cursor_name, symbol):
        box = Gtk.EventBox()
        box.set_visible_window(True)
        box.set_can_focus(False)
        box.get_style_context().add_class("corner-grip-box")
        lbl = Gtk.Label(label=symbol)
        lbl.get_style_context().add_class("corner-grip")
        lbl.get_style_context().add_class(f"corner-grip-{corner}")
        box.add(lbl)
        box.connect("button-press-event", lambda w, ev, c=corner: self._on_edge_press(w, ev, c))
        box.connect("motion-notify-event", self._on_edge_motion)
        box.connect("button-release-event", self._on_edge_release)
        box.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.TOUCH_MASK
        )
        box.connect("realize", lambda b, cname=cursor_name: self._set_widget_cursor(b, cname))
        return box

    def _make_edge_handle(self, edge, cursor_name, width=-1, height=-1):
        box = Gtk.EventBox()
        box.set_visible_window(True)
        box.set_can_focus(False)
        box.get_style_context().add_class("resize-edge")
        box.get_style_context().add_class(f"resize-edge-{edge}")
        if width > 0 or height > 0:
            box.set_size_request(width, height)
        box.connect("button-press-event", lambda w, ev, ed=edge: self._on_edge_press(w, ev, ed))
        box.connect("motion-notify-event", self._on_edge_motion)
        box.connect("button-release-event", self._on_edge_release)
        box.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.TOUCH_MASK
        )
        box.connect("realize", lambda b, cname=cursor_name: self._set_widget_cursor(b, cname))
        return box

    def _set_widget_cursor(self, widget, cursor_name):
        try:
            gdk_win = widget.get_window()
            if gdk_win:
                display = Gdk.Display.get_default()
                cursor = Gdk.Cursor.new_from_name(display, cursor_name)
                if cursor:
                    gdk_win.set_cursor(cursor)
        except Exception:
            pass

    def _on_resize_press(self, widget, event):
        return self._on_edge_press(widget, event, "top_right")

    def _on_resize_motion(self, widget, event):
        return self._on_edge_motion(widget, event)

    def _on_resize_release(self, widget, event):
        return self._on_edge_release(widget, event)

    def _on_edge_press(self, widget, event, edge):
        btn = getattr(event, "button", 1)
        if btn == 1:
            self._resizing = True
            self._resize_edge = edge
            self._resize_start_x = getattr(event, "x_root", 0)
            self._resize_start_y = getattr(event, "y_root", 0)
            self._resize_start_w = self.kb_width
            self._resize_start_h = self.kb_height
            self._resize_start_win_x = self.kb_left
            self._resize_start_win_y = self.kb_top
        return True

    def _on_edge_motion(self, widget, event):
        if not self._resizing:
            return True

        dx = int(getattr(event, "x_root", self._resize_start_x) - self._resize_start_x)
        dy = int(getattr(event, "y_root", self._resize_start_y) - self._resize_start_y)
        edge = getattr(self, "_resize_edge", "top")

        scr = Gdk.Screen.get_default()
        display = scr.get_display()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        try:
            work = monitor.get_workarea()
            screen_w, screen_h = work.width, work.height
            base_x, base_y = work.x, work.y
        except Exception:
            screen_w, screen_h = scr.get_width(), scr.get_height()
            base_x, base_y = 0, 0

        min_w = 650
        max_w = screen_w
        min_h = 220
        max_h = int(screen_h * 0.80)

        new_w = self._resize_start_w
        new_h = self._resize_start_h
        new_x = self._resize_start_win_x
        new_y = self._resize_start_win_y

        # Height adjustment (Top edge: dragging up increases height)
        if edge in ("top", "top_left", "top_right"):
            new_h = max(min_h, min(max_h, self._resize_start_h - dy))
            if self.dock_mode == "dock":
                new_y = base_y + screen_h - new_h
            else:
                new_y = self._resize_start_win_y + (self._resize_start_h - new_h)

        elif edge in ("bottom", "bottom_left", "bottom_right"):
            new_h = max(min_h, min(max_h, self._resize_start_h + dy))

        # Width adjustment
        if edge in ("right", "top_right", "bottom_right"):
            if self.dock_mode == "dock":
                new_w = max(min_w, min(max_w, self._resize_start_w + 2 * dx))
                new_x = base_x + int((screen_w - new_w) / 2)
            else:
                new_w = max(min_w, min(max_w, self._resize_start_w + dx))

        elif edge in ("left", "top_left", "bottom_left"):
            if self.dock_mode == "dock":
                new_w = max(min_w, min(max_w, self._resize_start_w - 2 * dx))
                new_x = base_x + int((screen_w - new_w) / 2)
            else:
                new_w = max(min_w, min(max_w, self._resize_start_w - dx))
                new_x = self._resize_start_win_x + (self._resize_start_w - new_w)

        if self.dock_mode == "dock":
            new_x = base_x + int((screen_w - new_w) / 2)
            new_y = base_y + screen_h - new_h
        else:
            new_x = max(base_x, min(new_x, base_x + screen_w - 200))
            new_y = max(base_y, min(new_y, base_y + screen_h - 100))

        self.win.resize(new_w, new_h)
        self.win.move(new_x, new_y)
        self.kb_width = new_w
        self.kb_height = new_h
        self.kb_left = new_x
        self.kb_top = new_y

        # Dynamically recalculate key button heights and font sizes live!
        rows = len(self.rows)
        key_h = max(34, int((new_h - 48) / rows))
        if screen_w < screen_h:
            font_px = max(10, min(13, int((new_w / 68.0) * 0.90)))
            char_font_px = max(12, min(16, int(font_px * 1.25)))
            arrow_font = max(13, min(18, int(font_px * 1.35)))
            self._apply_key_style(int(key_h * 0.90), font_px, char_font_px, arrow_font, is_portrait=True)
        else:
            font_px = max(13, min(20, int(key_h * 0.32)))
            char_font_px = max(18, min(26, int(key_h * 0.42 * self.scale)))
            arrow_font = max(20, min(28, int(key_h * 0.45 * self.scale)))
            self._apply_key_style(int(key_h * 0.90), font_px, char_font_px, arrow_font, is_portrait=False)

        return True

    def _on_edge_release(self, widget, event):
        btn = getattr(event, "button", 1)
        if btn == 1 and self._resizing:
            self._resizing = False
            self.config["float_w"] = self.kb_width
            self.config["float_h"] = self.kb_height
            self.config["float_x"] = self.kb_left
            self.config["float_y"] = self.kb_top
            save_config(self.config)
        return True

    # -- Header Bar Actions -------------------------------------------------

    def _toggle_dock(self):
        base_x, base_y, screen_w, screen_h = self.get_screen_geometry()
        target_w = self.kb_width
        total_h = self.kb_height
        dock_x = base_x + int((screen_w - target_w) / 2)
        dock_y = base_y + screen_h - total_h

        if self.dock_mode == "dock":
            self.dock_mode = "float"
            cur_float_y = self.config.get("float_y", dock_y)
            if abs(cur_float_y - dock_y) < 30:
                lift_y = max(base_y + 40, dock_y - 120)
                self.config["float_y"] = lift_y
                self.config["float_x"] = dock_x
        else:
            self.dock_mode = "dock"

        self.config["dock_mode"] = self.dock_mode
        save_config(self.config)
        self._update_dock_btn_label()
        self.layout_on_screen()

    def _update_dock_btn_label(self):
        if hasattr(self, "win"):
            w_sc = self.win.get_style_context()
            if self.dock_mode == "dock":
                w_sc.remove_class("floating")
            else:
                w_sc.add_class("floating")
        if hasattr(self, "btn_dock"):
            sc = self.btn_dock.get_style_context()
            if self.dock_mode == "dock":
                self.btn_dock.set_label("\u2b12 Dock")
                self.btn_dock.set_tooltip_text("Mode: Docked to bottom (tap to float and move)")
                sc.remove_class("active")
            else:
                self.btn_dock.set_label("\u2b13 Float")
                self.btn_dock.set_tooltip_text("Mode: Floating (tap to dock to bottom)")
                sc.add_class("active")

    def _cycle_theme(self):
        cur_idx = THEME_NAMES.index(self.theme) if self.theme in THEME_NAMES else 0
        next_theme = THEME_NAMES[(cur_idx + 1) % len(THEME_NAMES)]
        self.set_theme(next_theme)

    def _show_theme_menu(self, widget):
        menu = Gtk.Menu()
        icons = {
            "dark": "\U0001f319 Dark (High Contrast)",
            "light": "\u2600\ufe0f Light (Clean Paper)",
            "oled": "\U0001f30c OLED (Neon Cyber)",
            "breeze": "\U0001f30a Breeze (KDE Native)",
            "amber": "\u26a1 Amber (Retro Terminal)",
            "glass": "\U0001f48e Glass (80% Dark Glass)",
            "crystal": "\U0001f52e Crystal (90% Transparent)",
            "frost": "\u2744\ufe0f Frost (80% Light Glass)",
        }
        for tname in THEME_NAMES:
            lbl = icons.get(tname, tname.capitalize())
            if tname == self.theme:
                lbl += "  \u2713"
            item = Gtk.MenuItem(label=lbl)
            item.connect("activate", lambda _, tn=tname: self.set_theme(tn))
            menu.append(item)
        menu.show_all()
        menu.popup_at_widget(widget, Gdk.Gravity.SOUTH, Gdk.Gravity.NORTH, None)

    def _on_theme_btn_press(self, widget, event):
        if event.button == 3:
            self._show_theme_menu(widget)
            return True
        return False

    def set_theme(self, name):
        if name not in THEMES:
            name = "dark"
        self.theme = name
        self.config["theme"] = name
        save_config(self.config)
        self.theme_provider.load_from_data(get_theme_css(name))
        if hasattr(self, "btn_theme"):
            self.btn_theme.set_label(f"\U0001f3a8 {name.capitalize()}")

    def _set_width_preset(self, preset):
        self.width_preset = preset
        self.config["width_preset"] = preset
        save_config(self.config)
        self._update_width_preset_buttons()
        self.layout_on_screen()

    def _update_width_preset_buttons(self):
        for btn, preset in ((getattr(self, "btn_s", None), "compact"),
                            (getattr(self, "btn_m", None), "medium"),
                            (getattr(self, "btn_l", None), "full")):
            if btn:
                sc = btn.get_style_context()
                if self.width_preset == preset:
                    sc.add_class("active")
                else:
                    sc.remove_class("active")

    def _adjust_scale(self, delta):
        self.scale = max(0.65, min(1.6, round(self.scale + delta, 2)))
        self.config["scale"] = self.scale
        save_config(self.config)
        self.layout_on_screen()

    def _toggle_auto_popup(self):
        self._set_auto_popup(not self.auto_popup)

    def _set_auto_popup(self, enable):
        self.auto_popup = bool(enable)
        self.config["auto_popup"] = self.auto_popup
        save_config(self.config)
        self._update_auto_btn_style()
        if not self.auto_popup:
            self._cancel_auto_hide()

    def _update_auto_btn_style(self):
        sc = self.btn_auto.get_style_context()
        is_portrait = getattr(self, "is_portrait", False)
        if self.auto_popup:
            self.btn_auto.set_label("\u26a1" if is_portrait else "\u26a1 Auto: ON")
            self.btn_auto.set_tooltip_text(
                "Auto-Popup: ON (tap to toggle)" if is_portrait else "Toggle Auto-Popup on text field focus"
            )
            sc.add_class("auto-on")
            sc.remove_class("auto-off")
        else:
            self.btn_auto.set_label("\u26a1" if is_portrait else "\u26a1 Auto: OFF")
            self.btn_auto.set_tooltip_text(
                "Auto-Popup: OFF (tap to toggle)" if is_portrait else "Toggle Auto-Popup on text field focus"
            )
            sc.add_class("auto-off")
            sc.remove_class("auto-on")

    # -- Minimization & Floating Pill ---------------------------------------

    def minimize_to_pill(self, manual=False):
        if manual:
            self._manual_dismiss_time = time.monotonic()
        self._cancel_auto_hide()
        self.win.hide()
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor_at_point(0, 0)
        geom = monitor.get_geometry()
        w_px, h_px = geom.width, geom.height
        pill_x = self.config.get("pill_x", -1)
        pill_y = self.config.get("pill_y", -1)
        if pill_x < 0 or pill_y < 0 or pill_x >= w_px or pill_y >= h_px:
            pill_x = max(10, w_px - 85)
            pill_y = max(10, h_px - 80)
        self.pill.move(pill_x, pill_y)
        self.pill.show_all()

    def hide_keyboard(self, manual=False):
        if manual:
            self._manual_dismiss_time = time.monotonic()
            self._closed_manually = True
        self._cancel_auto_hide()
        self.win.hide()
        self.pill.hide()

    def _on_delete_event(self, _widget, _event):
        self.hide_keyboard(manual=True)
        return True

    def show_keyboard(self):
        self._closed_manually = False
        self._cancel_auto_hide()
        self.pill.hide()
        self.win.show_all()
        self.win.present()
        self.layout_on_screen()

    def _on_pill_click(self, _widget, event):
        if event.button == 1:
            self.show_keyboard()
        return True

    # -- KDE Virtual Keyboard Setting & Auto-Popup Policy -------------------

    def _is_kde_virtual_keyboard_active(self):
        """Check whether virtual keyboard is enabled and configured for oskb in KDE settings."""
        try:
            desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
            if "kde" not in desktop and not os.path.exists("/usr/bin/kwin_wayland"):
                return True

            kwinrc_path = os.path.expanduser("~/.config/kwinrc")
            if not os.path.exists(kwinrc_path):
                return True

            mtime = os.path.getmtime(kwinrc_path)
            if self._cached_kwinrc_mtime == mtime:
                return self._cached_kde_vk_active

            cp = configparser.ConfigParser()
            cp.read(kwinrc_path)

            # 1. VirtualKeyboardMode: 0 = Never/Off, 1 = TouchOnly, 2 = On
            mode = cp.getint("Wayland", "VirtualKeyboardMode", fallback=1)
            if mode == 0:
                self._cached_kwinrc_mtime = mtime
                self._cached_kde_vk_active = False
                return False

            # 2. InputMethod: path to .desktop file or name
            # If user selects 'None' in KDE settings, InputMethod is empty.
            # If user selects 'On-Screen Keyboard', InputMethod contains 'oskb'.
            im = cp.get("Wayland", "InputMethod", fallback="").strip().lower()
            if not im or "oskb" not in im:
                self._cached_kwinrc_mtime = mtime
                self._cached_kde_vk_active = False
                return False

            self._cached_kwinrc_mtime = mtime
            self._cached_kde_vk_active = True
            return True
        except Exception:
            return True

    def _is_auto_popup_allowed(self):
        """Return True only if auto-popup is active, user has not closed via X, and KDE settings permit."""
        if not self.auto_popup:
            return False
        if self._closed_manually:
            return False
        if not self._is_kde_virtual_keyboard_active():
            return False
        return True

    # -- Auto-Popup Focus Detection (AT-SPI & KWin D-Bus) -------------------

    def _ensure_accessibility_enabled(self):
        """Ensure system-wide accessibility is active so toolkits emit AT-SPI events."""
        try:
            settings = Gio.Settings.new("org.gnome.desktop.interface")
            if not settings.get_boolean("toolkit-accessibility"):
                settings.set_boolean("toolkit-accessibility", True)
        except Exception:
            pass

        try:
            if not self.session_bus:
                self.session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            self.session_bus.call_sync(
                "org.a11y.Bus",
                "/org/a11y/bus",
                "org.freedesktop.DBus.Properties",
                "Set",
                GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True))),
                None,
                Gio.DBusCallFlags.NONE,
                300,
                None,
            )
        except Exception:
            pass

    def _init_atspi(self):
        self._ensure_accessibility_enabled()
        try:
            Atspi.init()
            self.atspi_listener = Atspi.EventListener.new(self._on_atspi_focus)
            self.atspi_listener.register("object:state-changed:focused")

            self.atspi_caret_listener = Atspi.EventListener.new(self._on_atspi_caret)
            self.atspi_caret_listener.register("object:text-caret-moved")
            self.atspi_caret_listener.register("object:text-selection-changed")
        except Exception as e:
            print("Atspi initialization skipped: %s" % e, file=sys.stderr)
            GLib.timeout_add_seconds(3, self._retry_atspi)

    def _retry_atspi(self):
        if self.atspi_listener is None:
            self._init_atspi()
        return False

    def _init_kwin_dbus(self):
        try:
            if not self.session_bus:
                self.session_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            self.session_bus.signal_subscribe(
                "org.kde.KWin",
                "org.kde.kwin.VirtualKeyboard",
                None,
                "/VirtualKeyboard",
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_kwin_vk_signal,
                None,
            )
            self.session_bus.signal_subscribe(
                "org.kde.KWin",
                "org.freedesktop.DBus.Properties",
                "PropertiesChanged",
                "/VirtualKeyboard",
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_kwin_properties_changed,
                None,
            )
        except Exception as e:
            print("KWin D-Bus initialization skipped: %s" % e, file=sys.stderr)

    def _on_kwin_vk_signal(self, _conn, _sender, _path, _iface, signal_name, _params, _user_data):
        if signal_name == "activeChanged":
            self._check_kwin_active()

    def _on_kwin_properties_changed(self, _conn, _sender, _path, _iface, _signal, params, _user_data):
        try:
            unpacked = params.unpack()
            if len(unpacked) >= 2 and isinstance(unpacked[1], dict):
                changed = unpacked[1]
                if "active" in changed:
                    new_active = bool(changed["active"])
                    if new_active != self._kwin_active:
                        self._kwin_active = new_active
                        if new_active:
                            self._cancel_auto_hide()
                            if self._is_auto_popup_allowed() and not self.win.get_visible():
                                if time.monotonic() - self._manual_dismiss_time >= 0.5:
                                    GLib.idle_add(self.show_keyboard)
                        else:
                            if self.win.get_visible():
                                self._schedule_auto_hide()
        except Exception:
            pass

    def _check_kwin_active(self):
        if not self.session_bus or not self._is_auto_popup_allowed():
            return
        try:
            val = self.session_bus.call_sync(
                "org.kde.KWin",
                "/VirtualKeyboard",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.kde.kwin.VirtualKeyboard", "active")),
                GLib.VariantType("(v)"),
                Gio.DBusCallFlags.NONE,
                200,
                None,
            )
            if val:
                new_active = bool(val.unpack()[0])
                if new_active != self._kwin_active:
                    self._kwin_active = new_active
                    if new_active:
                        self._cancel_auto_hide()
                        if not self.win.get_visible():
                            if time.monotonic() - self._manual_dismiss_time >= 0.5:
                                GLib.idle_add(self.show_keyboard)
                    else:
                        if self.win.get_visible():
                            self._schedule_auto_hide()
        except Exception:
            pass

    def _schedule_auto_hide(self):
        self._cancel_auto_hide()
        self._hide_timer_id = GLib.timeout_add(350, self._auto_hide_timeout)

    def _cancel_auto_hide(self):
        if self._hide_timer_id is not None:
            GLib.source_remove(self._hide_timer_id)
            self._hide_timer_id = None

    def _auto_hide_timeout(self):
        self._hide_timer_id = None
        if self.win.get_visible():
            self.minimize_to_pill(manual=False)
        return False

    def _is_text_input(self, source):
        if not source:
            return False
        try:
            states = source.get_state_set()
            if states.contains(Atspi.StateType.EDITABLE):
                return True

            role = (source.get_role_name() or "").lower()
            if not role:
                return False

            if "terminal" in role:
                return True

            if role in ("entry", "password text", "search box", "editbar"):
                return True

            if ("text" in role or "document" in role) and not states.contains(Atspi.StateType.READ_ONLY):
                if role not in ("label", "heading", "page tab", "status bar", "menu item", "push button"):
                    return True
        except Exception:
            pass
        return False

    def _on_atspi_focus(self, event):
        if not self._is_auto_popup_allowed():
            return

        try:
            source = event.source
            if not source:
                return

            # Don't trigger for our own keyboard or pill window
            if source.get_process_id() == os.getpid():
                return

            if event.detail1 == 0:
                # Focus lost from an element
                if self.win.get_visible():
                    self._schedule_auto_hide()
                return

            # Focus gained (detail1 == 1)
            if self._is_text_input(source):
                self._cancel_auto_hide()
                if time.monotonic() - self._manual_dismiss_time < 0.5:
                    return
                self.last_focused_element = source
                if not self.win.get_visible():
                    GLib.idle_add(self.show_keyboard)
            else:
                # Focus shifted to a non-text widget (e.g. button, list item)
                if self.win.get_visible():
                    self._schedule_auto_hide()
        except Exception:
            pass

    def _on_atspi_caret(self, event):
        if not self._is_auto_popup_allowed():
            return

        try:
            source = event.source
            if not source:
                return

            if source.get_process_id() == os.getpid():
                return

            states = source.get_state_set()
            if not states.contains(Atspi.StateType.FOCUSED):
                return

            if not self._is_text_input(source):
                return

            # Active focused text input: cancel auto-hide
            self._cancel_auto_hide()

            # If already visible, user is typing or navigating caret
            if self.win.get_visible():
                return

            # If user manually dismissed within last 0.5s, don't reopen immediately
            if time.monotonic() - self._manual_dismiss_time < 0.5:
                return

            self.last_focused_element = source
            GLib.idle_add(self.show_keyboard)
        except Exception:
            pass

    # -- Key Press Handling -------------------------------------------------

    def activate(self, k, repeat=False):
        t = k["t"]
        if t == "char":
            self._type_char(k)
            return

        action = k.get("action")
        if action == "combo":
            self.inj.combo(k["codes"])
            return

        # Basic Keys
        if action == "bs":
            self.inj.tap_code(E.KEY_BACKSPACE)
        elif action == "delete":
            self.inj.tap_code(E.KEY_DELETE)
        elif action == "enter":
            self.inj.tap_code(E.KEY_ENTER)
        elif action == "esc":
            self.inj.tap_code(E.KEY_ESC)
        elif action == "tab":
            self.inj.tap_code(E.KEY_TAB)
        elif action == "space":
            self.inj.tap_code(E.KEY_SPACE)
        # Navigation
        elif action == "left":
            self.inj.tap_code(E.KEY_LEFT)
        elif action == "right":
            self.inj.tap_code(E.KEY_RIGHT)
        elif action == "up":
            self.inj.tap_code(E.KEY_UP)
        elif action == "down":
            self.inj.tap_code(E.KEY_DOWN)
        elif action == "home":
            self.inj.tap_code(E.KEY_HOME)
        elif action == "end":
            self.inj.tap_code(E.KEY_END)
        elif action == "pgup":
            self.inj.tap_code(E.KEY_PAGEUP)
        elif action == "pgdn":
            self.inj.tap_code(E.KEY_PAGEDOWN)
        elif action == "ins":
            self.inj.tap_code(E.KEY_INSERT)
        # Modifiers
        elif action == "shift":
            self.shift = (self.shift + 1) % 3
            self.refresh_mods()
        elif action == "caps":
            self.caps = not self.caps
            self.refresh_mods()
        elif action == "sticky-ctrl":
            self._toggle_sticky("sticky-ctrl", _MOD_CTRL)
        elif action == "sticky-alt":
            self._toggle_sticky("sticky-alt", _MOD_ALT)
        elif action == "sticky-super":
            self._toggle_sticky("sticky-super", _MOD_SUPER)
        elif action == "super":
            self.inj.tap_code(E.KEY_LEFTMETA)
        # Function Keys
        elif action and action.startswith("f") and action[1:].isdigit():
            fn_code = getattr(E, "KEY_F" + action[1:])
            self.inj.tap_code(fn_code)
        elif action == "prtsc":
            self.inj.tap_code(E.KEY_PRINT)
        # Layer switching
        elif action == "layer-main" or action == "back":
            self.build_layer("main")
        elif action == "layer-sym" or action == "layer":
            self.build_layer("sym")
        elif action == "layer-fn":
            self.build_layer("fn")

    def _toggle_sticky(self, name, code):
        active = self.inj.sticky[name] is None
        self.inj.set_sticky(name, code, active)
        self.refresh_mods()

    def _shift_active(self):
        return self.shift in (1, 2)

    def _type_char(self, k):
        shift = False
        if k.get("force"):
            shift = True
        elif k.get("shift_label") and self._shift_active():
            shift = True
        elif k["label"].isalpha() and (self._shift_active() or self.caps):
            shift = True

        self.inj.tap_key(
            k["code"], shift=shift,
            mods=[c for c in self.inj.sticky.values() if c]
        )

        # One-shot shift auto-release
        if self.shift == 1:
            self.shift = 0
            self.refresh_mods()

    # -- Label & State Rendering --------------------------------------------

    def refresh_mods(self):
        for b in self.buttons:
            k = b._okey
            sc = b.get_style_context()
            sc.remove_class("active")

            if k["t"] == "char":
                if self._shift_active() and k.get("shift_label") is not None:
                    label = k["shift_label"]
                elif len(k["label"]) == 1 and k["label"].isalpha():
                    if self._shift_active() or self.caps:
                        label = k["label"].upper()
                    else:
                        label = k["label"].lower()
                else:
                    label = k["label"]
                b.set_label(label)
            else:
                label = k["label"]
                if getattr(self, "is_portrait", False):
                    if label == "Enter \u21b5":
                        label = "Enter"
                    elif label == "Tab \u21e5":
                        label = "Tab"
                    elif label == "PrtSc":
                        label = "Prt"
                    elif label == "Zoom +":
                        label = "Z+"
                    elif label == "Zoom -":
                        label = "Z-"
                    elif label == "Ctrl+Home":
                        label = "C-Home"
                    elif label == "Ctrl+End":
                        label = "C-End"
                    elif label == "Ctrl+Tab":
                        label = "C-Tab"
                    elif label == "Ctrl+Bksp":
                        label = "C-Bksp"
                    elif label == "Alt+F4":
                        label = "A-F4"
                action = k.get("action")
                if action == "shift":
                    if self.shift == 1:
                        label = "\u21e7 \u00b7"
                        sc.add_class("active")
                    elif self.shift == 2:
                        label = "\u21ea Lock"
                        sc.add_class("active")
                elif action in ("sticky-ctrl", "sticky-alt", "sticky-super"):
                    if self.inj.sticky.get(action):
                        sc.add_class("active")
                elif action == "caps" and self.caps:
                    sc.add_class("active")
                b.set_label(label)

    def _init_ipc(self):
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
            self.server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.server_sock.bind(SOCK_PATH)
            self.server_sock.listen(5)
            self.server_sock.setblocking(False)
            GLib.io_add_watch(self.server_sock.fileno(), GLib.IO_IN, self._on_ipc_connection)
        except Exception as e:
            print("IPC server skipped: %s" % e, file=sys.stderr)

    def _on_ipc_connection(self, fd, condition):
        try:
            conn, _ = self.server_sock.accept()
            data = conn.recv(1024).decode().strip()
            if data == "status":
                resp = f"keyboard_visible={self.win.get_visible()} pill_visible={self.pill.get_visible()} auto_popup={self.auto_popup} closed_manually={self._closed_manually} kde_vk_active={self._is_kde_virtual_keyboard_active()} theme={self.theme}\n"
                conn.sendall(resp.encode())
                conn.close()
                return True
            conn.close()
            if data in ("show", ""):
                self.show_keyboard()
            elif data == "toggle":
                if self.win.get_visible():
                    self.minimize_to_pill(manual=True)
                else:
                    self.show_keyboard()
            elif data == "hide":
                self.minimize_to_pill(manual=True)
            elif data == "close":
                self.hide_keyboard(manual=True)
            elif data.startswith("theme:"):
                self.set_theme(data.split(":", 1)[1])
            elif data == "theme":
                self._cycle_theme()
            elif data == "auto":
                self._toggle_auto_popup()
            elif data == "auto:on":
                self._set_auto_popup(True)
            elif data == "auto:off":
                self._set_auto_popup(False)
            elif data == "quit":
                self._destroy()
        except Exception:
            pass
        return True

    def _destroy(self, _w=None):
        self._cancel_auto_hide()
        try:
            self.inj.ui.close()
        except Exception:
            pass
        try:
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except Exception:
            pass
        Gtk.main_quit()


def main():
    cmd = "show"
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("--toggle", "-t"):
            cmd = "toggle"
        elif arg in ("--hide",):
            cmd = "hide"
        elif arg in ("--close", "-c"):
            cmd = "close"
        elif arg in ("--show", "-s"):
            cmd = "show"
        elif arg in ("--theme", "-m"):
            if len(sys.argv) > 2:
                cmd = f"theme:{sys.argv[2]}"
            else:
                cmd = "theme"
        elif arg in ("--auto", "-a"):
            if len(sys.argv) > 2:
                cmd = f"auto:{sys.argv[2]}"
            else:
                cmd = "auto"
        elif arg in ("--status",):
            cmd = "status"
        elif arg in ("--quit", "-q"):
            cmd = "quit"
        elif arg in ("--help", "-help", "-h"):
            print("Usage: oskb [OPTIONS]")
            print("Options:")
            print("  --show, -s          Show on-screen keyboard (default)")
            print("  --toggle, -t        Toggle keyboard visibility")
            print("  --hide              Minimize keyboard to floating pill")
            print("  --close, -c         Hide keyboard and pill completely")
            print("  --auto, -a [on|off] Toggle or set auto-popup on text focus")
            print("  --status            Query status of running instance")
            print("  --theme, -m [NAME]  Switch theme (dark, light, oled, breeze, amber, glass, crystal, frost)")
            print("  --quit, -q          Quit keyboard instance")
            sys.exit(0)

    # If instance already running, send command via IPC and exit
    if send_ipc(cmd):
        sys.exit(0)

    # Start new instance
    try:
        app = KeyboardApp()
        app._init_ipc()
        if cmd == "hide":
            app.minimize_to_pill()
        elif cmd == "close":
            app.hide_keyboard()
        else:
            app.show_keyboard()
    except Exception as e:
        print("Failed to start keyboard: %s" % e, file=sys.stderr)
        sys.exit(1)
    Gtk.main()


if __name__ == "__main__":
    main()