class Injector:
    def __init__(self):
        self.ui = UInput(
            {0x01: _ALL_CODES},  # EV_KEY
            name="On-Screen Keyboard",
            bustype=0x03,  # BUS_USB
            vendor=0x1234,
            product=0x5678,
            version=1,
        )
        self.sticky = {}  # action name -> evdev code while latched

    def _down(self, code):
        self.ui.write(E.EV_KEY, code, 1)
        self.ui.syn()

    def _up(self, code):
        self.ui.write(E.EV_KEY, code, 0)
        self.ui.syn()

    def tap_key(self, code, shift=False, mods=()):
        down = []
        if shift:
            down.append(_MOD_SHIFT)
        for m in mods:
            if m and m not in down:
                down.append(m)
        for c in down:
            self._down(c)
        self._down(code)
        self._up(code)
        for c in reversed(down):
            self._up(c)

    def tap_code(self, code):
        self.tap_key(code, mods=[c for c in self.sticky.values() if c])

    def combo(self, codes):
        for c in codes:
            self._down(c)
        for c in reversed(codes):
            self._up(c)

    def set_sticky(self, action, code, active):
        self.sticky[action] = code if active else None


