def get_theme_css(theme_name):
    t = dict(THEMES.get(theme_name, THEMES["dark"]))
    t.setdefault("text_shadow", "none")
    return (THEME_CSS_TEMPLATE % t).encode()

BASE_CSS = get_theme_css("dark")


# ---------------------------------------------------------------------------
# Main Keyboard Application
# ---------------------------------------------------------------------------

class KeyboardApp:
    def __init__(self):
        self.config = load_config()
        self.inj = Injector()

        self.layer = "main"
        self.buttons = []
        self.shift = 0  # 0=off, 1=temp, 2=locked
        self.caps = False
        self.dock_mode = self.config.get("dock_mode", "dock")
        self.scale = float(self.config.get("scale", 1.0))
        self.width_preset = self.config.get("width_preset", "medium")
        self.auto_popup = bool(self.config.get("auto_popup", True))
        self.theme = self.config.get("theme", "dark")
        if self.theme not in THEMES:
            self.theme = "dark"

        self.is_portrait = False
        self._connected_monitors = set()
        self._current_screen_dims = (0, 0)

        self.kb_top = 0
        self.kb_height = 0
        self._manual_dismiss_time = 0.0
        self._closed_manually = False
        self._cached_kwinrc_mtime = None
        self._cached_kde_vk_active = True
        self.last_focused_element = None
        self._hide_timer_id = None
        self.session_bus = None
        self._kwin_active = False
        self.atspi_listener = None
        self.atspi_caret_listener = None
        self.atspi_win_listener = None

        # Drag & Resize tracking
        self._dragging = False
        self._drag_start_x = 0
        self._drag_start_y = 0
        self._drag_start_win_x = 0
        self._drag_start_win_y = 0

        self._resizing = False
        self._resize_start_x = 0
        self._resize_start_y = 0
        self._resize_start_w = 0
        self._resize_start_h = 0

        # Init sticky states
        for a in ("sticky-ctrl", "sticky-alt", "sticky-super"):
            self.inj.set_sticky(a, None, False)

        # Apply Global Theme CSS
        self.theme_provider = Gtk.CssProvider()
        self.theme_provider.load_from_data(get_theme_css(self.theme))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.theme_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Dynamic Key & Bar Style Provider
        self.key_style_provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.key_style_provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

        self._build_window()
        self._build_pill()
        self._init_kwin_dbus()
        self._init_atspi()
        self._setup_screen_listeners()
        GLib.timeout_add(1000, self._check_orientation_tick)

    # -- UI Building --------------------------------------------------------

    def _build_window(self):
        w = Gtk.Window()
        w.set_title("On-Screen Keyboard")
        w.set_role("oskb")
        w.set_name("oskb-window")
        w.get_style_context().add_class("oskb-window")
        if self.dock_mode == "float":
            w.get_style_context().add_class("floating")
        w.set_decorated(False)
        w.set_resizable(True)
        w.set_accept_focus(False)
        w.set_focus_on_map(False)
        w.set_can_focus(False)
        w.set_keep_above(True)
        w.set_skip_taskbar_hint(True)
        w.set_skip_pager_hint(True)
        w.set_type_hint(Gdk.WindowTypeHint.NORMAL)
        screen = w.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            w.set_visual(visual)
        w.connect("delete-event", self._on_delete_event)
