SOCK_PATH = f"/run/user/{os.getuid()}/oskb.sock"

def send_ipc(cmd):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK_PATH)
        s.sendall((cmd + "\n").encode())
        if cmd == "status":
            resp = s.recv(1024).decode()
            print(resp, end="")
        s.close()
        return True
    except Exception:
        return False

