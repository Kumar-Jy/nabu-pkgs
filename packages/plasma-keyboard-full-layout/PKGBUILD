# Maintainer: local user
#
# Add-on package for Plasma Keyboard that installs
#   * full-size, two-page layouts for en_US and 30 other locales (including
#     Thai and two Hindi layouts) under /usr/local/share, and
#   * a patched Plasma Keyboard binary that can send real modifier chords
#     (Ctrl+V, Ctrl+Shift+V, Ctrl+C, ...) to the focused application.
#
# Plasma Keyboard uses the first existing
#   <GenericDataLocation>/plasma/keyboard/layouts
# directory and GenericDataLocation is
#   ~/.local/share:/usr/local/share:/usr/share
# so the layouts override the stock /usr/share layout without touching any
# package-owned file. The stock plasma-keyboard package is not replaced; the
# patched binary is installed as plasma-keyboard-nabu and selected through
# its own desktop file.

pkgname=plasma-keyboard-full-layout
pkgver=1.3.0
pkgrel=3
pkgdesc='Full-size two-page Plasma Keyboard layouts with working modifier chords'
arch=('aarch64')
url='https://invent.kde.org/plasma/plasma-keyboard'
license=('GPL-3.0-only')
depends=('plasma-keyboard' 'qt6-virtualkeyboard')
makedepends=('cmake' 'extra-cmake-modules' 'ninja' 'gettext'
             'qt6-base' 'qt6-declarative' 'qt6-virtualkeyboard'
             'kcoreaddons' 'ki18n' 'kconfig' 'kcrash' 'kcmutils' 'libplasma'
             'libxkbcommon' 'wayland' 'wayland-protocols' 'pkgconf')
install=plasma-keyboard-full-layout.install

_pkver=6.8.2
_pkdir=plasma-keyboard-v$_pkver

source=('main.qml'
        'FullKey.qml'
        'fr_FR.qml'
        'de_DE.qml'
        'es_ES.qml'
        'it_IT.qml'
        'pt_BR.qml'
        'nl_NL.qml'
        'sv_SE.qml'
        'da_DK.qml'
        'fi_FI.qml'
        'pl_PL.qml'
        'cs_CZ.qml'
        'el_GR.qml'
        'hu_HU.qml'
        'tr_TR.qml'
        'ru_RU.qml'
        'uk_UA.qml'
        'hi_IN.qml'
        'hi_IN_inscript.qml'
        'th_TH.qml'
        'en_GB.qml'
        'eo.qml'
        'et_EE.qml'
        'hr_HR.qml'
        'id_ID.qml'
        'ms_MY.qml'
        'nb_NO.qml'
        'sq_AL.qml'
        'bg_BG.qml'
        'es_MX.qml'
        'pt_PT.qml'
        'plasma-keyboard-chords.patch'
        'org.kde.plasma.keyboard.nabu.desktop'
        "plasma-keyboard-$_pkver.tar.gz::https://invent.kde.org/plasma/plasma-keyboard/-/archive/v$_pkver/plasma-keyboard-v$_pkver.tar.gz")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
