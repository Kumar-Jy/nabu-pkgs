prepare() {
    cd "$srcdir/$_pkdir"
    patch -Np1 -i "$srcdir/plasma-keyboard-chords.patch"
}

build() {
    cd "$srcdir/$_pkdir"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    local layoutdir="$pkgdir/usr/local/share/plasma/keyboard/layouts"
    local d name locale

    install -d "$layoutdir/en_US"

    # Install the full-size language layouts (real directories first, so the
    # stock-symlink loop below cannot write through them).
    for locale in fr_FR de_DE es_ES it_IT pt_BR nl_NL sv_SE da_DK fi_FI pl_PL \
                  cs_CZ el_GR hu_HU tr_TR ru_RU uk_UA th_TH \
                  en_GB eo et_EE hr_HR id_ID ms_MY nb_NO sq_AL bg_BG es_MX pt_PT \
                  hi_IN hi_IN_inscript; do
        install -d "$layoutdir/$locale"
        install -m644 "$srcdir/$locale.qml" "$layoutdir/$locale/main.qml"
        install -m644 "$srcdir/FullKey.qml" "$layoutdir/$locale/FullKey.qml"
        for m in dialpad digits handwriting main numbers symbols; do
            install -m644 /dev/null "$layoutdir/$locale/$m.fallback"
        done
    done

    # Link every stock layout so only the overridden ones are replaced.
    for d in /usr/share/plasma/keyboard/layouts/*; do
        if [ ! -d "$d" ]; then
            continue
        fi
        name="$(basename "$d")"
        if [ "$name" = "en_US" ]; then
            continue
        fi
        case " fr_FR de_DE es_ES it_IT pt_BR nl_NL sv_SE da_DK fi_FI pl_PL cs_CZ el_GR hu_HU tr_TR ru_RU uk_UA th_TH en_GB eo et_EE hr_HR id_ID ms_MY nb_NO sq_AL bg_BG es_MX pt_PT hi_IN hi_IN_inscript " in
            *" $name "*)
                continue
                ;;
        esac
        ln -s "$d" "$layoutdir/$name"
    done

    install -m644 "$srcdir/main.qml" "$srcdir/FullKey.qml" "$layoutdir/en_US/"

    for d in /usr/share/plasma/keyboard/layouts/en_US/*.fallback; do
        install -m644 /dev/null "$layoutdir/en_US/$(basename "$d")"
    done

    # Patched binary and its launcher. The stock plasma-keyboard package stays
    # installed and untouched; KWin selects this desktop file through the
    # InputMethod setting.
    install -Dm755 "$srcdir/$_pkdir/build/bin/plasma-keyboard" \
        "$pkgdir/usr/local/bin/plasma-keyboard-nabu"
    install -Dm644 "$srcdir/org.kde.plasma.keyboard.nabu.desktop" \
        "$pkgdir/usr/local/share/applications/org.kde.plasma.keyboard.nabu.desktop"
}
