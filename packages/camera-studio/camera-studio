        row_del.add_suffix(btn_del)
        action_group.add(row_del)
        info_page.add(action_group)

        right_scroll.set_child(info_page)
        paned.set_end_child(right_scroll)

        toolbar_view.set_content(paned)

    def load_current_photo(self):
        if not self.photo_list:
            self.close()
            return

        path = self.photo_list[self.cur_idx]
        self.lbl_title.set_label(f"Photo {self.cur_idx + 1} of {len(self.photo_list)}")
        self.btn_prev.set_sensitive(self.cur_idx > 0)
        self.btn_next.set_sensitive(self.cur_idx < len(self.photo_list) - 1)

        try:
            self.pic_preview.set_filename(path)

            pb = GdkPixbuf.Pixbuf.new_from_file(path)
            w, h = pb.get_width(), pb.get_height()
            mp = (w * h) / 1000000.0
            size_kb = os.path.getsize(path) / 1024.0
            mtime = datetime.fromtimestamp(os.path.getmtime(path)).strftime('%Y-%m-%d %H:%M:%S')

            self.row_file.set_subtitle(os.path.basename(path))
            self.row_res.set_subtitle(f"{w} × {h} ({mp:.1f} MP)")
            self.row_size.set_subtitle(f"{size_kb:.1f} KB" if size_kb < 1024 else f"{size_kb/1024:.2f} MB")
            self.row_date.set_subtitle(mtime)
        except Exception as e:
            print("Failed to load photo:", e)

    def on_preview_clicked(self, _gesture, n_press, _x, _y):
        if n_press >= 2:
            self.on_open_external()

    def on_preview_swiped(self, _gesture, vx, _vy):
        if vx < -100:
            self.on_next_photo()
        elif vx > 100:
            self.on_prev_photo()

    def on_key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q):
            self.close()
            return True
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_h, Gdk.KEY_Page_Up):
            self.on_prev_photo()
            return True
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_l, Gdk.KEY_Page_Down):
            self.on_next_photo()
            return True
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_space, Gdk.KEY_o, Gdk.KEY_O):
            self.on_open_external()
            return True
        elif keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.on_delete_photo()
            return True
        return False

    def on_prev_photo(self, _btn=None):
        if self.cur_idx > 0:
            self.cur_idx -= 1
            self.load_current_photo()

    def on_next_photo(self, _btn=None):
        if self.cur_idx < len(self.photo_list) - 1:
            self.cur_idx += 1
            self.load_current_photo()

    def on_open_external(self, _btn=None):
        if self.photo_list and self.cur_idx < len(self.photo_list):
            try:
                subprocess.Popen(['xdg-open', self.photo_list[self.cur_idx]])
            except Exception as e:
                print("Failed to open external viewer:", e)

    def on_delete_photo(self, _btn=None):
        if not self.photo_list:
            return
        path = self.photo_list[self.cur_idx]
        try:
            os.remove(path)
            self.photo_list.pop(self.cur_idx)
            self.parent_win.recent_photos = self.photo_list
            self.parent_win.last_saved_path = self.photo_list[0] if self.photo_list else None
            self.parent_win.update_thumbnail_preview()
            if not self.photo_list:
                self.close()
                return
            if self.cur_idx >= len(self.photo_list):
                self.cur_idx = max(0, len(self.photo_list) - 1)
            self.load_current_photo()
        except Exception as e:
            print("Failed to delete photo:", e)


class CameraStudioApp(Adw.Application):
    __gtype_name__ = "CameraStudioApp"

    def __init__(self):
        super().__init__(application_id='org.local.camera_studio')

    def do_activate(self):
        win = CameraStudioWindow(self)
        win.present()


if __name__ == '__main__':
    app = CameraStudioApp()
    sys.exit(app.run(sys.argv))
