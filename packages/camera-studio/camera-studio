    def scan_recent_photos(self):
        files = glob.glob(os.path.join(self.save_dir, 'IMG_*.*'))
        files = [f for f in files if os.path.isfile(f) and os.path.getsize(f) > 0]
        files.sort(key=os.path.getmtime, reverse=True)
        return files[:50]

    def set_hardware_led(self, state: bool, brightness: int = 255):
        """Controls the physical rear camera LED flash/torch."""
        nodes = ['/sys/class/leds/white:flash/brightness'] + glob.glob('/sys/class/leds/*flash*/brightness') + glob.glob('/sys/class/leds/*torch*/brightness')
        val = str(brightness if state else 0)
        for path in nodes:
            if os.path.exists(path):
                try:
                    with open(path, 'w') as f:
                        f.write(val)
                    return True, "OK"
                except PermissionError:
                    return False, "PermissionError"
                except Exception as e:
                    return False, str(e)
        return False, "NotFound"

