    def init_sensor_proxy(self):
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.sensor_proxy = Gio.DBusProxy.new_sync(
                bus,
                Gio.DBusProxyFlags.NONE,
                None,
                'net.hadess.SensorProxy',
                '/net/hadess/SensorProxy',
                'net.hadess.SensorProxy',
                None
            )
            self.sensor_proxy.connect('g-properties-changed', self.on_sensor_properties_changed)
            cached = self.sensor_proxy.get_cached_property('AccelerometerOrientation')
            if cached:
                self.device_orientation = cached.get_string()

            # Claim accelerometer for continuous orientation monitoring
            self.sensor_proxy.call_sync(
                'ClaimAccelerometer',
                None,
                Gio.DBusCallFlags.NONE,
                -1,
                None
            )
        except Exception as e:
            print("SensorProxy setup error:", e)

    def on_sensor_properties_changed(self, proxy, changed_props, invalidated_props):
        orient = None
        try:
            unpacked = changed_props.unpack()
            if 'AccelerometerOrientation' in unpacked:
                orient = unpacked['AccelerometerOrientation']
        except Exception:
            pass
        if not orient:
            cached = proxy.get_cached_property('AccelerometerOrientation')
            if cached:
                orient = cached.get_string()
        if orient and orient != self.device_orientation:
            self.device_orientation = orient
            if self.auto_rotate:
                self.check_screen_and_sensor_orientation()

    def compute_auto_rotation(self) -> int:
        # Determine screen/display aspect ratio
        display = self.get_display()
        monitors = display.get_monitors() if display else None
        is_landscape = False
        if monitors and monitors.get_n_items() > 0:
            geom = monitors.get_item(0).get_geometry()
            is_landscape = (geom.width > geom.height)
        else:
            is_landscape = (self.get_width() > self.get_height())

        # Accelerometer orientation on Xiaomi Pad 5 (nabu):
        # - 'normal': Portrait upright -> 90°
        # - 'right-up': Standard Landscape (front camera / volume at top, USB on right) -> 0°
        # - 'left-up': Inverted Landscape (USB on left) -> 180°
        # - 'bottom-up': Inverted Portrait (USB on top) -> 270°
        orient = self.device_orientation

        if is_landscape:
            # Screen is in Landscape
            if orient == 'left-up':
                return 180
            else:
                return 0
        else:
            # Screen is in Portrait
            if orient == 'bottom-up':
                return 270
            else:
                return 90

    def check_screen_and_sensor_orientation(self):
        if not self.auto_rotate or not self.flip_elem:
            return True

        if self.sensor_proxy:
            try:
                cached = self.sensor_proxy.get_cached_property('AccelerometerOrientation')
                if cached:
                    orient = cached.get_string()
                    if orient != self.device_orientation:
                        self.device_orientation = orient
            except Exception:
                pass

        target_rot = self.compute_auto_rotation()
        if target_rot != self.current_applied_rot:
            self.update_video_direction()
            self.update_rotate_button()
        return True

    def on_auto_rotate_switch_changed(self, switch, _param):
        self.auto_rotate = switch.get_active()
        self.update_rotate_button()
        self.update_video_direction()
        self.show_toast(f"Auto-Rotate: {'ON' if self.auto_rotate else 'Locked'}")

    def on_rotate_camera(self, _btn):
        # Cycle: Auto -> 0° -> 90° -> 180° -> 270° -> Auto
        if self.auto_rotate:
            self.auto_rotate = False
            current = self.current_applied_rot if self.current_applied_rot is not None else 0
            self.rotation_degrees = (current + 90) % 360
            self.show_toast(f"Manual Rotation: {self.rotation_degrees}° (Locked)")
        else:
            next_rot = (self.rotation_degrees + 90) % 360
            if next_rot == 0 and self.rotation_degrees == 270:
                self.auto_rotate = True
                self.show_toast(f"Auto-Rotation: Active ({self.device_orientation})")
            else:
                self.rotation_degrees = next_rot
                self.show_toast(f"Manual Rotation: {self.rotation_degrees}°")

        if hasattr(self, 'switch_auto_rotate') and self.switch_auto_rotate.get_active() != self.auto_rotate:
            self.switch_auto_rotate.set_active(self.auto_rotate)
        self.update_rotate_button()
        self.update_video_direction()

    def update_rotate_button(self):
        if not hasattr(self, 'btn_rotate'):
            return
        if self.auto_rotate:
            rot = self.current_applied_rot if self.current_applied_rot is not None else self.compute_auto_rotation()
            self.btn_rotate.set_icon_name("rotation-allowed-symbolic")
            self.btn_rotate.set_tooltip_text(f"Auto-Rotation: {rot}° ({self.device_orientation}) - Click for Manual Lock")
            self.btn_rotate.remove_css_class("rotate-manual-active")
        else:
            self.btn_rotate.set_icon_name("object-rotate-right-symbolic")
            self.btn_rotate.set_tooltip_text(f"Manual Rotation: {self.rotation_degrees}° - Click to Cycle")
            self.btn_rotate.add_css_class("rotate-manual-active")

    def update_video_direction(self):
        if not self.flip_elem:
            return

        cam = self.cameras[self.cur_cam_idx] if self.cameras else {}
        is_front = cam.get('is_front', False)

        rot = self.compute_auto_rotation() if self.auto_rotate else self.rotation_degrees
        self.current_applied_rot = rot

        if is_front:
            if self.mirrored:
                # Front camera mirrored (natural selfie mode)
                # Raw sensor on Xiaomi Pad 5 (nabu) is 180° inverted:
                # 0° (landscape normal) -> 5 (vert: inverts Y to upright, keeps X mirrored)
                # 90° (portrait upright) -> 6 (ul-lr)
                # 180° (landscape inverted) -> 4 (horiz)
                # 270° (portrait inverted) -> 7 (ur-ll)
                dirs = {0: 5, 90: 6, 180: 4, 270: 7}
                val = dirs.get(rot, 5)
            else:
                # Front camera non-mirrored (rear-style perspective)
                dirs = {0: 2, 90: 1, 180: 0, 270: 3}
                val = dirs.get(rot, 2)
        else:
            if not self.mirrored:
                # Rear camera normal view
                dirs = {0: 0, 90: 1, 180: 2, 270: 3}
                val = dirs.get(rot, 0)
            else:
                # Rear camera mirrored
                dirs = {0: 4, 90: 7, 180: 5, 270: 6}
                val = dirs.get(rot, 4)

        try:
            self.flip_elem.set_property('video-direction', val)
        except Exception as e:
            print("Failed to update video-direction:", e)

    def set_focus(self, val: int):
