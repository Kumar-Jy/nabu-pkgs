    def on_switch_camera(self, _btn):
        if len(self.cameras) <= 1:
            self.show_toast("Only one camera device detected")
            return

        # Turn off torch before switching
        if self.torch_on:
            self.set_hardware_led(False)
            self.torch_on = False
        if self.fill_light_active:
            self.set_fill_light_state(False)

        # Switch camera index
        self.cur_cam_idx = (self.cur_cam_idx + 1) % len(self.cameras)
        cam = self.cameras[self.cur_cam_idx]
        is_front = cam.get('is_front', False)

        # Adapt resolution preset when switching between front (8MP max) and rear (13MP max)
        if is_front and self.target_res_idx == 0:
            self.set_target_resolution(1, update_drawer=True)
        elif not is_front and self.target_res_idx == 1:
            self.set_target_resolution(0, update_drawer=True)

        # Auto-configure mirror (selfies look natural mirrored)
        self.mirrored = is_front
        self.update_mirror_button()
        self.rotation_degrees = 0

        self.update_camera_switcher_button()
        self.update_flash_button()
        self.update_resolution_ui()
        if hasattr(self, 'focus_group'):
            self.focus_group.set_visible(not is_front)
        self.show_toast(f"Switched to {cam['name']} ({cam['megapixels']})")

        # Restart pipeline with the new camera
        self.start_camera_pipeline()

