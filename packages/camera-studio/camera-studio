        if hasattr(self, 'btn_res'):
            self.btn_res.set_label(f"📐 {preset['short']}")
            self.btn_res.set_tooltip_text(f"Capture Resolution: {preset['name']} ({preset['desc']})")
        if hasattr(self, 'res_pop_checks'):
            for i, check in enumerate(self.res_pop_checks):
                check.set_visible(i == self.target_res_idx)

    def on_format_changed(self, dropdown, _pspec):
        idx = dropdown.get_selected()
        fmts = ['jpeg', 'png', 'webp']
        subtitles = [
            "Standard compressed photo (95% quality)",
            "Lossless uncompressed image (larger file size)",
            "Next-gen high-efficiency web format"
        ]
        self.output_format = fmts[idx]
        if hasattr(self, 'row_fmt'):
            self.row_fmt.set_subtitle(subtitles[idx])
        self.row_quality.set_sensitive(self.output_format in ('jpeg', 'webp'))
        self.show_toast(f"Format: {self.output_format.upper()}")

    # --- Camera Pipeline Setup ---
    def start_camera_pipeline(self):
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None

        if not self.cameras:
            self.show_toast("No camera devices found!")
            return

        cam = self.cameras[self.cur_cam_idx]

        # Build pipeline string based on camera type
        # Use native 4:3 sensor mode (2048x1536) to prevent 16:9 cropping and maximize light capture
        if cam['type'] == 'libcamera':
            src_str = (
                f'libcamerasrc name=cam camera-name="{cam["id"]}" '
                f'exposure-value={self.ev_bias} sharpness={self.cam_sharpness} '
                f'! video/x-raw,width=2048,height=1536'
            )
        elif cam['type'] == 'v4l2':
            src_str = f'v4l2src device="{cam["id"]}" ! video/x-raw,width=1920,height=1080'
        else:
            src_str = 'videotestsrc pattern=ball ! video/x-raw,width=2048,height=1536'

        pipe_str = (
            f'{src_str} ! videoconvert ! '
            f'videobalance name=bal brightness={self.brightness} contrast={self.contrast} saturation={self.saturation} hue={self.hue} ! '
            f'gamma name=gam gamma={self.gamma} ! '
            f'videoflip name=flip ! '
            f'video/x-raw,format=RGB ! '
            f'gtk4paintablesink name=sink'
        )

        try:
            self.pipeline = Gst.parse_launch(pipe_str)
            self.cam_elem = self.pipeline.get_by_name('cam')
            self.bal_elem = self.pipeline.get_by_name('bal')
            self.gam_elem = self.pipeline.get_by_name('gam')
            self.flip_elem = self.pipeline.get_by_name('flip')
            self.paintable_sink = self.pipeline.get_by_name('sink')

            self.update_video_direction()

            # Hook paintable to viewfinder picture
            paintable = self.paintable_sink.props.paintable
            self.pic_viewfinder.set_paintable(paintable)

            # Start pipeline
            self.pipeline.set_state(Gst.State.PLAYING)
        except Exception as e:
            self.show_toast(f"Camera launch error: {e}")
            print("Pipeline launch failed:", e)

    # --- Hardware Sensor & Exposure Control Handlers ---
    def on_ev_slider_changed(self, scale):
        self.set_ev_bias(scale.get_value(), update_drawer=False)

    def on_cycle_ev(self, _btn=None):
        cur = self.ev_bias
        try:
            idx = self.EV_CYCLE.index(cur)
            nxt = self.EV_CYCLE[(idx + 1) % len(self.EV_CYCLE)]
        except ValueError:
            nxt = 0.5
        self.set_ev_bias(nxt)
        self.show_toast(f"Exposure Bias: {nxt:+.1f} EV")

    def on_sharpness_slider_changed(self, scale):
        self.set_sharpness_val(scale.get_value(), update_drawer=False)

    # --- Shutter & Photo Capture ---
    def on_shutter_clicked(self, _btn):
        if self.countdown_remaining > 0:
            if self.countdown_source_id:
                GLib.source_remove(self.countdown_source_id)
                self.countdown_source_id = None
            self.countdown_remaining = 0
            self.countdown_box.set_visible(False)
            return

        if self.timer_seconds > 0:
            self.countdown_remaining = self.timer_seconds
            self.countdown_box.set_visible(True)
            self.lbl_countdown.set_label(str(self.countdown_remaining))
            self.countdown_source_id = GLib.timeout_add(1000, self.on_timer_tick)
        else:
            self.execute_capture()

    def on_timer_tick(self):
        self.countdown_remaining -= 1
        if self.countdown_remaining > 0:
            self.lbl_countdown.set_label(str(self.countdown_remaining))
            return True
        else:
            self.countdown_box.set_visible(False)
            self.countdown_source_id = None
            self.execute_capture()
            return False

    def execute_capture(self):
        cam = self.cameras[self.cur_cam_idx] if self.cameras else {}
        is_front = cam.get('is_front', False)

        # 1. Trigger Flash (Hardware LED for Rear or Screen Flash for Front)
        fired_hardware_flash = False
        if self.flash_mode in ('auto', 'torch'):
            if is_front or not os.path.exists('/sys/class/leds/white:flash/brightness'):
                self.flash_box.set_visible(True)
                GLib.timeout_add(150, lambda: self.flash_box.set_visible(False))
            else:
                ok, _ = self.set_hardware_led(True, self.flash_brightness)
                if ok:
                    fired_hardware_flash = True
                    if not self.torch_on:
                        GLib.timeout_add(250, lambda: self.set_hardware_led(False))
                else:
                    self.flash_box.set_visible(True)
                    GLib.timeout_add(150, lambda: self.flash_box.set_visible(False))
        else:
            # Subtle visual screen shutter flash feedback
            self.flash_box.set_visible(True)
            GLib.timeout_add(100, lambda: self.flash_box.set_visible(False))

        # 2. Play shutter sound asynchronously
        self.play_shutter_sound()

        # 3. Pull frame from paintable sink
        if not self.paintable_sink:
            self.show_toast("Error: Viewfinder sink not active")
            return

        sample = self.paintable_sink.props.last_sample
        if not sample:
            self.show_toast("Error: Unable to capture frame from viewfinder")
            return

        caps = sample.get_caps()
        struct = caps.get_structure(0)
        w = struct.get_value('width')
        h = struct.get_value('height')
        fmt = struct.get_value('format')
        buf = sample.get_buffer()

        ok, map_info = buf.map(Gst.MapFlags.READ)
        if not ok:
            self.show_toast("Error: Failed to read buffer memory")
            return

        try:
            has_alpha = (fmt == 'RGBA')
            channels = 4 if has_alpha else 3
            expected_rowstride = w * channels
            actual_stride = len(map_info.data) // h if h > 0 else expected_rowstride

            # Extract image bytes and compact if GPU row pitch differs from width * channels
            if actual_stride != expected_rowstride:
                raw_bytes = bytearray(expected_rowstride * h)
                for row in range(h):
                    raw_bytes[row * expected_rowstride : (row + 1) * expected_rowstride] = \
                        map_info.data[row * actual_stride : row * actual_stride + expected_rowstride]
                gb = GLib.Bytes.new(bytes(raw_bytes))
            else:
                gb = GLib.Bytes.new(bytes(map_info.data))
        except Exception as e:
            self.show_toast(f"Capture error: {e}")
            print("Buffer extraction failed:", e)
            return
        finally:
            buf.unmap(map_info)

        # Target resolution & format settings from UI
        preset = RESOLUTION_PRESETS[self.target_res_idx]
        target_w = preset['w']
        target_h = preset['h']
        output_format = self.output_format
        quality_val = str(int(self.scale_quality.get_value()))
        save_dir = self.save_dir

        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        ext = 'jpg' if output_format == 'jpeg' else output_format
        filename = f"IMG_{timestamp}.{ext}"
        filepath = os.path.join(save_dir, filename)

        def save_worker():
            try:
                use_pillow = False
                try:
                    from PIL import Image, ImageEnhance, ImageFilter, ImageOps
                    use_pillow = True
                except ImportError:
                    pass

                if use_pillow:
                    raw_data = bytes(gb)
                    mode = 'RGBA' if has_alpha else 'RGB'
                    img = Image.frombytes(mode, (w, h), raw_data, 'raw', mode, expected_rowstride)
                    if has_alpha and output_format == 'jpeg':
                        img = img.convert('RGB')

                    # Target resolution scaling with high-quality anti-aliasing Lanczos filter
                    if target_w > 0 and target_h > 0 and (target_w != w or target_h != h):
                        img = img.resize((target_w, target_h), Image.Resampling.LANCZOS)

                    # Computational image enhancement pipeline (Android / GCam style)
                    if getattr(self, 'enable_enhancement', True):
                        # 1. Adaptive White Balance & Color Normalization (removes green haze / blue cast)
                        try:
                            from PIL import ImageStat
                            stat = ImageStat.Stat(img)
                            rm, gm, bm = stat.mean[:3]
                            if rm > 1.0 and gm > 1.0 and bm > 1.0:
                                mean_ch = (rm + gm + bm) / 3.0
                                # Calculate adaptive channel gains to neutralize sensor color cast
                                r_gain = 1.0 + (mean_ch / rm - 1.0) * 0.85
                                g_gain = 1.0 + (mean_ch / gm - 1.0) * 0.85
                                b_gain = 1.0 + (mean_ch / bm - 1.0) * 0.85
                                r_lut = [min(255, max(0, int(i * r_gain))) for i in range(256)]
                                g_lut = [min(255, max(0, int(i * g_gain))) for i in range(256)]
                                b_lut = [min(255, max(0, int(i * b_gain))) for i in range(256)]
                                r_ch, g_ch, b_ch = img.split()
                                img = Image.merge('RGB', (r_ch.point(r_lut), g_ch.point(g_lut), b_ch.point(b_lut)))
                        except Exception as e_awb:
                            print("Adaptive AWB error:", e_awb)

                        # 2. Exposure Value (EV Bias) Compensation
                        if self.ev_bias != 0.0:
                            exp_factor = 2.0 ** (self.ev_bias * 0.5)
                            img = ImageEnhance.Brightness(img).enhance(exp_factor)

                        # 3. Micro-contrast & tone curve
                        img = ImageEnhance.Contrast(img).enhance(1.08)
                        # 4. Color vibrancy boost (lifts dull sRGB colors)
                        img = ImageEnhance.Color(img).enhance(1.10)
                        # 5. Dynamic range expansion (gentle shadow lift)
                        img = ImageOps.autocontrast(img, cutoff=0.3)
                        # 6. Unsharp masking for crisp textures & fine details
                        img = img.filter(ImageFilter.UnsharpMask(radius=1.5, percent=125, threshold=3))

                    saved_w, saved_h = img.size
                    q = int(quality_val)
                    if output_format == 'jpeg':
                        img.save(filepath, 'JPEG', quality=q, subsampling=0)
                    elif output_format == 'webp':
                        img.save(filepath, 'WEBP', quality=q, method=6)
                    else:
                        img.save(filepath, 'PNG', optimize=True)
                else:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(gb, GdkPixbuf.Colorspace.RGB, has_alpha, 8, w, h, expected_rowstride)
                    if target_w > 0 and target_h > 0 and (target_w != w or target_h != h):
                        pixbuf = pixbuf.scale_simple(target_w, target_h, GdkPixbuf.InterpType.BILINEAR)

                    if output_format == 'jpeg':
                        pixbuf.savev(filepath, 'jpeg', ['quality'], [quality_val])
                    elif output_format == 'webp':
                        pixbuf.savev(filepath, 'webp', ['quality'], [quality_val])
                    else:
                        pixbuf.savev(filepath, 'png', [], [])

                    saved_w = pixbuf.get_width()
                    saved_h = pixbuf.get_height()

                def on_save_complete():
                    self.last_saved_path = filepath
                    self.recent_photos.insert(0, filepath)
                    self.update_thumbnail_preview()
                    self.show_toast(f"Saved: {filename} ({saved_w}×{saved_h})")

                GLib.idle_add(on_save_complete)
            except Exception as e:
                print("Capture background save failed:", e)
                GLib.idle_add(lambda: self.show_toast(f"Save error: {e}"))

        threading.Thread(target=save_worker, daemon=True).start()

    def play_shutter_sound(self):
        try:
            sound_file = '/usr/share/sounds/freedesktop/stereo/camera-shutter.oga'
            if os.path.exists(sound_file):
                subprocess.Popen(['pw-play', sound_file], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                subprocess.Popen(['canberra-gtk-play', '-i', 'camera-shutter'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def update_thumbnail_preview(self):
        if self.last_saved_path and os.path.exists(self.last_saved_path) and os.path.getsize(self.last_saved_path) > 0:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.last_saved_path, 52, 52, True)
                self.img_thumb.set_from_pixbuf(pb)
                return
            except Exception:
                pass
        self.img_thumb.set_from_icon_name("image-x-generic-symbolic")

    # --- In-App Photo Gallery & Inspector ---
    def on_open_gallery(self, _btn=None):
        self.recent_photos = self.scan_recent_photos()
        if not self.recent_photos or not os.path.exists(self.recent_photos[0]):
            self.show_toast("No photos taken yet")
            return

        dialog = GalleryInspectorDialog(self, self.recent_photos)
        dialog.present()

    def open_last_photo_external(self):
        self.recent_photos = self.scan_recent_photos()
        if self.recent_photos and os.path.exists(self.recent_photos[0]):
            try:
                subprocess.Popen(['xdg-open', self.recent_photos[0]])
            except Exception as e:
                self.show_toast(f"Error opening viewer: {e}")
        else:
            self.show_toast("No photos taken yet")

    def on_toggle_fullscreen(self, _btn=None):
        if self.is_fullscreen():
            self.unfullscreen()
            self.btn_fullscreen.set_icon_name("view-fullscreen-symbolic")
            self.btn_fullscreen.set_tooltip_text("Toggle Fullscreen (F11)")
        else:
            self.fullscreen()
            self.btn_fullscreen.set_icon_name("view-restore-symbolic")
            self.btn_fullscreen.set_tooltip_text("Exit Fullscreen (F11)")

    def on_key_pressed(self, _controller, keyval, _keycode, state):
        is_ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        if is_ctrl and keyval in (Gdk.KEY_q, Gdk.KEY_Q, Gdk.KEY_w, Gdk.KEY_W):
            self.close()
            return True
        elif keyval in (Gdk.KEY_space, Gdk.KEY_Return):
            self.on_shutter_clicked(None)
            return True
        elif keyval in (Gdk.KEY_c, Gdk.KEY_C):
            self.on_switch_camera(None)
            return True
        elif keyval in (Gdk.KEY_e, Gdk.KEY_E):
            self.on_cycle_ev()
            return True
        elif keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.on_cycle_flash(None)
            return True
        elif keyval in (Gdk.KEY_g, Gdk.KEY_G):
            self.on_cycle_grid(None)
            return True
        elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
            self.on_cycle_timer(None)
            return True
        elif keyval in (Gdk.KEY_m, Gdk.KEY_M):
            self.on_toggle_mirror(None)
            return True
        elif keyval == Gdk.KEY_F11:
            self.on_toggle_fullscreen()
            return True
        elif keyval in (Gdk.KEY_Escape,):
            if self.drawer_revealer.get_reveal_child():
                self.drawer_revealer.set_reveal_child(False)
                return True
            self.close()
            return True
        return False

    def show_toast(self, text):
        toast = Adw.Toast.new(text)
        toast.set_timeout(2)
        self.toast_overlay.add_toast(toast)

    def do_close_request(self):
        if hasattr(self, 'orient_timer_id') and self.orient_timer_id:
            GLib.source_remove(self.orient_timer_id)
            self.orient_timer_id = None
        # Always turn off hardware flashlight on exit
        if self.torch_on:
            self.set_hardware_led(False)
            self.torch_on = False
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        return False


# In-App Gallery & Post-Processing Inspector
class GalleryInspectorDialog(Adw.Window):
    __gtype_name__ = "GalleryInspectorDialog"

    def __init__(self, parent_win, photo_list):
        super().__init__(title="Photo Inspector & Studio")
        self.set_default_size(880, 620)
        self.set_modal(True)
        self.set_transient_for(parent_win)

        self.parent_win = parent_win
        self.photo_list = [p for p in photo_list if os.path.isfile(p) and os.path.getsize(p) > 0]
        self.cur_idx = 0

        # Style & Dark theme
        style_mgr = Adw.StyleManager.get_default()
        style_mgr.set_color_scheme(Adw.ColorScheme.FORCE_DARK)

        self.build_ui()

        # Keyboard shortcuts (Esc=Close, Left/Right=Navigate, Enter=Open Viewer, Del=Delete)
        key_controller = Gtk.EventControllerKey()
        key_controller.connect('key-pressed', self.on_key_pressed)
        self.add_controller(key_controller)

        self.load_current_photo()

    def build_ui(self):
        toolbar_view = Adw.ToolbarView()
        self.set_content(toolbar_view)

        # HeaderBar
        header_bar = Adw.HeaderBar()
        self.lbl_title = Gtk.Label(label="Photo Inspector")
        self.lbl_title.add_css_class("title-3")
        header_bar.set_title_widget(self.lbl_title)

        # Open in Loupe / Image Viewer button
        btn_open_external = Gtk.Button(icon_name="document-open-symbolic")
        btn_open_external.set_tooltip_text("Open in System Image Viewer (Gwenview)")
        btn_open_external.connect('clicked', self.on_open_external)
        header_bar.pack_end(btn_open_external)

        # Open Folder button
        btn_open_folder = Gtk.Button(icon_name="folder-symbolic")
        btn_open_folder.set_tooltip_text("Open Pictures/Camera Folder")
        btn_open_folder.connect('clicked', lambda _: subprocess.Popen(['xdg-open', self.parent_win.save_dir]))
        header_bar.pack_end(btn_open_folder)

        toolbar_view.add_top_bar(header_bar)

        # Content: Horizontal Paned (Image on left, Info on right)
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(540)

        # Left: Photo Preview with Navigation buttons & Gestures
        left_overlay = Gtk.Overlay()
        self.pic_preview = Gtk.Picture()
        self.pic_preview.set_hexpand(True)
        self.pic_preview.set_vexpand(True)
        self.pic_preview.set_can_shrink(True)
        self.pic_preview.set_content_fit(Gtk.ContentFit.CONTAIN)
        left_overlay.set_child(self.pic_preview)

        # Double-click gesture on photo preview to open in full viewer
        double_click = Gtk.GestureClick()
        double_click.connect('pressed', self.on_preview_clicked)
        self.pic_preview.add_controller(double_click)

        # Touchscreen swipe gesture (swipe left -> next, swipe right -> prev)
        swipe_gesture = Gtk.GestureSwipe()
        swipe_gesture.connect('swipe', self.on_preview_swiped)
        left_overlay.add_controller(swipe_gesture)

        # Nav buttons (Prev / Next)
        nav_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        nav_box.set_valign(Gtk.Align.CENTER)
        nav_box.set_margin_start(12)
        nav_box.set_margin_end(12)

        self.btn_prev = Gtk.Button(icon_name="go-previous-symbolic")
        self.btn_prev.add_css_class("action-circle-btn")
        self.btn_prev.set_tooltip_text("Previous Photo (Left Arrow)")
        self.btn_prev.connect('clicked', self.on_prev_photo)
        nav_box.append(self.btn_prev)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        nav_box.append(spacer)

        self.btn_next = Gtk.Button(icon_name="go-next-symbolic")
        self.btn_next.add_css_class("action-circle-btn")
        self.btn_next.set_tooltip_text("Next Photo (Right Arrow)")
        self.btn_next.connect('clicked', self.on_next_photo)
        nav_box.append(self.btn_next)

        left_overlay.add_overlay(nav_box)
        paned.set_start_child(left_overlay)

        # Right: Info & Actions
        right_scroll = Gtk.ScrolledWindow()
        right_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        info_page = Adw.PreferencesPage()

        # Metadata Group
        meta_group = Adw.PreferencesGroup(title="Photo Details")
        self.row_file = Adw.ActionRow(title="File Name")
        self.row_res = Adw.ActionRow(title="Dimensions")
        self.row_size = Adw.ActionRow(title="File Size")
        self.row_date = Adw.ActionRow(title="Captured On")

        meta_group.add(self.row_file)
        meta_group.add(self.row_res)
        meta_group.add(self.row_size)
        meta_group.add(self.row_date)
        info_page.add(meta_group)

        # Actions Group
        action_group = Adw.PreferencesGroup(title="Actions")
        
        # Open in System Viewer action row
        row_open = Adw.ActionRow(title="System Viewer", subtitle="Open full resolution in default image viewer")
