    def on_cycle_flash(self, _btn):
        modes = ['off', 'auto', 'torch']
        curr_idx = modes.index(self.flash_mode) if self.flash_mode in modes else 0
        self.flash_mode = modes[(curr_idx + 1) % len(modes)]

        cam = self.cameras[self.cur_cam_idx] if self.cameras else {}
        is_front = cam.get('is_front', False)

        if self.flash_mode == 'torch':
            if is_front:
                # Front camera uses screen fill light as torch
                self.set_fill_light_state(True)
                self.show_toast("💡 Flashlight: Screen Softbox Fill Light ON (Front Camera)")
            else:
                # Rear camera uses physical LED
                ok, err = self.set_hardware_led(True, self.flash_brightness)
                if ok:
                    self.torch_on = True
                    self.show_toast("💡 Flashlight: Rear LED Torch Turned ON")
                else:
                    self.set_fill_light_state(True)
                    self.show_toast(f"💡 Flashlight: Screen Light ON (Hardware LED {err})")
        else:
            # Turn off torch
            if self.torch_on:
                self.set_hardware_led(False)
                self.torch_on = False
            if self.fill_light_active:
                self.set_fill_light_state(False)

            if self.flash_mode == 'auto':
                self.show_toast("⚡ Flash Mode: Auto Flash on Capture")
            else:
                self.show_toast("⚡ Flash Mode: Flash OFF")

        self.update_flash_button()

