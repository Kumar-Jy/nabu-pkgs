        icon_str = "🤳" if is_front else "📷"
        short_name = "Front" if is_front else "Rear"
        label_text = f"{icon_str} {short_name} ({cam['megapixels']}) ⇄"
        self.btn_camera_switcher.set_label(label_text)

        if hasattr(self, 'btn_switch_cam'):
            target_name = "Front Camera" if not is_front else "Rear Camera"
            self.btn_switch_cam.set_tooltip_text(f"Switch to {target_name} (C)")

