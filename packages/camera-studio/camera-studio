    def switch_hud_tab(self, tab_id):
        cur = self.hud_stack.get_visible_child_name()
        target = 'looks' if (cur == tab_id and tab_id != 'looks') else tab_id
        self.hud_stack.set_visible_child_name(target)
        for tid, btn in self.hud_tab_buttons.items():
            if tid == target:
                btn.add_css_class("hud-tab-btn-active")
            else:
                btn.remove_css_class("hud-tab-btn-active")

    def on_toggle_hud(self, _btn=None):
        revealed = self.hud_revealer.get_reveal_child()
        self.hud_revealer.set_reveal_child(not revealed)
        if not revealed:
            self.btn_adjust_color.add_css_class("hud-active-btn")
        else:
            self.btn_adjust_color.remove_css_class("hud-active-btn")

