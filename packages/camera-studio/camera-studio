def find_focus_device():
    for subdev in sorted(glob.glob('/dev/v4l-subdev*')):
        try:
            out = subprocess.run(['v4l2-ctl', '-d', subdev, '-C', 'focus_absolute'],
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if 'focus_absolute' in out.stdout:
                return subdev
        except Exception:
            pass
    return None

# Discover Available Cameras
def discover_cameras():
    cameras = []
    # 1. Probe libcamera cameras (mainline sm8150 nabu)
    try:
        res = subprocess.run(['cam', '-l'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        for line in res.stdout.splitlines():
            line = line.strip()
            if ':' in line:
                idx_part, rest = line.split(':', 1)
                if idx_part.strip().isdigit():
                    if '(' in rest and rest.endswith(')'):
                        name_part, path_part = rest.rsplit('(', 1)
                        cam_name = name_part.strip()
                        cam_path = path_part.rstrip(')').strip()
                    else:
                        cam_name = rest.strip()
                        cam_path = rest.strip()
                    
                    is_front = 'front' in cam_name.lower() or 'bus@1' in cam_path
                    sensor = 'OmniVision OV8856 (Front 8MP)' if is_front else 'OmniVision OV13B10 (Rear 13MP)'
                    max_w, max_h = (3272, 2464) if is_front else (4200, 3120)
                    cameras.append({
                        'type': 'libcamera',
                        'id': cam_path,
                        'name': 'Front Selfie Camera' if is_front else 'Rear Main Camera',
                        'sensor': sensor,
                        'max_res': (max_w, max_h),
                        'megapixels': '8 MP' if is_front else '13 MP',
                        'is_front': is_front
                    })
    except Exception:
        pass

    # 2. Probe V4L2 USB devices if no libcamera detected or additional external webcams exist
    if not cameras:
        for dev in sorted(glob.glob('/dev/video*')):
            try:
                out = subprocess.run(['v4l2-ctl', '--device', dev, '--all'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout
                if 'Video Capture' in out and 'platform:' not in out:
                    cameras.append({
                        'type': 'v4l2',
                        'id': dev,
                        'name': f"V4L2 Camera ({os.path.basename(dev)})",
                        'sensor': 'USB / External Webcam',
                        'max_res': (1920, 1080),
                        'megapixels': 'FHD',
                        'is_front': False
                    })
            except Exception:
                pass

    # 3. Fallback virtual source if no hardware present
    if not cameras:
        cameras.append({
            'type': 'test',
            'id': 'videotestsrc',
            'name': 'Virtual Studio Camera (Test Pattern)',
            'sensor': 'Software Video Pattern',
            'max_res': (1920, 1080),
            'megapixels': '2 MP',
            'is_front': False
        })

    return cameras


