    # --- Framing Grid Overlay UI ---
    def update_grid_ui(self):
        while child := self.grid_overlay_box.get_first_child():
            self.grid_overlay_box.remove(child)

        if self.grid_mode == 0:
            self.grid_overlay_box.set_visible(False)
            return

        self.grid_overlay_box.set_visible(True)

        if self.grid_mode == 1: # Rule of Thirds (3x3)
            grid = Gtk.Grid()
            grid.set_hexpand(True)
            grid.set_vexpand(True)
            for r in range(3):
                for c in range(3):
                    b = Gtk.Box()
                    b.set_hexpand(True)
                    b.set_vexpand(True)
                    if r < 2:
                        b.add_css_class("grid-line-horizontal")
                    if c < 2:
                        b.add_css_class("grid-line-vertical")
                    grid.attach(b, c, r, 1, 1)
            self.grid_overlay_box.append(grid)
        elif self.grid_mode == 2: # Golden Ratio
            grid = Gtk.Grid()
            grid.set_hexpand(True)
            grid.set_vexpand(True)
            for r in range(3):
                for c in range(3):
                    b = Gtk.Box()
                    b.set_hexpand(True)
                    b.set_vexpand(True)
                    if r < 2:
                        b.add_css_class("grid-line-horizontal")
                    if c < 2:
                        b.add_css_class("grid-line-vertical")
                    grid.attach(b, c, r, 1, 1)
            self.grid_overlay_box.append(grid)
        elif self.grid_mode == 3: # Crosshair
            cross_grid = Gtk.Grid()
            cross_grid.set_hexpand(True)
            cross_grid.set_vexpand(True)
            for r in range(2):
                for c in range(2):
                    b = Gtk.Box()
                    b.set_hexpand(True)
                    b.set_vexpand(True)
                    if r == 0:
                        b.add_css_class("grid-line-horizontal")
                    if c == 0:
                        b.add_css_class("grid-line-vertical")
