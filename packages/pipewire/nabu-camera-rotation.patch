@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Dynamic camera orientation for Xiaomi Pad 5 (nabu).
+ *
+ * Follows iio-sensor-proxy orientation: left/right-up are landscape,
+ * normal/bottom-up are portrait.
+ */
+
+#pragma once
+
+namespace nabu {
+
+unsigned int deviceRotation();
+int videoDirection(bool front, bool mirrored);
+const char *imageOrientationTag(bool front, bool mirrored);
+
+} /* namespace nabu */
