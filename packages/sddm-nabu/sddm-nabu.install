post_install() {
  mkdir -p /var/lib/sddm/.config
  if [ ! -f /var/lib/sddm/.config/kwinrc ] || ! grep -q "VirtualKeyboardEnabled" /var/lib/sddm/.config/kwinrc; then
    cat << 'EOL' > /var/lib/sddm/.config/kwinrc
[Wayland]
VirtualKeyboardEnabled=true
EOL
    chown -R sddm:sddm /var/lib/sddm/.config
  fi
}

post_upgrade() {
  post_install
}
