<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "https://specifications.freedesktop.org/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Nabu Linux Tools</vendor>
  <vendor_url>https://github.com/Kumar-Jy/nabu-pkgs</vendor_url>
  <icon_name>nabu-backup</icon_name>
  <action id="org.nabu.backup.pkexec">
    <description>Elevated privileges for Nabu system backup and restoration</description>
    <message>Authentication is required to back up or restore system settings (WiFi credentials, Bluetooth pairings, boot parameters, and system packages)</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/nabu-backup</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
