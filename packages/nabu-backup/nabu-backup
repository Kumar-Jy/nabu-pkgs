            term = shutil.which("konsole") or shutil.which("kgx") or shutil.which("gnome-terminal") or shutil.which("xterm")
            if term:
                proc = subprocess.Popen([term, "-e", "rclone", "--config", conf_path, "config"])
                def watch_wizard():
                    proc.wait()
                    GLib.idle_add(lambda: self._async_refresh_cloud_remotes(force_space=True))
                threading.Thread(target=watch_wizard, daemon=True).start()
            else:
                self._show_alert("Terminal Required", "Please run 'rclone config' in your terminal emulator.")

        def _show_alert(self, heading, body):
            alert = Adw.AlertDialog(heading=heading, body=body)
            alert.add_response("ok", "OK")
            alert.present(self)

    app = NabuBackupApp()
    app.run([])

