# CLI Interactive and Batch Operations
# ==============================================================================
def run_cli_interactive():
    print(f"\n=======================================================")
    print(f"      {APP_NAME} v{APP_VERSION} (CLI Mode)")
    print(f"=======================================================")
    print("1. Create Full Backup (Internal / USB Drive)")
    print("2. Create Backup to Cloud (Google Drive / MEGA)")
    print("3. Restore System & User Data")
    print("4. List Detected Drives & Storage")
    print("5. List Cloud Remotes & Cloud Backups")
    print("6. Connect Cloud Account (MEGA / Google Drive)")
    print("7. Exit")
    choice = input("\nEnter choice [1-7]: ").strip()

    if choice == "1":
        drives = StorageScanner.scan_devices()
        if not drives:
            print("No suitable drives detected. Please connect a USB drive or specify folder.")
            dest = input("Enter custom destination path: ").strip()
        else:
            print("\nAvailable Storage Drives:")
            for i, d in enumerate(drives, 1):
                free_gb = d['free_bytes'] / (1024**3) if d['free_bytes'] else 0
                usb = "[USB-C]" if d['is_usb'] else "[Internal]"
                print(f"  {i}. {usb} {d['label']} ({d['kname']}) - {free_gb:.1f} GB free (Mount: {d['mountpoint']})")
            idx = int(input(f"Select drive [1-{len(drives)}]: ").strip()) - 1
            sel = drives[idx]
            mnt = sel['mountpoint'] or StorageScanner.mount_device(sel['device'])
            dest = os.path.join(mnt, BACKUP_DIR_NAME)

        opts = {
            'include_home': True, 'include_docs': True, 'include_packages': True,
            'include_system': True, 'include_boot': True, 'include_waydroid': False,
            'target_user': get_current_user(), 'is_cloud': False
        }
        print(f"\nStarting backup to: {dest} ...")
        BackupEngine.execute_backup(dest, opts, log_cb=print)

    elif choice == "2":
        remotes = CloudManager.list_remotes()
        if not remotes:
            print("No cloud remotes found. Configure one via option 6 or rclone config.")
            return
        print("\nConfigured Cloud Remotes:")
        for i, r in enumerate(remotes, 1):
            print(f"  {i}. {r['name']} ({r['type']})")
        idx = int(input(f"Select remote [1-{len(remotes)}]: ").strip()) - 1
        rem = remotes[idx]['name']

        opts = {
            'include_home': True, 'include_docs': True, 'include_packages': True,
            'include_system': True, 'include_boot': True, 'include_waydroid': False,
            'target_user': get_current_user(), 'is_cloud': True, 'cloud_remote': rem
        }
        print(f"\nStarting cloud backup to {rem} ...")
        BackupEngine.execute_backup("/tmp", opts, log_cb=print)

    elif choice == "3":
        backups = StorageScanner.find_local_backups()
        if not backups:
            path = input("Enter path to backup archive file: ").strip()
        else:
            print("\nFound Local Backups:")
            for i, b in enumerate(backups, 1):
                print(f"  {i}. {b['filename']} ({format_bytes(b['size'])}) on {b['device_label']}")
            sel = input(f"Select backup [1-{len(backups)}] or enter path: ").strip()
            if sel.isdigit() and 1 <= int(sel) <= len(backups):
                path = backups[int(sel)-1]['path']
            else:
                path = sel

        opts = {
            'restore_home': True, 'restore_packages': True,
            'restore_system': True, 'restore_boot': True,
            'target_user': get_current_user()
        }
        RestoreEngine.execute_restore(path, opts, log_cb=print)

    elif choice == "4":
        drives = StorageScanner.scan_devices()
        print("\n--- Detected Storage Drives ---")
        for d in drives:
            free = f"{d['free_bytes'] / (1024**3):.1f} GB free" if d['free_bytes'] else "Unmounted"
            usb = "USB-C OTG" if d['is_usb'] else "Internal UFS"
            print(f"[{usb}] {d['label']} ({d['kname']}, {d['fstype'].upper()}) - Total: {format_bytes(d['size'])} | Free: {free} | Mount: {d['mountpoint']}")

    elif choice == "5":
        remotes = CloudManager.list_remotes()
        print("\n--- Cloud Remotes ---")
        for r in remotes:
            print(f"• {r['name']} ({r['type']})")
            backups = CloudManager.list_cloud_backups(r['name'])
            for b in backups:
                print(f"    - {b['filename']} ({format_bytes(b['size'])})")

    elif choice == "6":
        p = input("Provider (1: MEGA, 2: Google Drive, 3: Other): ").strip()
        if p == "1":
            name = input("Remote name [mega]: ").strip() or "mega"
            email = input("MEGA Email: ").strip()
            pw = input("MEGA Password: ").strip()
            ok, msg = CloudManager.create_mega_remote(name, email, pw)
            print("Success!" if ok else f"Failed: {msg}")
        elif p == "2":
            name = input("Remote name [gdrive]: ").strip() or "gdrive"
            subprocess.run(rclone_cmd('config', 'create', name, 'drive'))
        else:
            subprocess.run(rclone_cmd('config'))

# ==============================================================================
# Main Dispatcher
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description=f"{APP_NAME} - Xiaomi Pad 5 System & Data Migration")
    parser.add_argument("--gui", action="store_true", help="Launch Libadwaita GUI interface")
    parser.add_argument("--cli", action="store_true", help="Launch interactive CLI menu")
    parser.add_argument("--list-drives", action="store_true", help="List detected storage devices")
    parser.add_argument("--list-cloud", action="store_true", help="List configured cloud remotes")

    parser.add_argument("--helper-stage-system", metavar="DIR", help=argparse.SUPPRESS)
    parser.add_argument("--helper-restore-system", metavar="DIR", help=argparse.SUPPRESS)

    subparsers = parser.add_subparsers(dest="command")

    backup_parser = subparsers.add_parser("backup", help="Create a new backup archive")
    backup_parser.add_argument("--dest", help="Destination directory or cloud remote name")
    backup_parser.add_argument("--cloud", action="store_true", help="Upload directly to cloud storage")
    backup_parser.add_argument("--no-system", action="store_true", help="Skip system settings (WiFi, BT, boot)")
    backup_parser.add_argument("--include-waydroid", action="store_true", help="Include Waydroid container")

    restore_parser = subparsers.add_parser("restore", help="Restore system from an archive")
    restore_parser.add_argument("archive", help="Path to backup archive (.tar.zst) or cloud remote:archive")
    restore_parser.add_argument("--no-packages", action="store_true", help="Skip pacman package synchronization")
    restore_parser.add_argument("--no-system", action="store_true", help="Skip system network and bluetooth restore")

    args = parser.parse_args()

    if args.helper_stage_system:
        BackupEngine._stage_system_files(args.helper_stage_system)
        sys.exit(0)
    if args.helper_restore_system:
        RestoreEngine._restore_system_files(args.helper_restore_system)
        sys.exit(0)

    if args.list_drives:
        drives = StorageScanner.scan_devices()
        for d in drives:
            free = f"{d['free_bytes'] / (1024**3):.1f} GB" if d['free_bytes'] else "Unmounted"
            print(f"{d['label']} ({d['kname']}, {d['fstype']}) - USB: {d['is_usb']} - Free: {free} - Mount: {d['mountpoint']}")
        sys.exit(0)

    if args.list_cloud:
        remotes = CloudManager.list_remotes()
        for r in remotes:
            print(f"{r['name']}: {r['type']}")
        sys.exit(0)

    if args.command == "backup":
        dest = args.dest
        if not dest:
            drives = StorageScanner.scan_devices()
            if drives and drives[0].get('mountpoint'):
                dest = os.path.join(drives[0]['mountpoint'], BACKUP_DIR_NAME)
            else:
                dest = os.path.expanduser("~/NabuBackups")
        opts = {
            'include_home': True, 'include_docs': True, 'include_packages': True,
            'include_system': not args.no_system, 'include_boot': not args.no_system,
            'include_waydroid': args.include_waydroid, 'target_user': get_current_user(),
            'is_cloud': args.cloud, 'cloud_remote': args.dest if args.cloud else None
        }
        BackupEngine.execute_backup(dest, opts, log_cb=print)
        sys.exit(0)

    if args.command == "restore":
        opts = {
            'restore_home': True, 'restore_packages': not args.no_packages,
            'restore_system': not args.no_system, 'restore_boot': not args.no_system,
            'target_user': get_current_user()
        }
        RestoreEngine.execute_restore(args.archive, opts, log_cb=print)
        sys.exit(0)

    if args.cli:
        run_cli_interactive()
        sys.exit(0)

    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if has_display and not args.cli:
        try:
            launch_gui()
        except Exception as e:
            print(f"Could not initialize GUI ({e}). Launching CLI instead...\n")
            run_cli_interactive()
    else:
        run_cli_interactive()

if __name__ == "__main__":
    main()
