        def _on_add_mega_dialog(self, btn):
            dlg = Adw.AlertDialog(heading="Connect MEGA Account", body="Enter your MEGA credentials. The password is encrypted locally before storing.")
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            entry_name = Gtk.Entry(placeholder_text="Remote Name (e.g. mymega)")
            entry_email = Gtk.Entry(placeholder_text="MEGA Email Address")
            entry_pass = Gtk.PasswordEntry(placeholder_text="MEGA Password")
            vbox.append(entry_name)
            vbox.append(entry_email)
            vbox.append(entry_pass)
            dlg.set_extra_child(vbox)

            dlg.add_response("cancel", "Cancel")
            dlg.add_response("connect", "Connect")
            dlg.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)

            def on_resp(d, resp):
                if resp == "connect":
                    name = entry_name.get_text().strip() or "mega"
                    email = entry_email.get_text().strip()
                    passwd = entry_pass.get_text().strip()
                    if not email or not passwd:
                        self._show_alert("Error", "Email and password are required.")
                        return
                    ok, msg = CloudManager.create_mega_remote(name, email, passwd)
                    if ok:
                        self._show_alert("Connected", f"MEGA account '{name}' connected successfully!")
                        self._refresh_cloud_accounts_ui()
                        self._refresh_cloud_remotes()
                    else:
                        self._show_alert("Connection Failed", msg)

            dlg.connect("response", on_resp)
            dlg.present(self)

        def _on_add_gdrive_clicked(self, btn):
            dlg = Adw.AlertDialog(heading="Connect Google Drive", body="A browser window will open to authorize Google Drive access.\nEnter a name for this remote:")
            entry_name = Gtk.Entry(text="gdrive", placeholder_text="Remote Name")
            dlg.set_extra_child(entry_name)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("login", "Authorize in Browser")
            dlg.set_response_appearance("login", Adw.ResponseAppearance.SUGGESTED)

            def on_resp(d, resp):
                if resp == "login":
                    name = entry_name.get_text().strip() or "gdrive"
                    # Launch rclone config in terminal emulator
                    term = shutil.which("konsole") or shutil.which("kgx") or shutil.which("gnome-terminal") or shutil.which("xterm")
                    if term:
                        cmd = [term, "-e", "rclone", "config", "create", name, "drive"]
                        subprocess.Popen(cmd)
                    else:
                        subprocess.Popen(["rclone", "config", "create", name, "drive"])
                    self._show_alert("Authorization Launched", "Complete the Google Drive sign-in in your browser, then refresh the Cloud Accounts list.")

            dlg.connect("response", on_resp)
            dlg.present(self)

        def _on_launch_rclone_wizard(self, btn):
            term = shutil.which("konsole") or shutil.which("kgx") or shutil.which("gnome-terminal") or shutil.which("xterm")
            if term:
                subprocess.Popen([term, "-e", "rclone", "config"])
            else:
                self._show_alert("Terminal Required", "Please run 'rclone config' in your terminal emulator.")

        def _show_alert(self, heading, body):
            alert = Adw.AlertDialog(heading=heading, body=body)
            alert.add_response("ok", "OK")
            alert.present(self)

    app = NabuBackupApp()
    app.run([])

