def get_current_user():
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        return sudo_user
    pkexec_uid = os.environ.get("PKEXEC_UID")
    if pkexec_uid:
        try:
            import pwd
            return pwd.getpwuid(int(pkexec_uid)).pw_name
        except Exception:
            pass
    return os.environ.get("USER", "user")

def get_user_home(username=None):
    if not username:
        username = get_current_user()
    try:
        import pwd
        return pwd.getpwnam(username).pw_dir
    except Exception:
        return f"/home/{username}"

def get_rclone_config_path():
    """Ensure rclone uses the user's config file regardless of whether running as user or root"""
    user = get_current_user()
    home = get_user_home(user)
    user_conf = os.path.join(home, ".config", "rclone", "rclone.conf")
    if os.path.exists(user_conf):
        return user_conf
    root_conf = "/root/.config/rclone/rclone.conf"
    if os.path.exists(root_conf) and os.path.getsize(root_conf) > 0:
        return root_conf
    os.makedirs(os.path.dirname(user_conf), exist_ok=True)
    return user_conf

def rclone_cmd(*args):
    """Helper to run rclone command with explicit config path"""
    return ['rclone', '--config', get_rclone_config_path()] + list(args)

def format_bytes(num_bytes):
    if num_bytes is None:
        return "Unknown"
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if num_bytes < 1024.0 or unit == 'TB':
            return f"{num_bytes:.1f} {unit}"
        num_bytes /= 1024.0
    return f"{num_bytes:.1f} TB"

