# Restore Engine
# ==============================================================================
class RestoreEngine:
    @classmethod
    def inspect_archive(cls, archive_path):
        meta = {}
        try:
            with tarfile.open(archive_path, 'r:*') as tar:
                for member in tar.getmembers():
                    if member.name.endswith("nabu-backup.json"):
                        f = tar.extractfile(member)
                        if f:
                            meta = json.load(f)
                            break
        except Exception as e:
            meta = {"error": str(e)}

        meta['file_size'] = os.path.getsize(archive_path) if os.path.exists(archive_path) else 0
        meta['archive_path'] = archive_path
        return meta

    @classmethod
    def execute_restore(cls, archive_path, options, progress_cb=None, log_cb=None):
        username = options.get('target_user') or get_current_user()
        user_home = get_user_home(username)
        staging_dir = f"/tmp/nabu-restore-staging-{int(time.time())}"
        os.makedirs(staging_dir, exist_ok=True)

        if log_cb:
            log_cb(f"=== Starting Restore from {os.path.basename(archive_path)} ===")
            log_cb(f"Destination User: {username} ({user_home})")

        if log_cb:
            log_cb("Extracting backup archive...")
        if progress_cb:
            progress_cb(0.15)
        
        try:
            with tarfile.open(archive_path, 'r:*') as tar:
                tar.extractall(staging_dir)
        except Exception as e:
            shutil.rmtree(staging_dir, ignore_errors=True)
            raise RuntimeError(f"Extraction failed: {e}")

        if options.get('restore_packages', True):
            pkglist_native = os.path.join(staging_dir, "meta", "pkglist-native.txt")
            if os.path.exists(pkglist_native):
                if log_cb:
                    log_cb("Restoring missing system packages via pacman (--needed)...")
                if progress_cb:
                    progress_cb(0.40)
                
                cmd = ['pacman', '-S', '--needed', '--noconfirm', '-']
                if os.geteuid() != 0:
                    cmd = ['pkexec'] + cmd
                
                try:
                    with open(pkglist_native, "r") as f:
                        proc = subprocess.run(cmd, stdin=f, capture_output=True, text=True)
                    if log_cb:
                        if proc.returncode == 0:
                            log_cb("Packages synchronized successfully without conflicts!")
                        else:
                            log_cb(f"Pacman status note: {proc.stderr or proc.stdout}")
                except Exception as e:
                    if log_cb:
                        log_cb(f"Pacman execution note: {e}")

            pkglist_foreign = os.path.join(staging_dir, "meta", "pkglist-foreign.txt")
            if os.path.exists(pkglist_foreign):
                try:
                    with open(pkglist_foreign, "r") as f:
                        fp_lines = [l.strip() for l in f if l.strip()]
                    if fp_lines:
                        report_path = os.path.join(user_home, "Desktop", "foreign-packages-to-reinstall.txt")
                        os.makedirs(os.path.dirname(report_path), exist_ok=True)
                        with open(report_path, "w") as rf:
                            rf.write("# The following AUR or local packages were installed on your previous system:\n")
                            rf.write("\n".join(fp_lines) + "\n")
                        if log_cb:
                            log_cb(f"Saved foreign/AUR package list for reference: {report_path}")
                except Exception:
                    pass

        if options.get('restore_home', True):
            if log_cb:
                log_cb("Restoring user files & desktop configurations...")
            if progress_cb:
                progress_cb(0.70)

            staged_home_root = os.path.join(staging_dir, "home")
            if os.path.exists(staged_home_root):
                for src_user in os.listdir(staged_home_root):
                    src_user_path = os.path.join(staged_home_root, src_user)
                    if os.path.isdir(src_user_path):
                        for item in os.listdir(src_user_path):
                            s = os.path.join(src_user_path, item)
                            d = os.path.join(user_home, item)
                            if os.path.isdir(s):
                                shutil.copytree(s, d, dirs_exist_ok=True, symlinks=True)
                            else:
                                shutil.copy2(s, d)

            if log_cb:
                log_cb(f"Normalizing user file permissions for {username}...")
            try:
                import pwd
                pw = pwd.getpwnam(username)
                uid, gid = pw.pw_uid, pw.pw_gid
                for root, dirs, files in os.walk(user_home):
                    for name in dirs:
                        os.chown(os.path.join(root, name), uid, gid)
                    for name in files:
                        os.chown(os.path.join(root, name), uid, gid)
            except Exception as e:
                if log_cb:
                    log_cb(f"Permission fix note: {e}")

        if options.get('restore_system', True) or options.get('restore_boot', True):
            sys_staged = os.path.join(staging_dir, "system")
            if os.path.exists(sys_staged):
                if log_cb:
                    log_cb("Restoring network credentials, bluetooth pairings, and boot parameters...")
                if progress_cb:
                    progress_cb(0.90)

                if os.geteuid() != 0:
                    cmd = ['pkexec', sys.executable, sys.argv[0], '--helper-restore-system', sys_staged]
                    try:
                        res = subprocess.run(cmd, capture_output=True, text=True)
                        if log_cb:
                            if res.returncode == 0:
                                log_cb("System settings restored successfully!")
                            else:
                                log_cb(f"System restore note: {res.stderr}")
                    except Exception as e:
                        if log_cb:
                            log_cb(f"Warning restoring system files: {e}")
                else:
                    cls._restore_system_files(sys_staged)

        shutil.rmtree(staging_dir, ignore_errors=True)

        if progress_cb:
            progress_cb(1.0)
        if log_cb:
            log_cb("=== System & User Data Restoration Completed Successfully! ===")
        return True

    @classmethod
    def _restore_system_files(cls, sys_staged):
        net_staged = os.path.join(sys_staged, "network")
        if os.path.exists(net_staged):
            dest = "/etc/NetworkManager/system-connections"
            os.makedirs(dest, exist_ok=True)
            for f in os.listdir(net_staged):
                src = os.path.join(net_staged, f)
                dst = os.path.join(dest, f)
                shutil.copy2(src, dst)
                os.chmod(dst, 0o600)
            subprocess.run(['nmcli', 'connection', 'reload'], capture_output=True)

        bt_staged = os.path.join(sys_staged, "bluetooth")
        if os.path.exists(bt_staged):
            dest = "/var/lib/bluetooth"
            os.makedirs(dest, exist_ok=True)
            for item in os.listdir(bt_staged):
                s = os.path.join(bt_staged, item)
                d = os.path.join(dest, item)
                if os.path.isdir(s):
                    shutil.copytree(s, d, dirs_exist_ok=True, symlinks=True)
                else:
                    shutil.copy2(s, d)
            os.chmod(dest, 0o700)
            subprocess.run(['systemctl', 'restart', 'bluetooth'], capture_output=True)

        cmd_staged = os.path.join(sys_staged, "cmdline.d")
        if os.path.exists(cmd_staged):
            dest = "/etc/cmdline.d"
            os.makedirs(dest, exist_ok=True)
            for f in os.listdir(cmd_staged):
                shutil.copy2(os.path.join(cmd_staged, f), os.path.join(dest, f))

