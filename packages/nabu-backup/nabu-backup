        def _check_storage_warning(self):
            if not self.selected_drive:
                self.storage_banner.set_title("No drive selected. Please choose an internal partition or connect a USB drive.")
                self.storage_banner.set_revealed(True)
            elif self.selected_drive.get('free_bytes') is not None and self.selected_drive['free_bytes'] < 3 * 1024**3:
                free_gb = self.selected_drive['free_bytes'] / (1024**3)
                self.storage_banner.set_title(f"Warning: Selected drive has only {free_gb:.1f} GB free space. Backup may require more.")
                self.storage_banner.set_revealed(True)
            else:
                self.storage_banner.set_revealed(False)

        def _on_drive_selected(self, drive_dict):
            if not drive_dict.get('mountpoint'):
                mnt = StorageScanner.mount_device(drive_dict['device'])
                if mnt:
                    drive_dict['mountpoint'] = mnt
                    try:
                        st = os.statvfs(mnt)
                        drive_dict['free_bytes'] = st.f_bavail * st.f_frsize
                    except Exception:
                        pass
            self.selected_drive = drive_dict
            self._check_storage_warning()

