        BackupEngine.execute_backup("/tmp", opts, log_cb=print)

    elif choice == "3":
        backups = StorageScanner.find_local_backups()
        if not backups:
            path = input("Enter path to backup archive file: ").strip()
        else:
            print("\nFound Local Backups:")
            for i, b in enumerate(backups, 1):
                print(f"  {i}. {b['filename']} ({b['size'] / (1024*1024):.1f} MB) on {b['device_label']}")
            sel = input(f"Select backup [1-{len(backups)}] or enter path: ").strip()
