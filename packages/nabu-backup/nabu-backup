        def _on_start_backup_clicked(self, btn):
            dest_dir = None
            is_cloud = (self.dest_mode == "cloud")

            if self.dest_mode == "drive":
                if not self.selected_drive:
                    self._show_alert("Error", "Please select a destination drive.")
                    return
                mnt = self.selected_drive.get('mountpoint')
                if not mnt:
                    mnt = StorageScanner.mount_device(self.selected_drive['device'])
                if not mnt:
                    self._show_alert("Mount Error", "Could not mount selected drive. Please select another partition or custom folder.")
                    return
                dest_dir = os.path.join(mnt, BACKUP_DIR_NAME)
            elif self.dest_mode == "cloud":
                if not self.selected_cloud_remote:
                    self._show_alert("Cloud Error", "Please configure and select a cloud remote (Google Drive / MEGA).")
                    return
            else:
                if not self.custom_folder_path:
                    self._show_alert("Custom Folder Error", "Please browse and select a destination folder.")
                    return
                dest_dir = self.custom_folder_path

            options = {
                'include_home': self.sw_config.get_active(),
                'include_docs': self.sw_home.get_active(),
                'include_packages': self.sw_pkgs.get_active(),
                'include_system': self.sw_sys.get_active(),
                'include_boot': self.sw_boot.get_active(),
                'include_waydroid': self.sw_waydroid.get_active(),
                'target_user': get_current_user(),
                'is_cloud': is_cloud,
                'cloud_remote': self.selected_cloud_remote
            }

            self.btn_start_backup.set_sensitive(False)
            self.backup_progress.set_visible(True)
            self.backup_progress.set_fraction(0.05)
            self.backup_log_label.set_visible(True)
            self.backup_log_label.set_text("Starting backup process...")

            def worker():
                def prog_cb(f):
                    GLib.idle_add(lambda: self.backup_progress.set_fraction(f))
                def log_cb(msg):
                    GLib.idle_add(lambda: self.backup_log_label.set_text(msg))

                try:
                    success, path = BackupEngine.execute_backup(dest_dir, options, prog_cb, log_cb)
                    GLib.idle_add(lambda: self._on_backup_finished(success, path))
                except Exception as e:
                    GLib.idle_add(lambda: self._on_backup_finished(False, str(e)))

            threading.Thread(target=worker, daemon=True).start()

        def _on_backup_finished(self, success, result_str):
            self.btn_start_backup.set_sensitive(True)
            self.backup_progress.set_fraction(1.0 if success else 0.0)
            if success:
                self.backup_log_label.set_text(f"Backup Completed Successfully!\n{result_str}")
                self._show_alert("Backup Complete", f"Backup archive created and saved:\n{result_str}")
                self._async_refresh_local_backups()
            else:
                self.backup_log_label.set_text(f"Backup Failed: {result_str}")
                self._show_alert("Backup Failed", f"An error occurred:\n{result_str}")

