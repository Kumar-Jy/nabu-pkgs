    print("6. Connect Cloud Account (MEGA / Google Drive)")
    print("7. Exit")
    choice = input("\nEnter choice [1-7]: ").strip()

    if choice == "1":
        drives = StorageScanner.scan_devices()
        if not drives:
            print("No suitable drives detected. Please connect a USB drive or specify folder.")
