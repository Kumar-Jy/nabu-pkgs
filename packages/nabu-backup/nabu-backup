        def _on_restore_source_changed(self, mode):
            self.restore_source_mode = mode
            self.restore_local_group.set_visible(mode == "local")
            self.restore_cloud_group.set_visible(mode == "cloud")
            self.restore_file_group.set_visible(mode == "file")

            if mode == "cloud":
                self._load_cloud_backups()

        def _refresh_restore_list(self):
            while self.restore_rows_box.get_first_child():
                self.restore_rows_box.remove(self.restore_rows_box.get_first_child())

            backups = StorageScanner.find_local_backups()
            if not backups:
                row = Adw.ActionRow(title="No backup archives found on mounted drives", subtitle="Select archive manually or check cloud storage")
                self.restore_rows_box.append(row)
                self.selected_restore_file = None
                return

            self.restore_radio_group = None
            first_b = None

            for b in backups:
                row = Adw.ActionRow()
                title = f"{b['filename']} ({b['size'] / (1024*1024):.1f} MB)"
                row.set_title(title)
                mtime_str = datetime.fromtimestamp(b['mtime']).strftime("%Y-%m-%d %H:%M")
                row.set_subtitle(f"Location: {b['device_label']} | Date: {mtime_str}")

                radio = Gtk.CheckButton()
                if self.restore_radio_group:
                    radio.set_group(self.restore_radio_group)
                else:
                    self.restore_radio_group = radio
                    radio.set_active(True)
                    first_b = b['path']

                def make_toggle(path):
                    return lambda btn: self._on_restore_file_selected(path) if btn.get_active() else None

                radio.connect("toggled", make_toggle(b['path']))
                row.add_prefix(radio)
                self.restore_rows_box.append(row)

            if first_b:
                self._on_restore_file_selected(first_b)

        def _on_restore_file_selected(self, path):
            self.selected_restore_file = path
            meta = RestoreEngine.inspect_archive(path)
            self.lbl_inspect_date.set_subtitle(meta.get('created_at', 'Unknown'))
            self.lbl_inspect_host.set_subtitle(f"{meta.get('hostname', 'unknown')} | Kernel: {meta.get('kernel', 'unknown')}")
            self.lbl_inspect_pkgs.set_subtitle(f"Native: {meta.get('native_pkg_count', 0)}, Foreign/AUR: {meta.get('foreign_pkg_count', 0)}")
            comps = ", ".join(meta.get('components', [])) or "None listed"
            self.lbl_inspect_comps.set_subtitle(comps)

        def _on_browse_restore_file(self, btn):
            dialog = Gtk.FileDialog(title="Select Nabu Backup Archive (*.tar.zst, *.tar.gz)")
            dialog.open(self, None, self._on_file_dialog_finish)

        def _on_file_dialog_finish(self, dialog, result):
            try:
                gfile = dialog.open_finish(result)
                if gfile:
                    path = gfile.get_path()
                    self.restore_file_row.set_subtitle(path)
                    self._on_restore_file_selected(path)
            except Exception:
                pass

        def _load_cloud_backups(self):
            remotes = CloudManager.list_remotes()
            rm_model = Gtk.StringList()
            if not remotes:
                rm_model.append("No cloud remotes")
            else:
                for r in remotes:
                    rm_model.append(r['name'])
            self.cloud_restore_combo.set_model(rm_model)

            if remotes:
                cur_rem = remotes[0]['name']
                self._populate_remote_backup_list(cur_rem)

        def _populate_remote_backup_list(self, remote_name):
            b_model = Gtk.StringList()
            self.current_cloud_backups = CloudManager.list_cloud_backups(remote_name)
            if not self.current_cloud_backups:
                b_model.append("No backups found on this cloud remote")
            else:
                for b in self.current_cloud_backups:
                    b_model.append(f"{b['filename']} ({b['size'] / (1024*1024):.1f} MB)")
            self.cloud_backup_combo.set_model(b_model)

        def _on_start_restore_clicked(self, btn):
            archive_to_restore = self.selected_restore_file
            is_cloud = (self.restore_source_mode == "cloud")

            if is_cloud:
                if not hasattr(self, 'current_cloud_backups') or not self.current_cloud_backups:
                    self._show_alert("Cloud Restore Error", "No cloud backup selected.")
                    return
                idx = self.cloud_backup_combo.get_selected()
                if idx >= len(self.current_cloud_backups):
                    self._show_alert("Cloud Restore Error", "Invalid cloud backup index.")
                    return
                cloud_item = self.current_cloud_backups[idx]
            else:
                if not archive_to_restore or not os.path.exists(archive_to_restore):
                    self._show_alert("Restore Error", "Please select a valid backup archive.")
                    return

            # Confirmation Dialog
            dlg = Adw.AlertDialog(
                heading="Confirm System & Data Restore",
                body="Are you ready to restore selected files, desktop settings, and packages? Any pre-installed packages on this system will be safely preserved without conflict."
            )
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("restore", "Start Restore")
            dlg.set_response_appearance("restore", Adw.ResponseAppearance.SUGGESTED)

            def on_response(d, resp):
                if resp == "restore":
                    self._execute_restore_confirmed(is_cloud, cloud_item if is_cloud else None, archive_to_restore)

            dlg.connect("response", on_response)
            dlg.present(self)

        def _execute_restore_confirmed(self, is_cloud, cloud_item, local_archive_path):
            self.btn_start_restore.set_sensitive(False)
            self.restore_progress.set_visible(True)
            self.restore_progress.set_fraction(0.05)
            self.restore_log_label.set_visible(True)
            self.restore_log_label.set_text("Initiating restore process...")

            options = {
                'restore_home': self.sw_rest_home.get_active(),
                'restore_packages': self.sw_rest_pkgs.get_active(),
                'restore_system': self.sw_rest_sys.get_active(),
                'restore_boot': self.sw_rest_boot.get_active(),
                'target_user': get_current_user()
            }

            def worker():
                def prog_cb(f):
                    GLib.idle_add(lambda: self.restore_progress.set_fraction(f))
                def log_cb(msg):
                    GLib.idle_add(lambda: self.restore_log_label.set_text(msg))

                target_path = local_archive_path
                try:
                    if is_cloud:
                        log_cb(f"Downloading {cloud_item['filename']} from cloud remote...")
                        dl_dir = "/tmp/nabu-cloud-restore-cache"
                        ok = CloudManager.download_archive(cloud_item['remote_path'], dl_dir, prog_cb, log_cb)
                        if not ok:
                            raise RuntimeError("Cloud download failed.")
                        target_path = os.path.join(dl_dir, cloud_item['filename'])

                    RestoreEngine.execute_restore(target_path, options, prog_cb, log_cb)
                    GLib.idle_add(lambda: self._on_restore_finished(True, "All selected items restored."))
                except Exception as e:
                    GLib.idle_add(lambda: self._on_restore_finished(False, str(e)))

            threading.Thread(target=worker, daemon=True).start()

        def _on_restore_finished(self, success, msg):
            self.btn_start_restore.set_sensitive(True)
            self.restore_progress.set_fraction(1.0 if success else 0.0)
            if success:
                self.restore_log_label.set_text("Restore Completed Successfully!")
                self._show_alert("Restore Complete", "System and user data restore completed successfully.\nPlease log out or restart your session for all desktop settings to refresh.")
            else:
                self.restore_log_label.set_text(f"Restore Failed: {msg}")
                self._show_alert("Restore Failed", f"Error during restore:\n{msg}")

