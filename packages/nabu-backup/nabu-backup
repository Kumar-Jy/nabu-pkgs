        def _on_dest_mode_changed(self, mode):
            self.dest_mode = mode
            self.drive_group.set_visible(mode == "drive")
            self.cloud_dest_group.set_visible(mode == "cloud")
            self.custom_dest_group.set_visible(mode == "custom")
            if mode == "drive":
                self._check_storage_warning()

        def _check_storage_warning(self):
            if not self.selected_drive:
                self.storage_banner.set_title("No drive selected. Please choose an internal partition or connect a USB drive.")
                self.storage_banner.set_revealed(True)
            elif self.selected_drive.get('free_bytes') is not None and self.selected_drive['free_bytes'] < 3 * 1024**3:
                free_gb = self.selected_drive['free_bytes'] / (1024**3)
                self.storage_banner.set_title(f"Warning: Selected drive has only {free_gb:.1f} GB free space. Backup may require more.")
                self.storage_banner.set_revealed(True)
            else:
                self.storage_banner.set_revealed(False)

        def _refresh_drives(self):
            # Clear old rows
            while self.drive_rows_box.get_first_child():
                self.drive_rows_box.remove(self.drive_rows_box.get_first_child())

            drives = StorageScanner.scan_devices()
            if not drives:
                row = Adw.ActionRow(title="No suitable storage drives detected", subtitle="Connect a USB-C flash drive or OTG drive")
                self.drive_rows_box.append(row)
                self.selected_drive = None
                self._check_storage_warning()
                return

            self.drive_radio_group = None
            first_valid = None

            for d in drives:
                row = Adw.ActionRow()
                title_prefix = "🔌 [USB-C Drive] " if d['is_usb'] else "💾 [Internal] "
                row.set_title(f"{title_prefix}{d['label']} ({d['kname']})")
                
                free_str = f"{d['free_bytes']/(1024**3):.1f} GB free" if d['free_bytes'] is not None else "Unmounted (auto-mounts on select)"
                total_str = f"{d['size']/(1024**3):.1f} GB"
                row.set_subtitle(f"Filesystem: {d['fstype'].upper()} | Total: {total_str} | Available: {free_str}")

                # Check radio
                radio = Gtk.CheckButton()
                if self.drive_radio_group:
                    radio.set_group(self.drive_radio_group)
                else:
                    self.drive_radio_group = radio
                    radio.set_active(True)
                    first_valid = d

                def make_toggle(drv):
                    return lambda b: self._on_drive_selected(drv) if b.get_active() else None

                radio.connect("toggled", make_toggle(d))
                row.add_prefix(radio)
                self.drive_rows_box.append(row)

            self.selected_drive = first_valid
            self._check_storage_warning()

        def _on_drive_selected(self, drive_dict):
            # If unmounted, mount it now
            if not drive_dict.get('mountpoint'):
                mnt = StorageScanner.mount_device(drive_dict['device'])
                if mnt:
                    drive_dict['mountpoint'] = mnt
                    try:
                        st = os.statvfs(mnt)
                        drive_dict['free_bytes'] = st.f_bavail * st.f_frsize
                    except Exception:
                        pass
            self.selected_drive = drive_dict
            self._check_storage_warning()

        def _refresh_cloud_remotes(self):
            remotes = CloudManager.list_remotes()
            model = Gtk.StringList()
            if not remotes:
                model.append("No cloud accounts configured (Add in Cloud tab)")
                self.selected_cloud_remote = None
            else:
                for r in remotes:
                    model.append(f"{r['name']} ({r['type']})")
                self.selected_cloud_remote = remotes[0]['name']

            self.cloud_combo_row.set_model(model)
            self.cloud_combo_row.connect("notify::selected", self._on_cloud_remote_selected)

        def _on_cloud_remote_selected(self, row, param):
            remotes = CloudManager.list_remotes()
            idx = row.get_selected()
            if remotes and idx < len(remotes):
                self.selected_cloud_remote = remotes[idx]['name']

        def _on_browse_custom_folder(self, btn):
            dialog = Gtk.FileDialog(title="Choose Backup Destination Folder")
            dialog.select_folder(self, None, self._on_folder_dialog_finish)

        def _on_folder_dialog_finish(self, dialog, result):
            try:
                gfile = dialog.select_folder_finish(result)
                if gfile:
                    self.custom_folder_path = gfile.get_path()
                    self.custom_entry_row.set_subtitle(self.custom_folder_path)
            except Exception:
                pass

        def _on_start_backup_clicked(self, btn):
            dest_dir = None
            is_cloud = (self.dest_mode == "cloud")

            if self.dest_mode == "drive":
                if not self.selected_drive:
                    self._show_alert("Error", "Please select a destination drive.")
                    return
                mnt = self.selected_drive.get('mountpoint')
                if not mnt:
                    mnt = StorageScanner.mount_device(self.selected_drive['device'])
                if not mnt:
                    self._show_alert("Mount Error", "Could not mount selected drive. Please select another partition or custom folder.")
                    return
                dest_dir = os.path.join(mnt, BACKUP_DIR_NAME)
            elif self.dest_mode == "cloud":
                if not self.selected_cloud_remote:
                    self._show_alert("Cloud Error", "Please configure and select a cloud remote (Google Drive / MEGA).")
                    return
            else:
                if not self.custom_folder_path:
                    self._show_alert("Custom Folder Error", "Please browse and select a destination folder.")
                    return
                dest_dir = self.custom_folder_path

            options = {
                'include_home': self.sw_config.get_active(),
                'include_docs': self.sw_home.get_active(),
                'include_packages': self.sw_pkgs.get_active(),
                'include_system': self.sw_sys.get_active(),
                'include_boot': self.sw_boot.get_active(),
                'include_waydroid': self.sw_waydroid.get_active(),
                'target_user': get_current_user(),
                'is_cloud': is_cloud,
                'cloud_remote': self.selected_cloud_remote
            }

            self.btn_start_backup.set_sensitive(False)
            self.backup_progress.set_visible(True)
            self.backup_progress.set_fraction(0.05)
            self.backup_log_label.set_visible(True)
            self.backup_log_label.set_text("Starting backup process...")

            def worker():
                def prog_cb(f):
                    GLib.idle_add(lambda: self.backup_progress.set_fraction(f))
                def log_cb(msg):
                    GLib.idle_add(lambda: self.backup_log_label.set_text(msg))

                try:
                    success, path = BackupEngine.execute_backup(dest_dir, options, prog_cb, log_cb)
                    GLib.idle_add(lambda: self._on_backup_finished(success, path))
                except Exception as e:
                    GLib.idle_add(lambda: self._on_backup_finished(False, str(e)))

            threading.Thread(target=worker, daemon=True).start()

        def _on_backup_finished(self, success, result_str):
            self.btn_start_backup.set_sensitive(True)
            self.backup_progress.set_fraction(1.0 if success else 0.0)
            if success:
                self.backup_log_label.set_text(f"Backup Completed Successfully!\n{result_str}")
                self._show_alert("Backup Complete", f"Backup archive created and saved:\n{result_str}")
                self._refresh_restore_list()
            else:
                self.backup_log_label.set_text(f"Backup Failed: {result_str}")
                self._show_alert("Backup Failed", f"An error occurred:\n{result_str}")

