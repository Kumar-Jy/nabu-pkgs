def get_current_user():
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        return sudo_user
    pkexec_uid = os.environ.get("PKEXEC_UID")
    if pkexec_uid:
        try:
            import pwd
            return pwd.getpwuid(int(pkexec_uid)).pw_name
        except Exception:
            pass
    return os.environ.get("USER", "user")

def get_user_home(username=None):
    if not username:
        username = get_current_user()
    try:
        import pwd
        return pwd.getpwnam(username).pw_dir
    except Exception:
        return f"/home/{username}"

class StorageScanner:
    VALID_FS = {'ntfs', 'ntfs3', 'vfat', 'fat32', 'fat', 'exfat', 'ext4', 'btrfs', 'f2fs', 'xfs'}
    EXCLUDE_MOUNTS = {'/', '/boot', '/boot/efi', '/mnt/vendor/persist'}

    @classmethod
    def scan_devices(cls):
        candidates = []
        try:
            res = subprocess.run(
                ['lsblk', '-J', '-b', '-o', 'NAME,KNAME,FSTYPE,SIZE,MOUNTPOINT,LABEL,HOTPLUG,TRAN,MODEL,RM,RO,UUID,TYPE'],
                capture_output=True, text=True, check=True
            )
            data = json.loads(res.stdout)
        except Exception as e:
            return candidates

        def inspect_node(node, is_usb=False, model=''):
            tran = node.get('tran')
            rm = bool(node.get('rm'))
            hotplug = bool(node.get('hotplug'))
            cur_model = node.get('model') or model
            if tran == 'usb' or hotplug or rm:
                is_usb = True

            fstype = (node.get('fstype') or '').lower()
            mountpoint = node.get('mountpoint')
            size = node.get('size') or 0
            kname = node.get('kname')
            label = node.get('label') or kname
            ro = bool(node.get('ro'))

            # Filter suitable data filesystems >= 1 GB, non-root, non-ro
            if fstype in cls.VALID_FS and not ro and size >= 1024 * 1024 * 1024:
                if mountpoint not in cls.EXCLUDE_MOUNTS:
                    free_bytes = None
                    if mountpoint and os.path.exists(mountpoint):
                        try:
                            st = os.statvfs(mountpoint)
                            free_bytes = st.f_bavail * st.f_frsize
                        except Exception:
                            pass
                    candidates.append({
                        'device': f'/dev/{kname}',
                        'kname': kname,
                        'fstype': fstype,
                        'label': label,
                        'size': size,
                        'mountpoint': mountpoint,
                        'free_bytes': free_bytes,
                        'is_usb': is_usb,
                        'model': cur_model
                    })

            for child in node.get('children', []):
                inspect_node(child, is_usb=is_usb, model=cur_model)

        for dev in data.get('blockdevices', []):
            is_parent_usb = (dev.get('tran') == 'usb' or dev.get('rm') or dev.get('hotplug'))
            inspect_node(dev, is_usb=is_parent_usb, model=dev.get('model') or '')

        # Sort USB / external devices first, then by size descending
        candidates.sort(key=lambda x: (not x['is_usb'], -x['size']))
        return candidates

    @classmethod
    def mount_device(cls, device_path):
        """Mount unmounted device using udisksctl (no root password needed)"""
        try:
            res = subprocess.run(['udisksctl', 'mount', '-b', device_path], capture_output=True, text=True)
            if res.returncode == 0:
                # Output format: "Mounted /dev/sda33 at /run/media/root/Data."
                parts = res.stdout.strip().split(' at ')
                if len(parts) >= 2:
                    return parts[1].rstrip('.')
        except Exception:
            pass
        return None

    @classmethod
    def find_local_backups(cls):
        """Scans candidate drives for existing nabu-backup archives"""
        found = []
        drives = cls.scan_devices()
        for d in drives:
            mnt = d['mountpoint']
            if not mnt or not os.path.exists(mnt):
                continue
            search_dirs = [mnt, os.path.join(mnt, BACKUP_DIR_NAME), os.path.join(mnt, "Backups")]
            for sdir in search_dirs:
                if not os.path.exists(sdir):
                    continue
                try:
                    for entry in os.scandir(sdir):
                        if entry.is_file() and entry.name.startswith("nabu-backup-") and (
                            entry.name.endswith(".tar.zst") or entry.name.endswith(".tar.gz")
                        ):
                            st = entry.stat()
                            found.append({
                                'path': entry.path,
                                'filename': entry.name,
                                'size': st.st_size,
                                'mtime': st.st_mtime,
                                'device_label': d['label'],
                                'is_usb': d['is_usb']
                            })
                except Exception:
                    pass
        found.sort(key=lambda x: -x['mtime'])
        return found

class CloudManager:
    @classmethod
    def is_available(cls):
        return shutil.which('rclone') is not None

    @classmethod
    def list_remotes(cls):
        """Returns list of dicts: [{'name': 'gdrive', 'type': 'drive'}, ...]"""
        if not cls.is_available():
            return []
        try:
            res = subprocess.run(['rclone', 'listremotes', '--long'], capture_output=True, text=True)
            remotes = []
            for line in res.stdout.splitlines():
                parts = line.strip().split(':')
                if parts:
                    name = parts[0].strip()
                    rtype = parts[1].strip() if len(parts) > 1 else 'cloud'
                    if name:
                        remotes.append({'name': name, 'type': rtype, 'remote': f"{name}:"})
            return remotes
        except Exception:
            return []

    @classmethod
    def get_remote_space(cls, remote_name):
        """Gets space info for remote via rclone about"""
        try:
            res = subprocess.run(['rclone', 'about', f"{remote_name}:", '--json'], capture_output=True, text=True, timeout=8)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                return {
                    'total': data.get('total'),
                    'used': data.get('used'),
                    'free': data.get('free')
                }
        except Exception:
            pass
        return None

    @classmethod
    def list_cloud_backups(cls, remote_name):
        """Lists nabu-backup archives on cloud remote under NabuBackups/"""
        if not cls.is_available():
            return []
        try:
            target = f"{remote_name}:{BACKUP_DIR_NAME}"
            res = subprocess.run(['rclone', 'lsjson', target], capture_output=True, text=True, timeout=15)
            if res.returncode != 0:
                # Try root of remote
                target = f"{remote_name}:"
                res = subprocess.run(['rclone', 'lsjson', target], capture_output=True, text=True, timeout=15)

            if res.returncode == 0:
                items = json.loads(res.stdout)
                backups = []
                for item in items:
                    name = item.get('Name', '')
                    if name.startswith("nabu-backup-") and (name.endswith(".tar.zst") or name.endswith(".tar.gz")):
                        backups.append({
                            'filename': name,
                            'remote': remote_name,
                            'remote_path': f"{target}/{name}".replace('//', '/'),
                            'size': item.get('Size', 0),
                            'modtime': item.get('ModTime', '')
                        })
                return backups
        except Exception:
            pass
        return []

    @classmethod
    def create_mega_remote(cls, name, email, password):
        """Creates MEGA remote using rclone obscure and config create"""
        try:
            obs = subprocess.check_output(['rclone', 'obscure', password], text=True).strip()
            cmd = ['rclone', 'config', 'create', name, 'mega', 'user', email, 'pass', obs]
            res = subprocess.run(cmd, capture_output=True, text=True)
            return res.returncode == 0, res.stderr or res.stdout
        except Exception as e:
            return False, str(e)

    @classmethod
    def upload_archive(cls, local_path, remote_name, progress_cb=None, log_cb=None):
        """Uploads local backup archive to remote:NabuBackups/"""
        target = f"{remote_name}:{BACKUP_DIR_NAME}/"
        if log_cb:
            log_cb(f"Uploading {os.path.basename(local_path)} to {target}...")
        cmd = ['rclone', 'copy', local_path, target, '--progress', '--stats', '1s']
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            line_str = line.strip()
            if log_cb and ("Transferred:" in line_str or "ETA" in line_str):
                log_cb(line_str)
            if progress_cb and "Transferred:" in line_str and "%" in line_str:
                try:
                    pct_str = line_str.split('%')[0].split()[-1]
                    progress_cb(float(pct_str) / 100.0)
                except Exception:
                    pass
        proc.wait()
        return proc.returncode == 0

    @classmethod
    def download_archive(cls, remote_path, local_dest_dir, progress_cb=None, log_cb=None):
        """Downloads backup archive from remote to local directory"""
        os.makedirs(local_dest_dir, exist_ok=True)
        if log_cb:
            log_cb(f"Downloading {remote_path} to {local_dest_dir}...")
        cmd = ['rclone', 'copy', remote_path, local_dest_dir, '--progress', '--stats', '1s']
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            line_str = line.strip()
            if log_cb and ("Transferred:" in line_str or "ETA" in line_str):
                log_cb(line_str)
            if progress_cb and "Transferred:" in line_str and "%" in line_str:
                try:
                    pct_str = line_str.split('%')[0].split()[-1]
                    progress_cb(float(pct_str) / 100.0)
                except Exception:
                    pass
        proc.wait()
        return proc.returncode == 0

class BackupEngine:
    @classmethod
    def execute_backup(cls, dest_dir, options, progress_cb=None, log_cb=None):
        """
        options: {
            'include_home': bool,
            'include_docs': bool,
            'include_packages': bool,
            'include_system': bool,
            'include_boot': bool,
            'include_waydroid': bool,
            'target_user': str,
            'is_cloud': bool,
            'cloud_remote': str
        }
        """
        username = options.get('target_user') or get_current_user()
        user_home = get_user_home(username)
        timestamp = datetime.now().strftime("%Y-%m-%d-%H%M")
        archive_name = f"nabu-backup-{timestamp}.tar.zst"
        staging_dir = f"/tmp/nabu-backup-staging-{int(time.time())}"
        os.makedirs(staging_dir, exist_ok=True)
        meta_dir = os.path.join(staging_dir, "meta")
        os.makedirs(meta_dir, exist_ok=True)

        if log_cb:
            log_cb(f"=== Initiating Nabu Backup ({timestamp}) ===")
            log_cb(f"User: {username} ({user_home})")

        components = []

        # 1. Package Lists
        if options.get('include_packages', True):
            if log_cb:
                log_cb("Exporting installed pacman package lists...")
            if progress_cb:
                progress_cb(0.10)
            try:
                native_pkgs = subprocess.check_output(['pacman', '-Qqe'], text=True).splitlines()
                with open(os.path.join(meta_dir, "pkglist-native.txt"), "w") as f:
                    f.write("\n".join(native_pkgs) + "\n")
                
                try:
                    foreign_pkgs = subprocess.check_output(['pacman', '-Qqm'], text=True).splitlines()
                except Exception:
                    foreign_pkgs = []
                with open(os.path.join(meta_dir, "pkglist-foreign.txt"), "w") as f:
                    f.write("\n".join(foreign_pkgs) + "\n")

                all_pkgs = subprocess.check_output(['pacman', '-Qe'], text=True).splitlines()
                with open(os.path.join(meta_dir, "pkglist-all.txt"), "w") as f:
                    f.write("\n".join(all_pkgs) + "\n")

                components.append("packages")
            except Exception as e:
                if log_cb:
                    log_cb(f"Warning exporting packages: {e}")

        # 2. System Settings (WiFi, Bluetooth, Boot cmdlines)
        if options.get('include_system') or options.get('include_boot'):
            if log_cb:
                log_cb("Staging system configurations (WiFi, Bluetooth, Tablet boot)...")
            if progress_cb:
                progress_cb(0.20)
            sys_staging = os.path.join(staging_dir, "system")
            os.makedirs(sys_staging, exist_ok=True)
            
            # Use root helper if not running as root
            if os.geteuid() != 0:
                cmd = ['pkexec', sys.executable, sys.argv[0], '--helper-stage-system', sys_staging]
                try:
                    res = subprocess.run(cmd, capture_output=True, text=True)
                    if res.returncode == 0:
                        components.append("system")
                    else:
                        if log_cb:
                            log_cb(f"Note: Polkit authentication skipped or cancelled: {res.stderr}")
                except Exception as e:
                    if log_cb:
                        log_cb(f"Warning staging system settings: {e}")
            else:
                cls._stage_system_files(sys_staging)
                components.append("system")

        # 3. User Home Directory Staging
        home_staging = os.path.join(staging_dir, "home", username)
        if options.get('include_home', True) or options.get('include_docs', True):
            if log_cb:
                log_cb("Scanning user files & desktop configurations...")
            if progress_cb:
                progress_cb(0.35)
            os.makedirs(home_staging, exist_ok=True)

            excludes = [
                os.path.join(user_home, ".cache"),
                os.path.join(user_home, ".local/share/Trash"),
                os.path.join(user_home, ".local/state"),
                os.path.join(user_home, ".gemini"),
            ]
            if not options.get('include_waydroid', False):
                excludes.append(os.path.join(user_home, ".local/share/waydroid"))

            # Dotfiles and Configs
            if options.get('include_home', True):
                for item in ['.config', '.local', '.bashrc', '.bash_profile', '.zshrc', '.gitconfig', '.icons', '.themes', '.profile']:
                    src = os.path.join(user_home, item)
                    if os.path.exists(src):
                        dst = os.path.join(home_staging, item)
                        cls._copy_tree_filtered(src, dst, excludes)
                components.append("home_config")

            # Personal Documents & Media
            if options.get('include_docs', True):
                for folder in ['Documents', 'Pictures', 'Videos', 'Music', 'Desktop', 'Projects', 'Public', 'Templates']:
                    src = os.path.join(user_home, folder)
                    if os.path.exists(src):
                        dst = os.path.join(home_staging, folder)
                        cls._copy_tree_filtered(src, dst, excludes)
                components.append("user_documents")

        # 4. Generate Metadata
        metadata = {
            "app": APP_NAME,
            "version": APP_VERSION,
            "created_at": datetime.now().isoformat(),
            "timestamp": timestamp,
            "hostname": os.uname().nodename,
            "kernel": os.uname().release,
            "arch": os.uname().machine,
            "target_user": username,
            "components": components,
            "native_pkg_count": len(native_pkgs) if 'packages' in components else 0,
            "foreign_pkg_count": len(foreign_pkgs) if 'packages' in components else 0
        }
        with open(os.path.join(meta_dir, "nabu-backup.json"), "w") as f:
            json.dump(metadata, f, indent=2)

        # 5. Archive Creation (tar + zstd)
        if log_cb:
            log_cb(f"Compressing backup archive ({archive_name})...")
        if progress_cb:
            progress_cb(0.65)

        # Determine output location
        is_cloud = options.get('is_cloud', False)
        if is_cloud:
            final_archive_path = os.path.join("/tmp", archive_name)
        else:
            os.makedirs(dest_dir, exist_ok=True)
            final_archive_path = os.path.join(dest_dir, archive_name)

        # Multi-threaded zstd compression
        tar_cmd = ['tar', '-I', 'zstd -3 -T0', '-cf', final_archive_path, '-C', staging_dir, '.']
        try:
            res = subprocess.run(tar_cmd, capture_output=True, text=True, check=True)
        except Exception as e:
            # Fallback to gzip if zstd fails
            if log_cb:
                log_cb("Notice: Falling back to gzip compression...")
            final_archive_path = final_archive_path.replace(".tar.zst", ".tar.gz")
            tar_cmd = ['tar', '-czf', final_archive_path, '-C', staging_dir, '.']
            subprocess.run(tar_cmd, check=True)

        archive_size = os.path.getsize(final_archive_path)
        size_mb = archive_size / (1024 * 1024)
        if log_cb:
            log_cb(f"Local archive created: {final_archive_path} ({size_mb:.1f} MB)")

        # Cleanup staging
        shutil.rmtree(staging_dir, ignore_errors=True)

        # 6. Cloud Upload (if cloud destination)
        if is_cloud:
            remote = options.get('cloud_remote')
            if log_cb:
                log_cb(f"Uploading to cloud storage ({remote})...")
            if progress_cb:
                progress_cb(0.80)
            success = CloudManager.upload_archive(
                final_archive_path, remote,
                progress_cb=lambda p: progress_cb(0.80 + (p * 0.18)) if progress_cb else None,
                log_cb=log_cb
            )
            os.remove(final_archive_path)
            if not success:
                raise RuntimeError(f"Cloud upload to {remote} failed.")
            if progress_cb:
                progress_cb(1.0)
            if log_cb:
                log_cb(f"=== Cloud Backup Complete: {archive_name} uploaded to {remote}:{BACKUP_DIR_NAME}/ ===")
            return True, f"{remote}:{BACKUP_DIR_NAME}/{archive_name}"

        if progress_cb:
            progress_cb(1.0)
        if log_cb:
            log_cb(f"=== Backup Successful! Saved to {final_archive_path} ===")
        return True, final_archive_path

    @classmethod
    def _stage_system_files(cls, dest_sys_dir):
        """Internal helper to copy root system files into staging dir"""
        # 1. WiFi connections
        nm_src = "/etc/NetworkManager/system-connections"
        if os.path.exists(nm_src):
            nm_dst = os.path.join(dest_sys_dir, "network")
            os.makedirs(nm_dst, exist_ok=True)
            for f in os.listdir(nm_src):
                s = os.path.join(nm_src, f)
                if os.path.isfile(s):
                    shutil.copy2(s, os.path.join(nm_dst, f))

        # 2. Bluetooth
        bt_src = "/var/lib/bluetooth"
        if os.path.exists(bt_src):
            bt_dst = os.path.join(dest_sys_dir, "bluetooth")
            if os.path.exists(bt_dst):
                shutil.rmtree(bt_dst)
            shutil.copytree(bt_src, bt_dst, symlinks=True)

        # 3. Tablet Boot Parameters
        cmd_src = "/etc/cmdline.d"
        if os.path.exists(cmd_src):
            cmd_dst = os.path.join(dest_sys_dir, "cmdline.d")
            os.makedirs(cmd_dst, exist_ok=True)
            for f in os.listdir(cmd_src):
                s = os.path.join(cmd_src, f)
                if os.path.isfile(s):
                    shutil.copy2(s, os.path.join(cmd_dst, f))

        # Ensure staging files are readable by regular user
        for root, dirs, files in os.walk(dest_sys_dir):
            for d in dirs:
                os.chmod(os.path.join(root, d), 0o755)
            for f in files:
                os.chmod(os.path.join(root, f), 0o644)

    @classmethod
    def _copy_tree_filtered(cls, src, dst, excludes):
        for excl in excludes:
            if src == excl or src.startswith(excl + '/'):
                return
        if os.path.islink(src):
            linkto = os.readlink(src)
            try:
                os.symlink(linkto, dst)
            except FileExistsError:
                pass
            return
        if os.path.isdir(src):
            os.makedirs(dst, exist_ok=True)
            try:
                for entry in os.scandir(src):
                    cls._copy_tree_filtered(entry.path, os.path.join(dst, entry.name), excludes)
            except PermissionError:
                pass
        else:
            try:
                shutil.copy2(src, dst)
            except Exception:
                pass

class RestoreEngine:
    @classmethod
    def inspect_archive(cls, archive_path):
        """Inspects archive and extracts metadata without unpacking entire archive"""
        meta = {}
        try:
            with tarfile.open(archive_path, 'r:*') as tar:
                for member in tar.getmembers():
                    if member.name.endswith("nabu-backup.json"):
                        f = tar.extractfile(member)
                        if f:
                            meta = json.load(f)
                            break
        except Exception as e:
            meta = {"error": str(e)}

        meta['file_size'] = os.path.getsize(archive_path) if os.path.exists(archive_path) else 0
        meta['archive_path'] = archive_path
        return meta

    @classmethod
    def execute_restore(cls, archive_path, options, progress_cb=None, log_cb=None):
        """
        options: {
            'restore_home': bool,
            'restore_packages': bool,
            'restore_system': bool,
            'restore_boot': bool,
            'target_user': str
        }
        """
        username = options.get('target_user') or get_current_user()
        user_home = get_user_home(username)
        staging_dir = f"/tmp/nabu-restore-staging-{int(time.time())}"
        os.makedirs(staging_dir, exist_ok=True)

        if log_cb:
            log_cb(f"=== Starting Restore from {os.path.basename(archive_path)} ===")
            log_cb(f"Destination User: {username} ({user_home})")

        # 1. Extract Archive to Staging
        if log_cb:
            log_cb("Extracting backup archive...")
        if progress_cb:
            progress_cb(0.15)
        
        try:
            with tarfile.open(archive_path, 'r:*') as tar:
                tar.extractall(staging_dir)
        except Exception as e:
            shutil.rmtree(staging_dir, ignore_errors=True)
            raise RuntimeError(f"Extraction failed: {e}")

        # Read metadata
        meta_file = os.path.join(staging_dir, "meta", "nabu-backup.json")
        meta = {}
        if os.path.exists(meta_file):
            try:
                with open(meta_file, "r") as f:
                    meta = json.load(f)
            except Exception:
                pass

        # 2. Package Restoration (pacman -S --needed)
        if options.get('restore_packages', True):
            pkglist_native = os.path.join(staging_dir, "meta", "pkglist-native.txt")
            if os.path.exists(pkglist_native):
                if log_cb:
                    log_cb("Restoring missing system packages via pacman (--needed)...")
                if progress_cb:
                    progress_cb(0.40)
                
                # Using --needed guarantees that pre-installed packages on the fresh install are NOT conflicted or overwritten!
                cmd = ['pacman', '-S', '--needed', '--noconfirm', '-']
                if os.geteuid() != 0:
                    cmd = ['pkexec'] + cmd
                
                try:
                    with open(pkglist_native, "r") as f:
                        proc = subprocess.run(cmd, stdin=f, capture_output=True, text=True)
                    if log_cb:
                        if proc.returncode == 0:
                            log_cb("Packages synchronized successfully without conflicts!")
                        else:
                            log_cb(f"Pacman status note: {proc.stderr or proc.stdout}")
                except Exception as e:
                    if log_cb:
                        log_cb(f"Pacman execution note: {e}")

            # Check for foreign/AUR packages
            pkglist_foreign = os.path.join(staging_dir, "meta", "pkglist-foreign.txt")
            if os.path.exists(pkglist_foreign):
                try:
                    with open(pkglist_foreign, "r") as f:
                        fp_lines = [l.strip() for l in f if l.strip()]
                    if fp_lines:
                        report_path = os.path.join(user_home, "Desktop", "foreign-packages-to-reinstall.txt")
                        os.makedirs(os.path.dirname(report_path), exist_ok=True)
                        with open(report_path, "w") as rf:
                            rf.write("# The following AUR or local packages were installed on your previous system:\n")
                            rf.write("\n".join(fp_lines) + "\n")
                        if log_cb:
                            log_cb(f"Saved foreign/AUR package list for reference: {report_path}")
                except Exception:
                    pass

        # 3. User Home Restoration
        if options.get('restore_home', True):
            if log_cb:
                log_cb("Restoring user files & desktop configurations...")
            if progress_cb:
                progress_cb(0.70)

            # Locate staged home
            staged_home_root = os.path.join(staging_dir, "home")
            if os.path.exists(staged_home_root):
                for src_user in os.listdir(staged_home_root):
                    src_user_path = os.path.join(staged_home_root, src_user)
                    if os.path.isdir(src_user_path):
                        for item in os.listdir(src_user_path):
                            s = os.path.join(src_user_path, item)
                            d = os.path.join(user_home, item)
                            if os.path.isdir(s):
                                shutil.copytree(s, d, dirs_exist_ok=True, symlinks=True)
                            else:
                                shutil.copy2(s, d)

            # Automatic Permission Fix: chown -R target_user:target_user
            if log_cb:
                log_cb(f"Normalizing user file permissions for {username}...")
            try:
                import pwd
                pw = pwd.getpwnam(username)
                uid, gid = pw.pw_uid, pw.pw_gid
                for root, dirs, files in os.walk(user_home):
                    for name in dirs:
                        os.chown(os.path.join(root, name), uid, gid)
                    for name in files:
                        os.chown(os.path.join(root, name), uid, gid)
            except Exception as e:
                if log_cb:
                    log_cb(f"Permission fix note: {e}")

        # 4. System Settings & Boot Restoration
        if options.get('restore_system', True) or options.get('restore_boot', True):
            sys_staged = os.path.join(staging_dir, "system")
            if os.path.exists(sys_staged):
                if log_cb:
                    log_cb("Restoring network credentials, bluetooth pairings, and boot parameters...")
                if progress_cb:
                    progress_cb(0.90)

                if os.geteuid() != 0:
                    cmd = ['pkexec', sys.executable, sys.argv[0], '--helper-restore-system', sys_staged]
                    try:
                        res = subprocess.run(cmd, capture_output=True, text=True)
                        if log_cb:
                            if res.returncode == 0:
                                log_cb("System settings restored successfully!")
                            else:
                                log_cb(f"System restore note: {res.stderr}")
                    except Exception as e:
                        if log_cb:
                            log_cb(f"Warning restoring system files: {e}")
                else:
                    cls._restore_system_files(sys_staged)

        # Cleanup staging
        shutil.rmtree(staging_dir, ignore_errors=True)

        if progress_cb:
            progress_cb(1.0)
        if log_cb:
            log_cb("=== System & User Data Restoration Completed Successfully! ===")
        return True

    @classmethod
    def _restore_system_files(cls, sys_staged):
        """Internal helper to restore root system files"""
        # 1. WiFi connections
        net_staged = os.path.join(sys_staged, "network")
        if os.path.exists(net_staged):
            dest = "/etc/NetworkManager/system-connections"
            os.makedirs(dest, exist_ok=True)
            for f in os.listdir(net_staged):
                src = os.path.join(net_staged, f)
                dst = os.path.join(dest, f)
                shutil.copy2(src, dst)
                os.chmod(dst, 0o600)
            subprocess.run(['nmcli', 'connection', 'reload'], capture_output=True)

        # 2. Bluetooth
        bt_staged = os.path.join(sys_staged, "bluetooth")
        if os.path.exists(bt_staged):
            dest = "/var/lib/bluetooth"
            os.makedirs(dest, exist_ok=True)
            for item in os.listdir(bt_staged):
                s = os.path.join(bt_staged, item)
                d = os.path.join(dest, item)
                if os.path.isdir(s):
                    shutil.copytree(s, d, dirs_exist_ok=True, symlinks=True)
                else:
                    shutil.copy2(s, d)
            os.chmod(dest, 0o700)
            subprocess.run(['systemctl', 'restart', 'bluetooth'], capture_output=True)

        # 3. Boot cmdlines
        cmd_staged = os.path.join(sys_staged, "cmdline.d")
        if os.path.exists(cmd_staged):
            dest = "/etc/cmdline.d"
            os.makedirs(dest, exist_ok=True)
            for f in os.listdir(cmd_staged):
                shutil.copy2(os.path.join(cmd_staged, f), os.path.join(dest, f))

