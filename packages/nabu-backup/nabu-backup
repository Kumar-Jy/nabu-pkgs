        opts = {
            'include_home': True, 'include_docs': True, 'include_packages': True,
            'include_system': True, 'include_boot': True, 'include_waydroid': False,
            'target_user': get_current_user(), 'is_cloud': False
        }
        print(f"\nStarting backup to: {dest} ...")
        BackupEngine.execute_backup(dest, opts, log_cb=print)

    elif choice == "2":
        remotes = CloudManager.list_remotes()
        if not remotes:
            print("No cloud remotes found. Configure one via option 6 or rclone config.")
            return
        print("\nConfigured Cloud Remotes:")
        for i, r in enumerate(remotes, 1):
            print(f"  {i}. {r['name']} ({r['type']})")
