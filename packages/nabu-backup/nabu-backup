        def _execute_restore_confirmed(self, is_cloud, cloud_item, local_archive_path):
            self.btn_start_restore.set_sensitive(False)
            self.restore_progress.set_visible(True)
            self.restore_progress.set_fraction(0.05)
            self.restore_log_label.set_visible(True)
            self.restore_log_label.set_text("Initiating restore process...")

            options = {
                'restore_home': self.sw_rest_home.get_active(),
                'restore_packages': self.sw_rest_pkgs.get_active(),
                'restore_system': self.sw_rest_sys.get_active(),
                'restore_boot': self.sw_rest_boot.get_active(),
                'target_user': get_current_user()
            }

            def worker():
                def prog_cb(f):
                    GLib.idle_add(lambda: self.restore_progress.set_fraction(f))
                def log_cb(msg):
                    GLib.idle_add(lambda: self.restore_log_label.set_text(msg))

                target_path = local_archive_path
                try:
                    if is_cloud:
                        log_cb(f"Downloading {cloud_item['filename']} from cloud...")
                        dl_dir = "/tmp/nabu-cloud-restore-cache"
                        ok = CloudManager.download_archive(cloud_item['remote_path'], dl_dir, prog_cb, log_cb)
                        if not ok:
                            raise RuntimeError("Cloud download failed.")
                        target_path = os.path.join(dl_dir, cloud_item['filename'])

                    RestoreEngine.execute_restore(target_path, options, prog_cb, log_cb)
                    GLib.idle_add(lambda: self._on_restore_finished(True, "All selected items restored."))
                except Exception as e:
                    GLib.idle_add(lambda: self._on_restore_finished(False, str(e)))

            threading.Thread(target=worker, daemon=True).start()

        def _on_restore_finished(self, success, msg):
            self.btn_start_restore.set_sensitive(True)
            self.restore_progress.set_fraction(1.0 if success else 0.0)
            if success:
                self.restore_log_label.set_text("Restore Completed Successfully!")
                self._show_alert("Restore Complete", "System and user data restore completed successfully.\nPlease log out or restart your session for all desktop settings to refresh.")
            else:
                self.restore_log_label.set_text(f"Restore Failed: {msg}")
                self._show_alert("Restore Failed", f"Error during restore:\n{msg}")

