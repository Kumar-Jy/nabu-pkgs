# ==============================================================================
# Main Dispatcher
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description=f"{APP_NAME} - Xiaomi Pad 5 System & Data Migration")
    parser.add_argument("--gui", action="store_true", help="Launch Libadwaita GUI interface")
    parser.add_argument("--cli", action="store_true", help="Launch interactive CLI menu")
    parser.add_argument("--list-drives", action="store_true", help="List detected storage devices")
    parser.add_argument("--list-cloud", action="store_true", help="List configured cloud remotes")

    # Internal Polkit Helper flags
    parser.add_argument("--helper-stage-system", metavar="DIR", help=argparse.SUPPRESS)
    parser.add_argument("--helper-restore-system", metavar="DIR", help=argparse.SUPPRESS)

    # Subcommands
    subparsers = parser.add_subparsers(dest="command")

    backup_parser = subparsers.add_parser("backup", help="Create a new backup archive")
    backup_parser.add_argument("--dest", help="Destination directory or cloud remote name")
    backup_parser.add_argument("--cloud", action="store_true", help="Upload directly to cloud storage")
    backup_parser.add_argument("--no-system", action="store_true", help="Skip system settings (WiFi, BT, boot)")
    backup_parser.add_argument("--include-waydroid", action="store_true", help="Include Waydroid container")

    restore_parser = subparsers.add_parser("restore", help="Restore system from an archive")
    restore_parser.add_argument("archive", help="Path to backup archive (.tar.zst) or cloud remote:archive")
    restore_parser.add_argument("--no-packages", action="store_true", help="Skip pacman package synchronization")
    restore_parser.add_argument("--no-system", action="store_true", help="Skip system network and bluetooth restore")

    args = parser.parse_args()

    # 1. Handle Polkit Helper calls
    if args.helper_stage_system:
        BackupEngine._stage_system_files(args.helper_stage_system)
        sys.exit(0)
    if args.helper_restore_system:
        RestoreEngine._restore_system_files(args.helper_restore_system)
        sys.exit(0)

    # 2. Command-line utility flags
    if args.list_drives:
        drives = StorageScanner.scan_devices()
        for d in drives:
            free = f"{d['free_bytes'] / (1024**3):.1f} GB" if d['free_bytes'] else "Unmounted"
            print(f"{d['label']} ({d['kname']}, {d['fstype']}) - USB: {d['is_usb']} - Free: {free} - Mount: {d['mountpoint']}")
        sys.exit(0)

    if args.list_cloud:
        remotes = CloudManager.list_remotes()
        for r in remotes:
            print(f"{r['name']}: {r['type']}")
        sys.exit(0)

    # 3. Non-interactive subcommands
    if args.command == "backup":
        dest = args.dest
        if not dest:
            drives = StorageScanner.scan_devices()
            if drives and drives[0].get('mountpoint'):
                dest = os.path.join(drives[0]['mountpoint'], BACKUP_DIR_NAME)
            else:
                dest = os.path.expanduser("~/NabuBackups")
        opts = {
            'include_home': True, 'include_docs': True, 'include_packages': True,
            'include_system': not args.no_system, 'include_boot': not args.no_system,
            'include_waydroid': args.include_waydroid, 'target_user': get_current_user(),
            'is_cloud': args.cloud, 'cloud_remote': args.dest if args.cloud else None
        }
        BackupEngine.execute_backup(dest, opts, log_cb=print)
        sys.exit(0)

    if args.command == "restore":
        opts = {
            'restore_home': True, 'restore_packages': not args.no_packages,
            'restore_system': not args.no_system, 'restore_boot': not args.no_system,
            'target_user': get_current_user()
        }
        RestoreEngine.execute_restore(args.archive, opts, log_cb=print)
        sys.exit(0)

    if args.cli:
        run_cli_interactive()
        sys.exit(0)

    # 4. Default: Launch GUI if display is present, else run interactive CLI
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if has_display and not args.cli:
        try:
            launch_gui()
        except Exception as e:
            print(f"Could not initialize GUI ({e}). Launching CLI instead...\n")
            run_cli_interactive()
    else:
        run_cli_interactive()

if __name__ == "__main__":
    main()
