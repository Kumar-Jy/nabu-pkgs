    class NabuBackupApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

        def do_activate(self):
            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(CUSTOM_CSS)
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
            win = NabuBackupWindow(self)
            win.present()

    class NabuBackupWindow(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app)
            self.set_title(APP_NAME)
            self.set_default_size(480, 640)
            self.set_size_request(380, 520)

            # In-memory Caches for Instant UI Response (Zero Lag)
            self.cached_drives = []
            self.cached_remotes = []
            self.cached_cloud_spaces = {} # remote_name -> space string
            self.cached_cloud_backups = {} # remote_name -> list of backup dicts
            self.cached_local_backups = []
            self.last_rclone_mtime = 0

            # State
            self.selected_drive = None
            self.selected_cloud_remote = None
            self.custom_folder_path = None
            self.dest_mode = "drive"
            self.restore_source_mode = "local"
            self.selected_restore_file = None

            self._build_ui()

            # Non-blocking async background initial loads
            self._async_refresh_drives()
            self._async_refresh_cloud_remotes()
            self._async_refresh_local_backups()

            # Window focus listener: lightweight mtime check
            self.connect("notify::is-active", lambda win, p: self._on_window_active() if win.get_is_active() else None)

        def _on_window_active(self):
            """Fast check: only refresh if rclone.conf was actually modified"""
            conf = get_rclone_config_path()
            if os.path.exists(conf):
                try:
                    mt = os.path.getmtime(conf)
                    if mt > self.last_rclone_mtime:
                        self.last_rclone_mtime = mt
                        self._async_refresh_cloud_remotes()
                except Exception:
                    pass

        def _build_ui(self):
            main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.set_content(main_box)

            # HeaderBar
            header = Adw.HeaderBar()
            header_title = Adw.WindowTitle(title="Nabu Backup", subtitle="Xiaomi Pad 5")
            header.set_title_widget(header_title)

            # Spinner for background activity
            self.header_spinner = Gtk.Spinner()
            header.pack_end(self.header_spinner)

            # Refresh Button
            btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh Drives & Cloud Accounts")
            btn_refresh.add_css_class("flat")
            btn_refresh.connect("clicked", lambda b: self._on_manual_refresh())
            header.pack_end(btn_refresh)

            main_box.append(header)

            # View Stack
            self.view_stack = Adw.ViewStack()
            view_switcher_title = Adw.ViewSwitcher(stack=self.view_stack, policy=Adw.ViewSwitcherPolicy.WIDE)
            header.set_title_widget(view_switcher_title)

            # Tab 1: Backup Page
            backup_page = self._build_backup_page()
            self.view_stack.add_titled_with_icon(backup_page, "backup", "Backup", "document-save-symbolic")

            # Tab 2: Restore Page
            restore_page = self._build_restore_page()
            self.view_stack.add_titled_with_icon(restore_page, "restore", "Restore", "edit-undo-symbolic")

            # Tab 3: Cloud Page
            cloud_page = self._build_cloud_page()
            self.view_stack.add_titled_with_icon(cloud_page, "cloud", "Cloud", "folder-remote-symbolic")

            # Tab Switch Listener: ZERO blocking calls here!
            self.view_stack.connect("notify::visible-child-name", self._on_tab_switched)

            main_box.append(self.view_stack)

        def _on_tab_switched(self, stack, param):
            """Instant tab switch - never blocks on subprocesses!"""
            tab = stack.get_visible_child_name()
            if tab == "restore" and self.restore_source_mode == "cloud":
                if self.cached_remotes:
                    idx = self.cloud_restore_combo.get_selected()
                    if idx < len(self.cached_remotes):
                        cur_name = self.cached_remotes[idx]['name']
                        if cur_name not in self.cached_cloud_backups:
                            self._async_load_cloud_backups(cur_name)

        def _on_manual_refresh(self):
            self.header_spinner.start()
            self._async_refresh_drives()
            self._async_refresh_cloud_remotes(force_space=True)
            self._async_refresh_local_backups()

        # ----------------------------------------------------------------------
        # Asynchronous Background Data Loaders
        # ----------------------------------------------------------------------
        def _async_refresh_drives(self):
            def worker():
                drives = StorageScanner.scan_devices()
                GLib.idle_add(lambda: self._apply_drives(drives))
            threading.Thread(target=worker, daemon=True).start()

        def _apply_drives(self, drives):
            self.cached_drives = drives
            while self.drive_rows_box.get_first_child():
                self.drive_rows_box.remove(self.drive_rows_box.get_first_child())

            if not drives:
                row = Adw.ActionRow(title="No suitable drives detected", subtitle="Connect a USB-C flash drive or OTG drive")
                self.drive_rows_box.append(row)
                self.selected_drive = None
                self._check_storage_warning()
                return

            self.drive_radio_group = None
            first_valid = None

            for d in drives:
                row = Adw.ActionRow()
                row.add_css_class("card-compact")
                
                header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                lbl_name = Gtk.Label(label=d['label'], halign=Gtk.Align.START)
                lbl_name.add_css_class("heading")
                header_box.append(lbl_name)

                badge_type = Gtk.Label(label="USB-C" if d['is_usb'] else "Internal")
                badge_type.add_css_class("badge-pill")
                badge_type.add_css_class("badge-usb" if d['is_usb'] else "badge-internal")
                header_box.append(badge_type)

                badge_fs = Gtk.Label(label=d['fstype'].upper())
                badge_fs.add_css_class("badge-pill")
                badge_fs.add_css_class("badge-fs")
                header_box.append(badge_fs)

                level_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                level_box.append(header_box)

                if d['free_bytes'] is not None and d['size'] > 0:
                    used = d.get('used_bytes', d['size'] - d['free_bytes'])
                    ratio = min(1.0, max(0.0, used / d['size']))
                    level_bar = Gtk.LevelBar()
                    level_bar.set_value(ratio)
                    level_bar.add_css_class("level-meter")
                    level_box.append(level_bar)

                    free_str = format_bytes(d['free_bytes'])
                    tot_str = format_bytes(d['size'])
                    sub = Gtk.Label(label=f"{free_str} free of {tot_str} ({int(ratio*100)}% used)", halign=Gtk.Align.START)
                    sub.add_css_class("subtext-compact")
                    level_box.append(sub)
                else:
                    sub = Gtk.Label(label=f"Total: {format_bytes(d['size'])} | Auto-mounts on selection", halign=Gtk.Align.START)
                    sub.add_css_class("subtext-compact")
                    level_box.append(sub)

                row.set_child(level_box)

                radio = Gtk.CheckButton()
                if self.drive_radio_group:
                    radio.set_group(self.drive_radio_group)
                else:
                    self.drive_radio_group = radio
                    radio.set_active(True)
                    first_valid = d

                def make_toggle(drv):
                    return lambda b: self._on_drive_selected(drv) if b.get_active() else None

                radio.connect("toggled", make_toggle(d))
                row.add_prefix(radio)
                self.drive_rows_box.append(row)

            self.selected_drive = first_valid
            self._check_storage_warning()

        def _async_refresh_cloud_remotes(self, force_space=False):
            conf = get_rclone_config_path()
            if os.path.exists(conf):
                try:
                    self.last_rclone_mtime = os.path.getmtime(conf)
                except Exception:
                    pass

            def worker():
                remotes = CloudManager.list_remotes()
                GLib.idle_add(lambda: self._apply_cloud_remotes(remotes, force_space))
            threading.Thread(target=worker, daemon=True).start()

        def _apply_cloud_remotes(self, remotes, fetch_space=False):
            self.cached_remotes = remotes
            self.header_spinner.stop()
            if hasattr(self, 'cloud_auth_banner'):
                self.cloud_auth_banner.set_revealed(False)

            # 1. Update Cloud Accounts Tab UI instantly
            self._render_cloud_accounts_list(remotes)

            # 2. Update Backup Tab Cloud Remote Combo instantly
            model = Gtk.StringList()
            if not remotes:
                model.append("No cloud accounts (Click below to add)")
                self.selected_cloud_remote = None
            else:
                for r in remotes:
                    model.append(f"{r['name']} ({r['type']})")
                if not self.selected_cloud_remote or self.selected_cloud_remote not in [r['name'] for r in remotes]:
                    self.selected_cloud_remote = remotes[0]['name']

            self.cloud_combo_row.set_model(model)
            if self.selected_cloud_remote and remotes:
                names = [r['name'] for r in remotes]
                if self.selected_cloud_remote in names:
                    self.cloud_combo_row.set_selected(names.index(self.selected_cloud_remote))

            # 3. Update Restore Tab Cloud Remote Combo
            rm_model = Gtk.StringList()
            if not remotes:
                rm_model.append("No cloud remotes")
            else:
                for r in remotes:
                    rm_model.append(f"{r['name']} ({r['type']})")
            self.cloud_restore_combo.set_model(rm_model)

            # 4. Async fetch space quota in background without blocking UI
            for r in remotes:
                r_name = r['name']
                if fetch_space or r_name not in self.cached_cloud_spaces:
                    self._async_fetch_remote_space(r_name)

        def _async_fetch_remote_space(self, remote_name):
            def space_worker():
                info = CloudManager.get_remote_space(remote_name)
                if info and info.get('total'):
                    tot = format_bytes(info['total'])
                    free = format_bytes(info['free'])
                    desc = f"Cloud Storage: {free} free of {tot}"
                else:
                    desc = f"Remote: {remote_name}:"
                GLib.idle_add(lambda: self._apply_remote_space(remote_name, desc))
            threading.Thread(target=space_worker, daemon=True).start()

        def _apply_remote_space(self, remote_name, desc):
            self.cached_cloud_spaces[remote_name] = desc
            if hasattr(self, 'cloud_subtitles_map') and remote_name in self.cloud_subtitles_map:
                lbl = self.cloud_subtitles_map[remote_name]
                lbl.set_text(desc)

